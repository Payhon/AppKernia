AK_ENV=development
AK_HTTP_ADDR=:8080
AK_DATABASE_URL=postgres://appkernia:appkernia-dev-only@localhost:55432/appkernia?sslmode=disable
AK_ADMIN_REGISTRATION_ENABLED=false
AK_ADMIN_REGISTRATION_TENANT_CODE=local
AK_PASSWORD_RECOVERY_ENABLED=false
# Development-only adapter. Production must use a separately implemented delivery adapter.
AK_PASSWORD_RECOVERY_ADAPTER=local
AK_AVATAR_UPLOAD_ENABLED=false
AK_FILE_STORAGE_ENABLED=true
AK_MULTI_TENANT_ENABLED=false
AK_API_CLIENTS_ENABLED=true
AK_WEBHOOKS_ENABLED=true
AK_WEBHOOK_ADAPTER=local-mock
AK_MFA_ENABLED=true
AK_OAUTH_ENABLED=true
# Development-only mock provider. Production must use a separately implemented OAuth/OIDC adapter and credentials.
AK_OAUTH_ADAPTER=local-mock
# Development-only adapter. Production must configure an S3-compatible adapter in a build that provides it.
AK_OBJECT_STORAGE_ADAPTER=local
# Development-only 32-byte key. Replace it with an independently generated secret outside local development.
AK_CONFIG_MASTER_KEY_BASE64=YXBwa2VybmlhLWRldi1tYXN0ZXIta2V5LTMyYnl0ZSE=
AK_CONFIG_MASTER_KEY_VERSION=1
AK_LOCAL_OBJECT_STORAGE_DIR=./var/object-storage
AK_SHUTDOWN_TIMEOUT=15s
AK_ADMIN_ORIGIN=http://localhost:4173
AK_ADMIN_PORT=4173
AK_BOOTSTRAP_EMAIL=admin@example.test
AK_BOOTSTRAP_TENANT_CODE=local
AK_BOOTSTRAP_TENANT_NAME="Local Workspace"
AK_BOOTSTRAP_DISPLAY_NAME="Local Admin"
AK_BOOTSTRAP_LOCALE=zh-CN
# Production only: base64-encoded 64-byte Ed25519 private key. Never commit its value.
AK_JWT_KEY_ID=
AK_JWT_PRIVATE_KEY_BASE64=
