{
  "schema_version": 2,
  "name": "AppKernia Admin Static Route Registry",
  "description": "构建期静态路由注册表。后端菜单只能引用 component_key，不能提供任意 import path。",
  "rules": {
    "routing_model": "TanStack Router file-based static routing",
    "backend_menu_controls": [
      "visibility",
      "title",
      "icon",
      "sort",
      "redirect",
      "active_menu_code"
    ],
    "backend_menu_cannot_control": [
      "module import path",
      "arbitrary component code",
      "authorization outcome"
    ],
    "unknown_component_key_behavior": "omit menu item, emit telemetry warning, continue rendering",
    "auth_and_profile_routes_are_static_hidden_routes": true
  },
