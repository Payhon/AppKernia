{
  "schema_version": 1,
  "description": "AK 核心 53 张 PostgreSQL 表的 UI 覆盖分类。不是每张基础设施表都应暴露 CRUD；所有表必须明确归类。",
  "coverage_types": {
    "page_backed": "页面直接读取、管理或聚合展示",
    "indirect_aggregate": "页面仅展示脱敏聚合信息，不暴露原始记录或 Secret",
    "backend_only": "纯服务端基础设施，不提供人工 CRUD 页面"
  },
