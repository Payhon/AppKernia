<template><view class="field"><text class="label">{{label}}</text><textarea class="input" :value="modelValue" :maxlength="maxLength" :disabled="disabled" :placeholder="placeholder" :aria-label="label" :adjust-position="true" @input="onInput"/><text v-if="error.length>0" class="error">{{error}}</text></view></template>
<script lang="uts">export default{props:{modelValue:{type:String,default:''},label:{type:String,default:''},placeholder:{type:String,default:''},error:{type:String,default:''},maxLength:{type:Number,default:2000},disabled:{type:Boolean,default:false}},emits:['update:modelValue'],methods:{onInput(e:UniInputEvent){if(!this.disabled)this.$emit('update:modelValue',e.detail.value)}}}</script>
<style lang="scss">.field{margin-bottom:16px}.label{font-size:15px;font-weight:600;color:var(--ak-text);margin-bottom:8px}.input{height:160px;width:100%;padding:12px;background:var(--ak-surface-subtle);color:var(--ak-text);border:1px solid var(--ak-border);border-radius:12px;font-size:16px;box-sizing:border-box}.error{font-size:13px;color:var(--ak-danger);margin-top:8px}</style>
