<template><view class="ak-field"><text v-if="label" class="ak-field__label">{{ label }}</text><input :class="disabled ? 'ak-field__input ak-field__input--disabled' : 'ak-field__input'" :value="modelValue" :password="password" :placeholder="placeholder" :disabled="disabled" @input="onInput" /><text v-if="error" class="ak-field__error">{{ error }}</text></view></template>
<script lang="uts">
export default { props: { modelValue: { type: String, default: '' }, label: { type: String, default: '' }, placeholder: { type: String, default: '' }, error: { type: String, default: '' }, password: { type: Boolean, default: false }, disabled: { type: Boolean, default: false } }, emits: ['update:modelValue'], methods: { onInput(event: UniInputEvent) { if (!this.disabled) this.$emit('update:modelValue', event.detail.value) } } }
</script>
<style lang="scss">.ak-field { margin-bottom:var(--ak-space-4); }.ak-field__label { margin-bottom:var(--ak-space-2); color:var(--ak-text); font-size:15px; font-weight:600; }.ak-field__input { min-height:48px; border:1px solid var(--ak-border); border-radius:var(--ak-radius-control); padding:0 14px; color:var(--ak-text); background:var(--ak-surface-subtle); box-sizing:border-box; }.ak-field__input--disabled { color:var(--ak-muted); background:var(--ak-surface-subtle); border-color:var(--ak-border); opacity:1; }.ak-field__error { color:var(--ak-danger); font-size:13px; line-height:18px; margin-top:var(--ak-space-1); }</style>
