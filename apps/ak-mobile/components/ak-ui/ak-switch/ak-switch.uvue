<template><view class="ak-switch" :class="modelValue ? 'ak-switch-on' : 'ak-switch-off'" @click="toggle"><view class="ak-switch-knob" :class="modelValue ? 'ak-switch-knob-on' : 'ak-switch-knob-off'" /></view></template>
<script lang="uts">export default { props: { modelValue: { type: Boolean, default: false } }, emits: ['update:modelValue','change'], methods: { toggle(): void { const nextValue: boolean = !this.modelValue; this.$emit('update:modelValue', nextValue); this.$emit('change', nextValue) } } }</script>
<style lang="scss">.ak-switch { width:48px; height:28px; padding:3px; border-radius:999px; }.ak-switch-on { background:var(--ak-brand); }.ak-switch-off { background:var(--ak-border-strong); }.ak-switch-knob { width:22px; height:22px; border-radius:22px; background:var(--ak-surface); }.ak-switch-knob-on { margin-left:20px; }.ak-switch-knob-off { margin-left:0px; }</style>
