<template>
  <view class="ak-empty">
    <ak-icon :name="icon" :size="48" />
    <text class="ak-empty__title">{{ title }}</text>
    <text v-if="description.length > 0" class="ak-empty__description">{{ description }}</text>
    <view
      v-if="actionLabel.length > 0"
      class="ak-empty__action"
      role="button"
      :aria-label="actionLabel"
      @click="activate"
    >
      <view class="ak-empty__action-surface">
        <ak-icon :name="actionIcon" :size="14" />
        <text class="ak-empty__action-label">{{ actionLabel }}</text>
      </view>
    </view>
    <slot />
  </view>
</template>

<script lang="uts">
export default {
  props: {
    title: { type: String, default: '' },
    description: { type: String, default: '' },
    icon: { type: String, default: 'empty' },
    actionLabel: { type: String, default: '' },
    actionIcon: { type: String, default: 'retry' },
  },
  emits: ['action'],
  methods: {
    activate() {
      this.$emit('action')
    },
  },
}
</script>

