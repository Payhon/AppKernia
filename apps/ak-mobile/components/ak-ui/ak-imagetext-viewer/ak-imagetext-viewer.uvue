<template>
  <view class="viewer">
    <swiper v-if="media.length > 0" class="gallery" indicator-dots circular previous-margin="18px" next-margin="18px">
      <swiper-item v-for="item in media" :key="item.id"><image class="gallery-image" :src="asset(item.url)" mode="aspectFill" :alt="item.altText" @click="preview(item.id)" /></swiper-item>
    </swiper>
    <image v-else-if="cover.length > 0" class="gallery-image fallback-cover" :src="cover" mode="aspectFill" :alt="title" @click="previewCover" />
    <text class="title">{{ title }}</text>
    <text class="summary">{{ summary }}</text>
    <text class="meta">{{ category }} · {{ meta }}</text>
    <view v-for="block in blocks" :key="block.id" :class="blockClass(block.kind)">
      <image v-if="block.kind === 'image' && block.url.length > 0" class="body-image" :src="block.url" mode="widthFix" />
      <text v-else>{{ block.text }}</text>
    </view>
    <view class="tags"><text v-for="tag in tags" :key="tag.id" class="tag">#{{ tag.name }}</text></view>
  </view>
</template>

<script lang="uts">
import { ArticleBodyBlock } from '../../../src/features/articles/application/article-body-renderer.uts'
import { ContentMedia, ContentTag } from '../../../src/features/articles/domain/models.uts'
import { articleRuntime } from '../../../src/features/articles/infrastructure/article-runtime.uts'
export default {
  props: {
    category: { type: String, default: '' }, title: { type: String, default: '' }, summary: { type: String, default: '' }, meta: { type: String, default: '' }, cover: { type: String, default: '' },
    blocks: { type: Array<ArticleBodyBlock>, default: () => [] as Array<ArticleBodyBlock> }, media: { type: Array<ContentMedia>, default: () => [] as Array<ContentMedia> }, tags: { type: Array<ContentTag>, default: () => [] as Array<ContentTag> },
  },
  methods: {
    asset(value: string | null): string { return articleRuntime.assetUrl(value) },
    blockClass(kind: string): string { return kind === 'image' ? 'body-image-wrap' : kind === 'heading' ? 'body-heading' : kind === 'callout' ? 'callout' : 'body-paragraph' },
    preview(id: string) {
      const urls: Array<string> = []
      let current = 0
      for (let index = 0; index < this.media.length; index++) {
        const item = this.media[index]
        const url = this.asset(item.url)
        if (url.length == 0) continue
        if (item.id === id) current = urls.length
        urls.push(url)
      }
      if (urls.length == 0) return
      uni.previewImage({ current: current, urls: urls })
    },
    previewCover() {
      if (this.cover.length == 0) return
      uni.previewImage({ current: 0, urls: [this.cover] })
    },
  },
}
</script>

<style lang="scss">
.gallery { width: 100%; height: 300px; margin-bottom: 24px; }
.gallery-image { width: 100%; height: 300px; border-radius: 16px; }
.fallback-cover { width: 100%; margin-bottom: 24px; }
.title { color: var(--ak-text); font-size: 28px; line-height: 37px; font-weight: 800; }
.summary { color: var(--ak-text); font-size: 17px; line-height: 27px; margin-top: 12px; }
.meta { color: var(--ak-muted); font-size: 14px; margin-top: 10px; }
.body-heading { font-size: 24px; line-height: 32px; font-weight: 750; color: var(--ak-text); margin: 28px 0 10px; }
.body-paragraph { font-size: 17px; line-height: 30px; color: var(--ak-text); margin: 12px 0; }
.body-image-wrap { width: 100%; margin: 18px 0; }
.body-image { width: 100%; border-radius: 14px; }
.callout { font-size: 16px; line-height: 26px; color: var(--ak-callout-text); background: var(--ak-accent-surface); border-left: 3px solid var(--ak-brand); padding: 16px; border-radius: 12px; margin: 20px 0; }
.tags { flex-direction: row; flex-wrap: wrap; margin: 20px 0; }
.tag { color: var(--ak-brand); margin-right: 10px; }
</style>
