<template>
  <view v-if="providers.length>0" class="provider-section">
    <view class="provider-divider"><view class="provider-line"/><text class="provider-divider-label">{{t(mode==='login'?'oauth.continueWith':'oauth.bindWith',null)}}</text><view class="provider-line"/></view>
    <view class="provider-list">
      <view v-for="item in providers" :key="item.providerCode" :class="activeCode.length>0?(activeCode===item.providerCode?'provider-action provider-action--active':'provider-action provider-action--disabled'):'provider-action'" role="button" :aria-disabled="activeCode.length>0" :aria-label="providerActionLabel(item)" @click="authorize(item)">
        <view :class="'provider-badge provider-badge--'+item.providerCode"><image class="provider-icon" :src="providerIcon(item.providerCode)" mode="aspectFit" /></view>
      </view>
    </view>
    <text v-if="waiting" class="provider-waiting">{{t('oauth.browserWaiting',null)}}</text>
    <text v-if="errorText.length>0" class="provider-error">{{errorText}}</text>
  </view>
</template>
<script lang="uts">
import { AkError } from '../../../src/core/errors/ak-error.uts'
import { akI18n } from '../../../src/core/i18n/ak-i18n.uts'
import { themeState } from '../../../src/core/theme/theme-store.uts'
import { oauthCoordinator } from '../../../src/features/auth/oauth-coordinator.uts'
import { OAuthProviderCode, OAuthProviderDescriptor } from '../../../src/features/auth/oauth-models.uts'
import { oauthProviderIcon } from '../../../src/features/auth/oauth-provider-assets.uts'
import { appPublicConfigRuntime } from '../../../src/features/app-config/public-config-runtime.uts'
export default { name:'AkLoginProviderList', props:{mode:{type:String,default:'login'},excludedProviders:{type:Array,default:()=>[]}}, emits:['authenticated','bound','failure','step-up-required'], data(){return{providers:[] as Array<OAuthProviderDescriptor>,activeCode:'',waiting:false,errorText:''}},computed:{t(){return akI18n.t}},watch:{mode(){this.load()},excludedProviders(){this.load()}},mounted(){this.load()},methods:{load(){if(this.mode==='login'&&!appPublicConfigRuntime.oauthEnabled()){this.providers=[];return}oauthCoordinator.loadProviders(this.mode==='login'?'login':'bind',items=>{const visible:Array<OAuthProviderDescriptor>=[];items.forEach((item:OAuthProviderDescriptor)=>{if((this.excludedProviders as Array<string>).indexOf(item.providerCode)<0)visible.push(item)});this.providers=visible},_error=>{this.providers=[]})},providerName(item:OAuthProviderDescriptor):string{return akI18n.t(item.displayNameKey,null)},providerIcon(code:OAuthProviderCode):string{return oauthProviderIcon(code,themeState.isDark)},providerActionLabel(item:OAuthProviderDescriptor):string{return akI18n.t(this.mode==='login'?'oauth.accessibility.login':'oauth.accessibility.bind',new Map<string,string>([['provider',this.providerName(item)]]))},authorize(item:OAuthProviderDescriptor){if(this.activeCode.length>0)return;this.activeCode=item.providerCode;this.waiting=false;this.errorText='';oauthCoordinator.authorize(item.providerCode,this.mode==='login'?'login':'bind',()=>{this.waiting=true},result=>{this.activeCode='';this.waiting=false;if(result.mode==='login')this.$emit('authenticated');else this.$emit('bound',result.oauthAccount)},error=>this.failure(error,item.providerCode))},failure(error:AkError,provider:OAuthProviderCode){this.activeCode='';this.waiting=false;if(error.code==='IAM.OAUTH.AUTHORIZATION_DENIED'||error.code==='oauth.browser_cancelled')return;if(error.code==='IAM.STEP_UP.REQUIRED'){this.$emit('step-up-required',provider);return}this.errorText=akI18n.t(error.messageKey,null);this.$emit('failure',error.code)}}}
</script>
<style lang="scss">
.provider-section{margin-top:22px}.provider-divider{height:44px;flex-direction:row;align-items:center}.provider-line{height:1px;flex:1;background:var(--ak-border)}.provider-divider-label{font-size:13px;color:var(--ak-muted);margin:0 12px}.provider-list{flex-direction:row;flex-wrap:wrap;align-items:center;justify-content:center}.provider-action{width:48px;height:48px;min-height:48px;margin:0 8px 12px;align-items:center;justify-content:center;border:1px solid var(--ak-border);border-radius:24px;background:var(--ak-surface)}.provider-action--disabled{opacity:.45}.provider-action--active{opacity:.65;border-color:var(--ak-brand)}.provider-badge{width:40px;height:40px;border-radius:20px;align-items:center;justify-content:center;background:var(--ak-surface-subtle)}.provider-badge--wechat{background:#E8F8EE}.provider-badge--github{background:var(--ak-surface-subtle)}.provider-badge--google{background:#FFFFFF}.provider-badge--apple{background:var(--ak-surface-subtle)}.provider-icon{width:28px;height:28px}.provider-waiting{font-size:13px;line-height:19px;color:var(--ak-muted);text-align:center;margin-top:2px}.provider-error{font-size:13px;line-height:19px;color:var(--ak-danger);text-align:center;margin-top:4px}
</style>
