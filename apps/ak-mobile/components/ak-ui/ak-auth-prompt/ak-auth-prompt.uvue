<template>
  <ak-bottom-sheet :open="open" :title="t('auth.sheet.title', null)" expanded :height-ratio="0.75" @close="close">
    <view class="auth-sheet">
      <text class="auth-sheet-description">{{t('auth.sheet.description', null)}}</text>
      <ak-login-method-form @authenticated="authenticated" />
      <ak-login-provider-list mode="login" @authenticated="authenticated" />
      <view class="auth-links">
        <text class="auth-link" @click="navigate('/pages/auth/forgot-password/index')">{{t('auth.forgotPassword', null)}}</text>
        <text v-if="registrationEnabled" class="auth-link" @click="navigate('/pages/auth/register/index')">{{t('auth.register.link', null)}}</text>
      </view>
    </view>
  </ak-bottom-sheet>
</template>
<script lang="uts">
import { akI18n } from '../../../src/core/i18n/ak-i18n.uts'
import { authRuntime } from '../../../src/features/auth/auth-runtime.uts'
import { appPublicConfigRuntime } from '../../../src/features/app-config/public-config-runtime.uts'
import { authPromptCoordinator } from '../../../src/features/auth/auth-prompt-coordinator.uts'
export default { name:'AkAuthPrompt', props:{open:{type:Boolean,default:false}}, emits:['close','authenticated'], watch:{open(value:boolean){if(value&&!authPromptCoordinator.request())this.$emit('close')}}, computed:{t(){return akI18n.t},registrationEnabled():boolean{return appPublicConfigRuntime.registrationEnabled()}},methods:{close(){authPromptCoordinator.dismiss();this.$emit('close')},navigate(url:string){this.close();uni.navigateTo({url:url})},authenticated(){authRuntime.refreshContext(()=>{authPromptCoordinator.dismiss();this.$emit('authenticated')},()=>{uni.showToast({title:akI18n.t('errors.auth.unauthorized',null),icon:'none'})})}}}
</script>
<style lang="scss">
.auth-sheet{padding-bottom:20px}.auth-sheet-description{font-size:15px;line-height:22px;color:var(--ak-muted);margin-bottom:20px}.auth-links{min-height:52px;flex-direction:row;justify-content:space-between;align-items:center}.auth-link{color:var(--ak-brand);font-size:15px;padding:14px 4px}
</style>
