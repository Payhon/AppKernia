<template>
  <ak-bottom-sheet
    :open="open"
    :title="t('auth.sheet.title', null)"
    @close="close"
    ><view class="auth-sheet"
      ><text class="auth-sheet-description">{{
        t("auth.sheet.description", null)
      }}</text
      ><ak-text-field
        v-model="email"
        :label="t('auth.email', null)"
        :error="emailError"
      /><ak-text-field
        v-model="password"
        :label="t('auth.password', null)"
        :error="passwordError"
        password
      /><ak-status-view
        v-if="state === 'error'"
        state="error"
        :title="t('state.error.title', null)"
        :description="errorText"
      /><ak-button
        variant="primary"
        :loading="state === 'loading'"
        @click="login"
        >{{ t("auth.login", null) }}</ak-button
      ><view class="auth-links"
        ><text
          class="auth-link"
          @click="navigate('/pages/auth/forgot-password/index')"
          >{{ t("auth.forgotPassword", null) }}</text
        ><text
          v-if="registrationEnabled"
          class="auth-link"
          @click="navigate('/pages/auth/register/index')"
          >{{ t("auth.register.link", null) }}</text
        ></view
      ></view
    ></ak-bottom-sheet
  >
</template>
<script lang="uts">
import { akI18n } from '../../../src/core/i18n/ak-i18n.uts'
import { authRuntime } from '../../../src/features/auth/auth-runtime.uts'
import { appPublicConfigRuntime } from '../../../src/features/app-config/public-config-runtime.uts'
import { authPromptCoordinator } from '../../../src/features/auth/auth-prompt-coordinator.uts'
export default { name:'AkAuthPrompt', props:{open:{type:Boolean,default:false}}, emits:['close','authenticated'], watch:{open(value:boolean){if(value&&!authPromptCoordinator.request())this.$emit('close')}}, data(){return{email:'',password:'',state:'content',errorText:'',emailError:'',passwordError:''}},computed:{t(){return akI18n.t},registrationEnabled():boolean{return appPublicConfigRuntime.registrationEnabled()}},methods:{close(){authPromptCoordinator.dismiss();this.$emit('close')},navigate(url:string){this.close();uni.navigateTo({url:url})},login(){this.emailError='';this.passwordError='';if(this.email.trim().length==0){this.emailError=akI18n.t('errors.validation.required',null);return};if(this.password.length==0){this.passwordError=akI18n.t('errors.validation.required',null);return};const service=authRuntime.getService();if(service==null){this.state='error';this.errorText=akI18n.t('errors.runtime.unavailable',null);return};this.state='loading';service.login({email:this.email.trim(),password:this.password,deviceKey:authRuntime.getDeviceKey()},()=>{authRuntime.refreshContext(()=>{this.state='content';this.password='';authPromptCoordinator.dismiss();this.$emit('authenticated')},()=>{this.state='error';this.errorText=akI18n.t('errors.auth.unauthorized',null)})},error=>{this.state='error';this.errorText=akI18n.t(error.messageKey,null)})}}}
</script>
<style lang="scss">
.auth-sheet {
  padding-bottom: 20px;
}
.auth-sheet-description {
  font-size: 15px;
  line-height: 22px;
  color: var(--ak-muted);
  margin-bottom: 20px;
}
.auth-links {
  min-height: 52px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.auth-link {
  color: var(--ak-brand);
  font-size: 15px;
  padding: 14px 4px;
}
</style>
