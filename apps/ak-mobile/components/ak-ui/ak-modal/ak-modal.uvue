<template><view v-if="open" class="ak-modal"><view class="ak-modal__panel"><text class="ak-modal__title">{{ title }}</text><text class="ak-modal__body">{{ message }}</text><view class="ak-modal__actions"><view class="ak-modal__action"><ak-button variant="secondary" :label="cancelText" @click="$emit('cancel')" /></view><view class="ak-modal__action-spacer" /><view class="ak-modal__action"><ak-button variant="danger" :label="confirmText" @click="$emit('confirm')" /></view></view></view></view></template>
<script lang="uts">export default { props: { open: { type: Boolean, default: false }, title: { type: String, default: '' }, message: { type: String, default: '' }, cancelText: { type: String, default: '' }, confirmText: { type: String, default: '' } }, emits: ['cancel','confirm'] }</script>
<style lang="scss">.ak-modal { position:fixed; left:0; right:0; top:0; bottom:0; background:rgba(15,23,42,0.42); align-items:center; justify-content:center; padding:24px; box-sizing:border-box; }.ak-modal__panel { width:100%; background:var(--ak-surface); border:1px solid var(--ak-border); border-radius:var(--ak-radius-hero); padding:24px; box-sizing:border-box; }.ak-modal__title { color:var(--ak-text); font-size:20px; font-weight:600; line-height:28px; }.ak-modal__body { color:var(--ak-muted); font-size:16px; line-height:23px; margin-top:12px; }.ak-modal__actions { flex-direction:row; align-items:center; margin-top:24px; }.ak-modal__action { flex:1; }.ak-modal__action-spacer { width:8px; }</style>
