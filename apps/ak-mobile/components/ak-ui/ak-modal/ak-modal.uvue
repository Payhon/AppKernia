<template><view v-if="open" class="ak-modal"><view class="ak-modal__panel"><text class="ak-modal__title">{{ title }}</text><text class="ak-modal__body">{{ message }}</text><view class="ak-modal__actions"><ak-button variant="secondary" @click="$emit('cancel')">{{ cancelText }}</ak-button><ak-button variant="danger" @click="$emit('confirm')">{{ confirmText }}</ak-button></view></view></view></template>
<script lang="uts">export default { props: { open: { type: Boolean, default: false }, title: { type: String, default: '' }, message: { type: String, default: '' }, cancelText: { type: String, default: '' }, confirmText: { type: String, default: '' } }, emits: ['cancel','confirm'] }</script>
<style lang="scss">.ak-modal { position:fixed; left:0; right:0; top:0; bottom:0; background:rgba(15,23,42,.48); align-items:center; justify-content:center; padding:24px; }.ak-modal__panel { width:100%; background:var(--ak-surface); border-radius:16px; padding:24px; }.ak-modal__title { color:var(--ak-text); font-size:18px; font-weight:600; }.ak-modal__body { color:var(--ak-muted); margin-top:12px; }.ak-modal__actions { flex-direction:row; margin-top:20px; }</style>
