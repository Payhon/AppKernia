<template>
  <view class="login-method-form">
    <ak-login-method-switch v-model="method" :otp-enabled="otpEnabled" />
    <view v-if="method==='otp'&&emailOTPEnabled&&smsOTPEnabled" class="channel-switch" role="tablist" :aria-label="t('auth.otp.channel', null)"><view :class="otpType==='email'?'channel-option channel-option--selected':'channel-option'" role="tab" :aria-selected="otpType==='email'" @click="selectOTPType('email')"><text class="channel-label">{{t('auth.method.emailOtp',null)}}</text></view><view :class="otpType==='mobile'?'channel-option channel-option--selected':'channel-option'" role="tab" :aria-selected="otpType==='mobile'" @click="selectOTPType('mobile')"><text class="channel-label">{{t('auth.method.smsOtp',null)}}</text></view></view>
    <ak-text-field v-if="method==='password'||otpType==='email'" v-model="email" :label="t('auth.email', null)" :error="identifierError" input-type="email" />
    <ak-text-field v-else v-model="mobile" :label="t('auth.mobile', null)" :placeholder="t('auth.mobilePlaceholder', null)" :error="identifierError" input-type="tel" />
    <ak-text-field v-if="method==='password'" v-model="password" :label="t('auth.password', null)" :error="secretError" password />
    <view v-if="method==='otp'" class="otp-row">
      <view class="otp-field"><ak-text-field v-model="verificationCode" :label="t('auth.otp.code', null)" :error="secretError" input-type="number" :max-length="6" /></view>
      <view :class="countdown>0||sending?'otp-send otp-send--disabled':'otp-send'" role="button" :aria-label="sendLabel" @click="sendOTP"><text class="otp-send-label">{{sendLabel}}</text></view>
    </view>
    <text v-if="method==='otp'&&challengeId.length>0" class="challenge-status">{{t('auth.otp.sent', null)}}</text>
    <ak-status-view v-if="state==='error'" state="error" :title="t('state.error.title', null)" :description="errorText" />
    <ak-button :loading="state==='loading'" :loading-text="t('common.loading', null)" :label="t('auth.login', null)" @click="submit" />
    <ak-interactive-captcha :open="captchaOpen" :challenge="captchaChallenge" :loading="captchaLoading" :error-text="captchaError" @confirm="confirmCaptcha" @refresh="refreshCaptcha" @close="closeCaptcha" />
  </view>
</template>
<script lang="uts">
import { HttpCancellation } from '../../../src/core/network/http-port.uts'
import { AkError } from '../../../src/core/errors/ak-error.uts'
import { akI18n } from '../../../src/core/i18n/ak-i18n.uts'
import { authRuntime } from '../../../src/features/auth/auth-runtime.uts'
import { appPublicConfigRuntime } from '../../../src/features/app-config/public-config-runtime.uts'
import { OTPChallenge, OTPIdentifierType } from '../../../src/features/auth/auth-repository.uts'
import { captchaRuntime } from '../../../src/features/captcha/captcha-runtime.uts'
import { AkInteractiveCaptchaChallenge, AkInteractiveCaptchaResponse } from '../../../uni_modules/ak-interactive-captcha/model.uts'
let activeTask: HttpCancellation | null = null
let countdownTimer: number = 0
export default {
  name:'AkLoginMethodForm',emits:['authenticated'],
  data(){return{method:'password',otpType:appPublicConfigRuntime.emailOTPEnabled()?'email':'mobile',email:'',mobile:'',password:'',verificationCode:'',challengeId:'',state:'content',errorText:'',identifierError:'',secretError:'',sending:false,countdown:0,captchaOpen:false,captchaLoading:false,captchaError:'',captchaChallenge:null as AkInteractiveCaptchaChallenge|null}},
  computed:{t(){return akI18n.t},otpEnabled():boolean{return appPublicConfigRuntime.otpEnabled()},emailOTPEnabled():boolean{return appPublicConfigRuntime.emailOTPEnabled()},smsOTPEnabled():boolean{return appPublicConfigRuntime.smsOTPEnabled()},sendLabel():string{return this.sending?akI18n.t('common.loading',null):this.countdown>0?akI18n.t('auth.otp.resendIn',new Map<string,string>([['seconds',this.countdown.toString()]])):akI18n.t(this.challengeId.length>0?'auth.otp.resend':'auth.otp.send',null)}},
  watch:{method(){this.clearChallenge();this.closeCaptcha();this.password='';this.verificationCode='';this.state='content';this.errorText='';this.identifierError='';this.secretError=''}},
  beforeUnmount(){this.cancelTask();this.stopTimer()},
  methods:{
    selectOTPType(value:string){if(value==='email'||value==='mobile'){this.otpType=value;this.clearChallenge();this.closeCaptcha();this.identifierError='';this.secretError=''}},cancelTask(){const task=activeTask;activeTask=null;if(task!=null)task.cancel()},stopTimer(){if(countdownTimer!=0){clearInterval(countdownTimer);countdownTimer=0}},clearChallenge(){this.challengeId='';this.countdown=0;this.stopTimer()},identifierType():OTPIdentifierType{return this.method==='password'?'email':this.otpType==='mobile'?'mobile':'email'},identifierValue():string{return this.identifierType()==='mobile'?this.mobile.trim():this.email.trim()},
    validateIdentifier():boolean{const value=this.identifierValue();if(value.length==0){this.identifierError=akI18n.t('errors.validation.required',null);return false}if(this.identifierType()==='mobile'&&!/^\+[1-9][0-9]{7,14}$/.test(value)){this.identifierError=akI18n.t('errors.validation.mobile',null);return false}if(this.identifierType()==='email'&&(value.indexOf('@')<=0||value.endsWith('@'))){this.identifierError=akI18n.t('errors.validation.email',null);return false}return true},
    startCountdown(seconds:number){this.stopTimer();this.countdown=seconds>0?seconds:60;countdownTimer=setInterval(()=>{if(this.countdown<=1){this.countdown=0;this.stopTimer()}else this.countdown-=1},1000)},
    sendOTP(){if(this.sending||this.countdown>0)return;this.identifierError='';this.secretError='';if(!this.validateIdentifier())return;const service=authRuntime.getService();if(service==null){this.showError('errors.runtime.unavailable');return}if(this.identifierType()==='mobile'){this.openCaptcha();return}this.sending=true;activeTask=service.sendEmailOTP(this.identifierValue(),challenge=>this.sent(challenge),error=>this.sendFailed(error))},
    openCaptcha(){const repository=captchaRuntime.getRepository();if(repository==null){this.showError('errors.runtime.unavailable');return};this.sending=true;this.captchaOpen=true;this.captchaLoading=true;this.captchaError='';activeTask=repository.create({scene:'login',mobile:this.identifierValue(),identifierId:'',purpose:'',resource:''},challenge=>{this.captchaChallenge=challenge;this.captchaLoading=false},error=>{this.captchaLoading=false;this.captchaError=akI18n.t(error.messageKey,null)})},
    refreshCaptcha(){this.openCaptcha()},closeCaptcha(){this.captchaOpen=false;this.captchaLoading=false;this.captchaChallenge=null;this.captchaError='';this.sending=false},
    confirmCaptcha(response:AkInteractiveCaptchaResponse){const repository=captchaRuntime.getRepository();const service=authRuntime.getService();const challenge=this.captchaChallenge;if(repository==null||service==null||challenge==null)return;this.captchaLoading=true;activeTask=service.sendMobileOTP(this.identifierValue(),repository.submission(challenge,response),value=>{this.closeCaptcha();this.sent(value)},error=>{this.captchaLoading=false;this.captchaError=akI18n.t(error.messageKey,null)})},
    sent(challenge:OTPChallenge){this.sending=false;this.challengeId=challenge.challengeId;this.startCountdown(challenge.retryAfterSeconds)},sendFailed(error:AkError){this.sending=false;this.showError(error.messageKey)},
    submit(){this.identifierError='';this.secretError='';if(!this.validateIdentifier())return;const service=authRuntime.getService();if(service==null){this.showError('errors.runtime.unavailable');return}this.state='loading';if(this.method==='password'){if(this.password.length==0){this.state='content';this.secretError=akI18n.t('errors.validation.required',null);return}activeTask=service.login({email:this.email.trim(),password:this.password,deviceKey:authRuntime.getDeviceKey()},()=>this.complete(),error=>this.fail(error.messageKey));return}if(this.challengeId.length==0){this.state='content';this.secretError=akI18n.t('auth.otp.sendFirst',null);return}if(!/^[0-9]{6}$/.test(this.verificationCode)){this.state='content';this.secretError=akI18n.t('errors.validation.otp',null);return}activeTask=service.loginOTP({identifierType:this.identifierType(),identifier:this.identifierValue(),challengeId:this.challengeId,verificationCode:this.verificationCode},()=>this.complete(),error=>this.fail(error.messageKey))},
    complete(){activeTask=null;this.state='content';this.password='';this.verificationCode='';this.clearChallenge();this.$emit('authenticated')},fail(key:string){activeTask=null;this.state='error';this.errorText=akI18n.t(key,null)},showError(key:string){this.state='error';this.errorText=akI18n.t(key,null)}
  }
}
</script>
<style lang="scss">
.login-method-form{width:100%}.channel-switch{flex-direction:row;align-items:center;margin:-6px 0 14px}.channel-option{min-height:44px;padding:0 14px;align-items:center;justify-content:center;border-bottom:2px solid transparent}.channel-option--selected{border-bottom-color:var(--ak-brand)}.channel-label{font-size:14px;color:var(--ak-text)}.otp-row{flex-direction:row;align-items:flex-start}.otp-field{flex:1}.otp-send{width:112px;min-height:48px;margin-left:10px;margin-top:23px;padding:0 8px;border:1px solid var(--ak-brand);border-radius:12px;align-items:center;justify-content:center}.otp-send--disabled{opacity:.5}.otp-send-label{font-size:13px;line-height:18px;text-align:center;color:var(--ak-brand);font-weight:600}.challenge-status{font-size:13px;line-height:18px;color:var(--ak-success);margin:-6px 0 12px}
</style>
