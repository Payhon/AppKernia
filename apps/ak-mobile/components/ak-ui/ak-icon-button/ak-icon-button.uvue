<template>
  <view
    class="ak-icon-button"
    :class="active ? 'ak-icon-button--active' : ''"
    role="button"
    :aria-label="label"
    @click.stop="activate"
  >
    <loading v-if="loading" class="ak-icon-button__loading" />
    <ak-icon v-else :name="name" :tone="tone" :filled="filled || active" :size="iconSize" />
    <view v-if="badge" :class="badgeTone == 'danger' ? 'ak-icon-button__badge ak-icon-button__badge--danger' : 'ak-icon-button__badge'" />
  </view>
</template>

<script lang="uts">
export default {
  props: {
    name: { type: String, default: 'search' },
    label: { type: String, default: '' },
    tone: { type: String, default: 'primary' },
    filled: { type: Boolean, default: false },
    active: { type: Boolean, default: false },
    disabled: { type: Boolean, default: false },
    loading: { type: Boolean, default: false },
    badge: { type: Boolean, default: false },
    badgeTone: { type: String, default: 'brand' },
    iconSize: { type: Number, default: 16 },
  },
  emits: ['click'],
  methods: {
    activate() {
      if (this.disabled || this.loading) return
      this.$emit('click')
    },
  },
}
</script>

<style lang="scss">
.ak-icon-button {
  width: 44px;
  height: 44px;
  border-radius: 22px;
  align-items: center;
  justify-content: center;
  position: relative;
}
.ak-icon-button--active { background: var(--ak-accent-surface); }
.ak-icon-button__loading { width: 16px; height: 16px; }
.ak-icon-button__badge {
  position: absolute;
  z-index: 2;
  top: 7px;
  right: 7px;
  width: 7px;
  height: 7px;
  border-radius: 4px;
  background: var(--ak-brand);
  border: 1px solid var(--ak-surface);
}
.ak-icon-button__badge--danger { background: var(--ak-danger); }
</style>
