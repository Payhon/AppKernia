<template>
  <view class="section"
    ><text class="section-title">{{ title }}</text
    ><scroll-view v-if="horizontal" class="horizontal" scroll-x
      ><view class="row"
        ><ak-card
          v-for="item in items"
          :key="item.id"
          class="horizontal-card"
          @click="$emit('open', item.slug)"
          ><image
            v-if="item.coverUrl != null"
            class="thumb-wide"
            :src="asset(item.coverUrl)"
            mode="aspectFill"
            :alt="item.title"
          /><text class="item-type">{{ typeLabel(item.contentType) }}</text
          ><text class="item-title">{{ item.title }}</text></ak-card
        ></view
      ></scroll-view
    ><view v-else
      ><ak-card
        v-for="item in items"
        :key="item.id"
        class="timeline-card"
        @click="$emit('open', item.slug)"
        ><view class="timeline-copy"
          ><text class="item-type">{{ typeLabel(item.contentType) }}</text
          ><text class="item-title">{{ item.title }}</text
          ><text class="item-summary">{{ item.summary }}</text></view
        ><image
          v-if="item.coverUrl != null"
          class="thumb"
          :src="asset(item.coverUrl)"
          mode="aspectFill"
          :alt="item.title" /></ak-card></view
  ></view>
</template>
<script lang="uts">
import {akI18n} from '../src/core/i18n/ak-i18n.uts';import {ArticleSummary} from '../src/features/articles/domain/models.uts';import {articleRuntime} from '../src/features/articles/infrastructure/article-runtime.uts';export default{props:{title:{type:String,default:''},items:{type:Array<ArticleSummary>,default:()=>[] as Array<ArticleSummary>},horizontal:{type:Boolean,default:false}},emits:['open'],methods:{typeLabel(value:string):string{return akI18n.t('information.type.'+value,null)},asset(value:string|null):string{return articleRuntime.assetUrl(value)}}}
</script>
