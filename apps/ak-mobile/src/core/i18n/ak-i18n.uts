import { AkLocale } from './types.uts'
import zhCNJson from '../../../locale/zh-CN.json'
import enUSJson from '../../../locale/en-US.json'

type CatalogValues = Map<string, string>

const zhCN: CatalogValues = catalogFromJson(zhCNJson as UTSJSONObject)
const enUS: CatalogValues = catalogFromJson(enUSJson as UTSJSONObject)

function catalogFromJson(source: UTSJSONObject): CatalogValues {
  const catalog: CatalogValues = new Map<string, string>()
  source.toMap().forEach((entry) => {
    const value: string | null = source.getString(entry.key)
    if (value != null) catalog.set(entry.key, value)
  })
  return catalog
}

export class AkI18n {
  private locale: AkLocale = 'zh-CN'
  readonly t: (key: string, params: Map<string, string> | null) => string = (key, params) => this.translate(key, params)

  getLocale(): AkLocale {
    return this.locale
  }

  setLocale(locale: AkLocale): void {
    this.locale = locale
  }

  private translate(key: string, params: Map<string, string> | null): string {
    const catalog: CatalogValues = this.locale == 'en-US' ? enUS : zhCN
    const stored: string | null = catalog.get(key)
    let value: string = stored != null ? stored : key
    if (params != null) {
      params.forEach((parameterValue: string, parameterKey: string) => {
        value = value.replace('{' + parameterKey + '}', parameterValue)
      })
    }
    return value
  }
}

export const akI18n = new AkI18n()
