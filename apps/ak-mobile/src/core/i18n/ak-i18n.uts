import { AkLocale } from './types.uts'
import { zhCNEntries, enUSEntries } from './generated/catalog-entries.uts'

type CatalogValues = Map<string, string>

const zhCN: CatalogValues = catalogFromEntries(zhCNEntries as Array<string>)
const enUS: CatalogValues = catalogFromEntries(enUSEntries as Array<string>)

function catalogFromEntries(source: Array<string>): CatalogValues {
  const catalog: CatalogValues = new Map<string, string>()
  let index = 0
  while (index + 1 < source.length) {
    catalog.set(source[index], source[index + 1])
    index += 2
  }
  return catalog
}

export class AkI18n {
  private locale: AkLocale = 'zh-CN'
  readonly t: (key: string, params: Map<string, string> | null) => string = (key, params) => this.translate(key, params)

  getLocale(): AkLocale {
    return this.locale
  }

  setLocale(locale: AkLocale): void {
    this.locale = locale
  }

  formatDateTime(value: string): string {
    const parsed = new Date(value)
    if (isNaN(parsed.getTime())) return value
    const pad = (part: number): string => part < 10 ? '0' + part.toString() : part.toString()
    return parsed.getFullYear().toString() + '-' + pad(parsed.getMonth() + 1) + '-' + pad(parsed.getDate()) + ' ' + pad(parsed.getHours()) + ':' + pad(parsed.getMinutes())
  }

  private translate(key: string, params: Map<string, string> | null): string {
    const catalog: CatalogValues = this.locale == 'en-US' ? enUS : zhCN
    const stored: string | null = catalog.get(key)
    let value: string = stored != null ? stored : key
    if (params != null) {
      params.forEach((parameterValue: string, parameterKey: string) => {
        value = value.replace('{' + parameterKey + '}', parameterValue)
      })
    }
    return value
  }
}

export const akI18n = new AkI18n()
