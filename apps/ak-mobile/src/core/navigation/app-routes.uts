import { AkNavigator } from './ak-navigator.uts'
import { AkRouteGuard, NavigationContext, RouteDefinition } from './route-guard.uts'
import { authContextStore } from '../stores/auth-context-store.uts'

const routes: Array<RouteDefinition> = [
  { key: 'auth.register', path: 'pages/auth/register/index', access: 'guest', permission: null, featureFlag: 'registration_enabled' },
  { key: 'auth.forgot-password', path: 'pages/auth/forgot-password/index', access: 'guest', permission: null, featureFlag: null },
  { key: 'auth.reset-password', path: 'pages/auth/reset-password/index', access: 'guest', permission: null, featureFlag: null },
  { key: 'auth.verify-contact', path: 'pages/auth/verify-contact/index', access: 'guest', permission: null, featureFlag: null },
  { key: 'auth.oauth-callback', path: 'pages/auth/oauth-callback/index', access: 'public', permission: null, featureFlag: null },
  { key: 'legal.privacy', path: 'pages/legal/privacy/index', access: 'public', permission: null, featureFlag: null },
  { key: 'legal.terms', path: 'pages/legal/terms/index', access: 'public', permission: null, featureFlag: null },
  { key: 'legal.page', path: 'pages/legal/page/index', access: 'public', permission: null, featureFlag: null },
  { key: 'home', path: 'pages/home/index', access: 'public', permission: null, featureFlag: null },
  { key: 'scanner.webview', path: 'pages/scanner/webview/index', access: 'public', permission: null, featureFlag: null },
  { key: 'content.browse', path: 'pages/browse/index', access: 'public', permission: null, featureFlag: null },
  { key: 'content.browse-search', path: 'pages/browse/search/index', access: 'public', permission: null, featureFlag: null },
  { key: 'content.topics', path: 'pages/topics/index', access: 'public', permission: null, featureFlag: null },
  { key: 'content.topic-detail', path: 'pages/topics/detail/index', access: 'public', permission: null, featureFlag: null },
  { key: 'content.bookmarks', path: 'pages/bookmarks/index', access: 'public', permission: null, featureFlag: null },
  { key: 'notifications.list', path: 'pages/notifications/index', access: 'authenticated', permission: null, featureFlag: null },
  { key: 'profile.index', path: 'pages/profile/index', access: 'public', permission: null, featureFlag: null },
  { key: 'profile.basic', path: 'pages/profile/basic/index', access: 'authenticated', permission: null, featureFlag: null },
  { key: 'profile.edit', path: 'pages/profile/edit/index', access: 'authenticated', permission: null, featureFlag: null },
  { key: 'profile.security', path: 'pages/profile/security/index', access: 'authenticated', permission: null, featureFlag: null },
  { key: 'profile.connections', path: 'pages/profile/connections/index', access: 'authenticated', permission: null, featureFlag: null },
  { key: 'profile.change-password', path: 'pages/profile/change-password/index', access: 'authenticated', permission: null, featureFlag: null },
  { key: 'profile.sessions', path: 'pages/profile/sessions/index', access: 'authenticated', permission: null, featureFlag: null },
  { key: 'profile.devices', path: 'pages/profile/devices/index', access: 'authenticated', permission: null, featureFlag: null },
  { key: 'account.deletion', path: 'pages/profile/account-deletion/index', access: 'authenticated', permission: null, featureFlag: 'account_deletion' },
  { key: 'settings.language', path: 'pages/settings/language/index', access: 'authenticated', permission: null, featureFlag: null },
  { key: 'settings.permissions', path: 'pages/settings/permissions/index', access: 'authenticated', permission: null, featureFlag: null },
  { key: 'settings.notifications', path: 'pages/settings/notifications/index', access: 'authenticated', permission: null, featureFlag: null },
  { key: 'settings.appearance', path: 'pages/settings/appearance/index', access: 'authenticated', permission: null, featureFlag: null },
  { key: 'help', path: 'pages/help/index', access: 'authenticated', permission: null, featureFlag: null },
  { key: 'about', path: 'pages/about/index', access: 'public', permission: null, featureFlag: null },
  { key: 'articles.list', path: 'pages/articles/list/index', access: 'public', permission: null, featureFlag: null },
  { key: 'articles.detail', path: 'pages/articles/detail/index', access: 'public', permission: null, featureFlag: null },
  { key: 'feedback', path: 'pages/feedback/index', access: 'authenticated', permission: null, featureFlag: null },
  { key: 'feedback.create', path: 'pages/feedback/create/index', access: 'authenticated', permission: null, featureFlag: null },
  { key: 'feedback.detail', path: 'pages/feedback/detail/index', access: 'authenticated', permission: null, featureFlag: null },
]

export const akNavigator = new AkNavigator(routes, new AkRouteGuard())

export function authenticatedNavigationContext(): NavigationContext { return authContextStore.navigationContext() }

export function navigateArticleDetail(slug: string): boolean {
  const route = routes.find((item: RouteDefinition) => item.key == 'articles.detail')
  if (route == null || !new AkRouteGuard().canEnter(route, authenticatedNavigationContext()) || !/^[a-z0-9-]+$/.test(slug)) {
    uni.navigateTo({ url: '/pages/error/forbidden/index' })
    return false
  }
  uni.navigateTo({ url: '/pages/articles/detail/index?slug=' + encodeURIComponent(slug) })
  return true
}
