import { feedbackRuntime } from '../../features/feedback/feedback-runtime.uts'
import appManifest from '../../../manifest.json'
import { AkConfig, AkEnvironment } from '../config/config.uts'
import { appSessionStore } from '../stores/session-store.uts'
import { SessionRuntime } from '../stores/session-runtime.uts'
import { AkSecureSessionStorage } from '../stores/ak-secure-session-storage.uts'
import { articleRuntime } from '../../features/articles/infrastructure/article-runtime.uts'
import { authRuntime } from '../../features/auth/auth-runtime.uts'
import { AkHttpClient } from '../network/ak-http-client.uts'
import { RefreshCoordinator } from '../network/refresh-coordinator.uts'
import { profileRuntime } from '../../features/profile/infrastructure/profile-runtime.uts'
import { notificationsRuntime } from '../../features/notifications/infrastructure/notifications-runtime.uts'
import { preferencesRuntime } from '../../features/preferences/infrastructure/preferences-runtime.uts'
import { versionRuntime } from '../../features/version/infrastructure/version-runtime.uts'
import { akI18n } from '../i18n/ak-i18n.uts'
import { themeStore } from '../theme/theme-store.uts'
import { legalConsentStore } from '../../features/legal/legal-consent-store.uts'
import { legalRuntime } from '../../features/legal/legal-runtime.uts'
import { appPublicConfigRuntime } from '../../features/app-config/public-config-runtime.uts'
import { akUpgradeCoordinator } from '../../../uni_modules/ak-upgrade/coordinator.uts'
import { onboardingStore } from '../../features/onboarding/onboarding-store.uts'
import { preloadOnboardingSlides } from '../../features/onboarding/onboarding-preloader.uts'
import { pushRuntime } from '../../features/push/infrastructure/push-runtime.uts'
import { pushCoordinator } from '../../features/push/application/push-coordinator.uts'
import { accountDeletionRuntime } from '../../features/account-deletion/infrastructure/account-deletion-runtime.uts'
import { oauthCoordinator } from '../../features/auth/oauth-coordinator.uts'
import { loginMethodsRuntime } from '../../features/auth/login-methods-runtime.uts'

/**
 * Reads only the packaged, approved manifest configuration. No production URL,
 * access token, or permissive default is embedded in source. A release build
 * must set `akRuntime.apiBaseUrl` to the approved `/api/v1` base URL.
 */
export function initializeAppRuntime(): boolean {
  if (!legalConsentStore.acceptedAll()) { uni.reLaunch({ url: '/pages/privacy/consent/index' }); return false }
  const sessionRuntime = new SessionRuntime(appSessionStore, new AkSecureSessionStorage())
  const manifest: UTSJSONObject = appManifest as UTSJSONObject
  const raw: UTSJSONObject | null = manifest['akRuntime'] as UTSJSONObject | null
  if (raw == null) { uni.reLaunch({ url: '/pages/error/offline/index' }); return false }
  const environment: string | null = raw['environment'] as string | null
  const apiBaseUrl: string | null = raw['apiBaseUrl'] as string | null
  const appId: string | null = raw['appId'] as string | null
  if (apiBaseUrl == null || apiBaseUrl.length == 0 || appId == null || appId.length == 0) { uni.reLaunch({ url: '/pages/error/offline/index' }); return false }
  if (environment != 'development' && environment != 'test' && environment != 'production') { uni.reLaunch({ url: '/pages/error/offline/index' }); return false }
  const config = new AkConfig(environment as AkEnvironment, apiBaseUrl, appId)
  const client = new AkHttpClient(config, appSessionStore)
  appPublicConfigRuntime.configure(client, config.appId, config.apiBaseUrl)
  legalRuntime.configure(client)
  oauthCoordinator.onCompleted(result => { if (result.mode == 'login') completeAuthenticatedBootstrap() })
  authRuntime.configure(client, sessionRuntime, () => continueAfterDeviceKey(config, client, sessionRuntime), () => {
    uni.reLaunch({ url: '/pages/error/offline/index?reason=secure_storage_unavailable' })
  })
  return true
}

/** No OAuth callback or authenticated request starts before the persisted installation key is ready. */
function continueAfterDeviceKey(config: AkConfig, client: AkHttpClient, sessionRuntime: SessionRuntime): void {
  loginMethodsRuntime.configure(client)
  const auth = authRuntime.getService()
  if (auth != null) {
    articleRuntime.configure(config, appSessionStore, auth, new RefreshCoordinator(sessionRuntime, auth))
    profileRuntime.configure(config, appSessionStore, sessionRuntime, auth)
    feedbackRuntime.configure(config, appSessionStore, sessionRuntime, auth)
    accountDeletionRuntime.configure(config, appSessionStore, sessionRuntime, auth)
    notificationsRuntime.configure(config, appSessionStore, sessionRuntime, auth)
    preferencesRuntime.configure(config, appSessionStore, sessionRuntime, auth)
    pushRuntime.configure(config, appSessionStore, sessionRuntime, auth)
    versionRuntime.configure(config, appSessionStore)
    const restoreSession = () => sessionRuntime.restore((credential) => {
      if (credential == null) { openHome(); return }
      authRuntime.restore(credential, () => {
        completeAuthenticatedBootstrap()
      }, () => sessionRuntime.signOut(() => { openHome() }))
    })
    const continueAfterPublicConfig = () => {
      const publicConfig = appPublicConfigRuntime.get()
      if (publicConfig == null || !versionRuntime.configureUpgrade(publicConfig.appid)) { restoreSession(); return }
      const continueAfterUpgrade = () => {
        const current = appPublicConfigRuntime.get()
        if (current == null || !current.startup.onboardingEnabled || !onboardingStore.shouldShow(current.appId, current.startup.publishedVersion)) { restoreSession(); return }
        preloadOnboardingSlides(current.startup.slides, current.appId, () => { uni.reLaunch({ url: '/pages/onboarding/index' }) }, () => {
          // The onboarding publication remains incomplete. This launch fails
          // open and a later online launch retries the same version.
          restoreSession()
        })
      }
      akUpgradeCoordinator.check((outcome, _policy) => {
        if (outcome == 'config_mismatch') {
          sessionRuntime.signOut(() => { uni.reLaunch({ url: '/pages/error/offline/index?reason=app_config_mismatch' }) })
          return
        }
        continueAfterUpgrade()
      }, (_kind, _code) => {
        // Version policy availability is not an authentication prerequisite.
        // Automatic checks fail open; manual checks surface the same failure.
        continueAfterUpgrade()
      })
    }
    const configLoad = appPublicConfigRuntime.load(continueAfterPublicConfig, error => {
      if (error.code == 'app.config_mismatch') { sessionRuntime.signOut(() => { uni.reLaunch({ url: '/pages/error/offline/index?reason=app_config_mismatch' }) }); return }
      restoreSession()
    })
    if (configLoad == null) restoreSession()
  }
}

/** Login and token restoration share the same context/preferences handoff. */
export function completeAuthenticatedBootstrap(): void {
  authRuntime.refreshContext(() => {
    const preferences = preferencesRuntime.getRepository()
    if (preferences == null) { openHome(); return }
    preferences.get(value => { akI18n.setLocale(value.locale); themeStore.apply(value.appearance); pushCoordinator.initialize(value.push); recordPublishedLegalConsent(); openHome() }, () => { pushCoordinator.initialize(false); recordPublishedLegalConsent(); openHome() })
  }, () => authRuntime.signOut(() => { openHome() }))
}

function openHome(): void {
  uni.reLaunch({ url: '/pages/home/index', success: () => { themeStore.markTabBarReady() } })
}

/** Server audit is best effort after authenticated bootstrap; local consent already gated startup. */
function recordPublishedLegalConsent(): void {
  const repository = legalRuntime.getRepository()
  if (repository == null) return
  repository.publicDocument('privacy-policy', privacy => {
    repository.recordConsent(privacy, () => {}, () => {})
    repository.publicDocument('terms-of-service', terms => { repository.recordConsent(terms, () => {}, () => {}) }, () => {})
  }, () => {})
}
