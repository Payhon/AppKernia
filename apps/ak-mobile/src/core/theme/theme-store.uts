import { reactive } from 'vue'

export type Appearance = 'system' | 'light' | 'dark'

type ThemeState = { isDark: boolean }

/** Shared Vue-reactive state consumed by every ak-theme-root instance. */
export const themeState = reactive({ isDark: false } as ThemeState)

/** Owns the native App theme and mirrors the resolved dark/light value to Vue. */
export class ThemeStore {
  private appearance: Appearance = 'system'
  private listening: boolean = false

  initialize(): void {
    if (this.listening) return
    this.listening = true
    // #ifdef APP
    uni.onAppThemeChange((result: AppThemeChangeResult) => {
      themeState.isDark = result.appTheme == 'dark'
      this.applyNativeChrome()
    })
    // #endif
    this.apply(this.appearance)
  }

  apply(value: Appearance): void {
    this.appearance = value
    // #ifdef APP
    uni.setAppTheme({ theme: value == 'system' ? 'auto' : value })
    themeState.isDark = value == 'system' ? uni.getDeviceInfo().osTheme == 'dark' : value == 'dark'
    // #endif
    // #ifndef APP
    themeState.isDark = value == 'dark'
    // #endif
    this.applyNativeChrome()
  }

  isDark(): boolean { return themeState.isDark }

  private applyNativeChrome(): void {
    const dark: boolean = themeState.isDark
    uni.setNavigationBarColor({ frontColor: dark ? '#FFFFFF' : '#000000', backgroundColor: dark ? '#000000' : '#F2F2F7' })
    uni.setTabBarStyle({ color: dark ? '#8E8E93' : '#8E8E93', selectedColor: dark ? '#4D8DFF' : '#246BFE', backgroundColor: dark ? '#1C1C1E' : '#FFFFFF', borderStyle: dark ? 'black' : 'white' })
    uni.setTabBarItem({ index: 0, iconPath: '/static/ak-tabbar/home-default.png', selectedIconPath: dark ? '/static/ak-tabbar/home-selected-dark.png' : '/static/ak-tabbar/home-selected.png' })
    uni.setTabBarItem({ index: 1, iconPath: '/static/ak-tabbar/notifications-default.png', selectedIconPath: dark ? '/static/ak-tabbar/notifications-selected-dark.png' : '/static/ak-tabbar/notifications-selected.png' })
    uni.setTabBarItem({ index: 2, iconPath: '/static/ak-tabbar/profile-default.png', selectedIconPath: dark ? '/static/ak-tabbar/profile-selected-dark.png' : '/static/ak-tabbar/profile-selected.png' })
  }
}

export const themeStore = new ThemeStore()
