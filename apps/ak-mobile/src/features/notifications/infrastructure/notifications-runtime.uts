import { AkConfig } from '../../../core/config/config.uts'
import { SessionStore } from '../../../core/stores/session-store.uts'
import { SessionRuntime } from '../../../core/stores/session-runtime.uts'
import { AkHttpClient } from '../../../core/network/ak-http-client.uts'
import { RefreshCoordinator } from '../../../core/network/refresh-coordinator.uts'
import { RefreshingHttpPort } from '../../../core/network/refreshing-http-port.uts'
import { MobileAuthService } from '../../auth/mobile-auth-service.uts'
import { HttpNotificationsRepository } from './http-notifications-repository.uts'
export class NotificationsRuntime{private repo:HttpNotificationsRepository|null=null;configure(c:AkConfig,s:SessionStore,sr:SessionRuntime,a:MobileAuthService):void{this.repo=new HttpNotificationsRepository(new RefreshingHttpPort(new AkHttpClient(c,s),new RefreshCoordinator(sr,a)))}getRepository():HttpNotificationsRepository|null{return this.repo}}
export const notificationsRuntime=new NotificationsRuntime()
