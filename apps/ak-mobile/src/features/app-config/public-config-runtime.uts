import { AkError } from '../../core/errors/ak-error.uts'
import { akI18n } from '../../core/i18n/ak-i18n.uts'
import { AkHttpPort, HttpCancellation, HttpRequest } from '../../core/network/http-port.uts'
import { PublicConfigWire, PublicPushRuntimeWire, PublicShareProviderWire, PublicShareRuntimeWire, PublicStartupSlideWire } from '../../generated/api/mobile-public-config.uts'

export type AppPublicConfig = {
  readonly appId: string
  readonly appid: string
  readonly appType: string
  readonly name: string
  readonly defaultLocale: string
  readonly registrationEnabled: boolean
  readonly registrationVerificationMode: string
  readonly startup: AppPublicStartup
  readonly shareProviders: Array<AppPublicShareProvider>
  readonly pushEnabled: boolean
  readonly pushProviders: Array<string>
  readonly pushBuildVariants: Array<string>
}

export type AppPublicShareProvider = {
  readonly providerCode: string
  readonly enabled: boolean
  readonly scenes: Array<string>
  readonly fallbackMode: string
}

export type AppPublicStartupSlide = {
  position: number
  imageUrl: string
  accessibilityLabel: string
}
export type AppPublicStartup = {
  readonly displayName: string
  readonly subtitle: string
  readonly iconUrl: string | null
  readonly onboardingEnabled: boolean
  readonly publishedVersion: number
  readonly slides: Array<AppPublicStartupSlide>
}

class HttpPublicConfigRepository {
  private readonly http: AkHttpPort
  private readonly apiBaseUrl: string
  constructor(http: AkHttpPort, apiBaseUrl: string) { this.http = http; this.apiBaseUrl = apiBaseUrl }
  private assetURL(value: string | null): string | null {
    if (value == null || value.length == 0) return null
    const marker = '/api/v1'
    const index = this.apiBaseUrl.indexOf(marker)
    if (!value.startsWith('/api/v1/public/startup-assets/') || index <= 0) return null
    return this.apiBaseUrl.substring(0, index) + value
  }
  get(ok: (value: AppPublicConfig) => void, fail: (error: AkError) => void): HttpCancellation {
    const request: HttpRequest<UTSJSONObject> = { method: 'GET', path: '/public/config', query: new Map<string, string>(), headers: new Map<string, string>(), retryOnUnauthorized: false, body: {} as UTSJSONObject, locale: akI18n.getLocale() }
    return this.http.execute<UTSJSONObject, PublicConfigWire>(request, response => {
      const slides: Array<AppPublicStartupSlide> = []
      response.data.startup.slides.forEach((slide: PublicStartupSlideWire) => {
        const imageUrl = this.assetURL(slide.image_url)
        if (imageUrl != null) slides.push({ position: slide.position, imageUrl: imageUrl, accessibilityLabel: slide.accessibility_label })
      })
      const shareProviders: Array<AppPublicShareProvider> = []
      // Public config is cached and can temporarily come from a pre-share/push
      // server during rolling upgrades. Optional capabilities must fail closed
      // instead of preventing the application from starting.
      const shareRuntime: PublicShareRuntimeWire | null = response.data.share as PublicShareRuntimeWire | null
      if (shareRuntime != null) {
        const providers: Array<PublicShareProviderWire> | null = shareRuntime.providers as Array<PublicShareProviderWire> | null
        if (providers != null) providers.forEach((provider: PublicShareProviderWire) => { shareProviders.push({ providerCode: provider.provider_code, enabled: provider.enabled, scenes: provider.scenes as Array<string>, fallbackMode: provider.fallback_mode }) })
      }
      let pushEnabled: boolean = false
      let pushProviders: Array<string> = []
      let pushBuildVariants: Array<string> = []
      const pushRuntime: PublicPushRuntimeWire | null = response.data.push as PublicPushRuntimeWire | null
      if (pushRuntime != null) {
        pushEnabled = pushRuntime.enabled
        const providers: Array<string> | null = pushRuntime.providers as Array<string> | null
        const buildVariants: Array<string> | null = pushRuntime.build_variants as Array<string> | null
        if (providers != null) pushProviders = providers
        if (buildVariants != null) pushBuildVariants = buildVariants
      }
      ok({ appId: response.data.app_id, appid: response.data.appid, appType: response.data.app_type, name: response.data.name, defaultLocale: response.data.default_locale, registrationEnabled: response.data.registration_enabled, registrationVerificationMode: response.data.registration_verification_mode, shareProviders: shareProviders, pushEnabled: pushEnabled, pushProviders: pushProviders, pushBuildVariants: pushBuildVariants, startup: { displayName: response.data.startup.display_name, subtitle: response.data.startup.subtitle, iconUrl: this.assetURL(response.data.startup.icon_url), onboardingEnabled: response.data.startup.onboarding_enabled, publishedVersion: response.data.startup.published_version, slides: slides } })
    }, fail)
  }
}

export class AppPublicConfigRuntime {
  private repository: HttpPublicConfigRepository | null = null
  private current: AppPublicConfig | null = null
  private expectedAppId: string = ''
  configure(http: AkHttpPort, expectedAppId: string, apiBaseUrl: string): void { this.repository = new HttpPublicConfigRepository(http, apiBaseUrl); this.expectedAppId = expectedAppId }
  load(ok: () => void, fail: (error: AkError) => void): HttpCancellation | null {
    if (this.repository == null) return null
    return this.repository.get(value => {
      if (value.appId.toLowerCase() != this.expectedAppId) { fail(new AkError('forbidden', 'app.config_mismatch', 'errors.auth.appMismatch', null)); return }
      this.current = value
      ok()
    }, fail)
  }
  get(): AppPublicConfig | null { return this.current }
  registrationEnabled(): boolean { return this.current != null && this.current.registrationEnabled }
  pushEnabled(provider: string, buildVariant: string): boolean { return this.current != null && this.current.pushEnabled && this.current.pushProviders.indexOf(provider) >= 0 && this.current.pushBuildVariants.indexOf(buildVariant) >= 0 }
  shareEnabled(providerCode: string, scene: string): boolean {
    if (this.current == null) return false
    const normalized = scene === 'WXSceneSession' ? 'session' : scene === 'WXSceneTimeline' ? 'timeline' : scene === 'WXSceneFavorite' ? 'favorite' : ''
    for (let index = 0; index < this.current.shareProviders.length; index++) {
      const provider = this.current.shareProviders[index]
      if (provider.providerCode === providerCode && provider.enabled && provider.scenes.indexOf(normalized) >= 0) return true
    }
    return false
  }
}

export const appPublicConfigRuntime = new AppPublicConfigRuntime()
