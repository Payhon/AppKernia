import { AkHttpPort, HttpCancellation, HttpRequest } from '../../../core/network/http-port.uts'
import { akI18n } from '../../../core/i18n/ak-i18n.uts'
import { AkError } from '../../../core/errors/ak-error.uts'
import { ArticleCategory, ArticleDetail, ArticlePage, ArticleQuery, ArticleSummary } from '../domain/models.uts'
import { ArticleRepository } from '../application/article-repository.uts'

type ArticleCategoryWire = { readonly id: string; readonly slug: string; readonly name: string }
type ArticleApiItem = {
  readonly id: string
  readonly slug: string
  readonly featured: boolean
  readonly published_at: string
  readonly cover_url: string | null
  readonly title: string
  readonly summary: string
  readonly body_format: string | null
  readonly body: string | Array<UTSJSONObject> | null
  readonly category: ArticleCategoryWire | null
  readonly bookmarked: boolean
  readonly reading_minutes: number
}

type ArticleListData = { readonly items: Array<ArticleApiItem> }

type ArticleCategoryApiItem = {
  readonly id: string
  readonly slug: string
  readonly sort_order: number
  readonly name: string
  readonly description: string
}

type ArticleCategoryListData = { readonly items: Array<ArticleCategoryApiItem> }

type ArticleDetailEnvelope = { readonly id: string; readonly slug: string; readonly featured: boolean; readonly published_at: string; readonly cover_url: string | null; readonly title: string; readonly summary: string; readonly body_format: string | null; readonly body: string | Array<UTSJSONObject> | null; readonly category: ArticleCategoryWire | null; readonly bookmarked: boolean; readonly reading_minutes: number }

export class HttpArticleRepository implements ArticleRepository {
  private readonly http: AkHttpPort

  constructor(http: AkHttpPort) { this.http = http }

  list(query: ArticleQuery, onSuccess: (page: ArticlePage) => void, onFailure: (error: AkError) => void): HttpCancellation {
    const parameters = new Map<string, string>()
    if (query.query != null && query.query.length > 0) parameters.set('q', query.query)
    if (query.category != null && query.category.length > 0) parameters.set('category', query.category)
    if (query.featured != null) parameters.set('featured', query.featured ? 'true' : 'false')
    if (query.cursor != null) parameters.set('cursor', query.cursor)
    parameters.set('limit', query.limit.toString())
    const request: HttpRequest<UTSJSONObject> = { method: 'GET', path: '/articles', query: parameters, headers: new Map<string, string>(), retryOnUnauthorized: true, body: {} as UTSJSONObject, locale: akI18n.getLocale() }
    return this.http.execute<UTSJSONObject, ArticleListData>(request, (response) => {
      const nextCursor: string | null = response.meta != null ? response.meta.nextCursor : null
      const page: ArticlePage = { items: response.data.items.map((item: ArticleApiItem) => this.mapSummary(item)), nextCursor: nextCursor }
      onSuccess(page)
    }, onFailure)
  }

  listCategories(onSuccess: (categories: Array<ArticleCategory>) => void, onFailure: (error: AkError) => void): HttpCancellation {
    const request: HttpRequest<UTSJSONObject> = { method: 'GET', path: '/article-categories', query: new Map<string, string>(), headers: new Map<string, string>(), retryOnUnauthorized: true, body: {} as UTSJSONObject, locale: akI18n.getLocale() }
    return this.http.execute<UTSJSONObject, ArticleCategoryListData>(request, (response) => {
      const categories: Array<ArticleCategory> = response.data.items.map((item: ArticleCategoryApiItem) => this.mapCategory(item))
      onSuccess(categories)
    }, onFailure)
  }

  detail(slug: string, onSuccess: (article: ArticleDetail) => void, onFailure: (error: AkError) => void): HttpCancellation {
    const request: HttpRequest<UTSJSONObject> = { method: 'GET', path: '/articles/' + encodeURIComponent(slug), query: new Map<string, string>(), headers: new Map<string, string>(), retryOnUnauthorized: true, body: {} as UTSJSONObject, locale: akI18n.getLocale() }
    return this.http.execute<UTSJSONObject, ArticleDetailEnvelope>(request, (response) => {
      const item = response.data
      const bodyFormat: 'markdown' | 'blocks' = item.body_format == 'blocks' ? 'blocks' : 'markdown'
      const body: string = this.bodyText(item.body, bodyFormat)
      const category: ArticleCategoryWire | null = item.category
      const detail: ArticleDetail = { id: item.id, slug: item.slug, featured: item.featured, publishedAt: item.published_at, coverUrl: item.cover_url, title: item.title, summary: item.summary, categorySlug: category != null ? category.slug : '', categoryName: category != null ? category.name : '', bookmarked: item.bookmarked, readingMinutes: item.reading_minutes, bodyFormat: bodyFormat, body: body }
      onSuccess(detail)
    }, onFailure)
  }

  setBookmark(articleId: string, bookmarked: boolean, onSuccess: () => void, onFailure: (error: AkError) => void): HttpCancellation {
    const request: HttpRequest<UTSJSONObject> = { method: bookmarked ? 'PUT' : 'DELETE', path: '/me/article-bookmarks/' + encodeURIComponent(articleId), query: new Map<string, string>(), headers: new Map<string, string>(), retryOnUnauthorized: false, body: {} as UTSJSONObject, locale: akI18n.getLocale() }
    return this.http.execute<UTSJSONObject, ArticleBookmarkData>(request, () => onSuccess(), onFailure)
  }

  private mapSummary(item: ArticleApiItem): ArticleSummary {
    const category: ArticleCategoryWire | null = item.category
    return { id: item.id, slug: item.slug, featured: item.featured, publishedAt: item.published_at, coverUrl: item.cover_url, title: item.title, summary: item.summary, categorySlug: category != null ? category.slug : '', categoryName: category != null ? category.name : '', bookmarked: item.bookmarked, readingMinutes: item.reading_minutes }
  }
  private mapCategory(item: ArticleCategoryApiItem): ArticleCategory { return { id: item.id, slug: item.slug, sortOrder: item.sort_order, name: item.name, description: item.description } }
  private bodyText(value: string | Array<UTSJSONObject> | null, format: 'markdown' | 'blocks'): string { if (value == null) return ''; return format == 'blocks' ? JSON.stringify(value as Array<UTSJSONObject>) : value as string }
}

type ArticleBookmarkData = { readonly bookmarked: boolean }
