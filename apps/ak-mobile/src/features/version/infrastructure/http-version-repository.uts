import { AkError } from '../../../core/errors/ak-error.uts'
import { akI18n } from '../../../core/i18n/ak-i18n.uts'
import { AkHttpPort, HttpCancellation, HttpRequest } from '../../../core/network/http-port.uts'
export type VersionPolicy={readonly current:string;readonly minimum:string;readonly notes:string;readonly upgradeUrl:string|null}
type Wire={readonly current_version:string;readonly minimum_version:string;readonly release_notes:string;readonly upgrade_url:string|null}
export class HttpVersionRepository{private h:AkHttpPort;constructor(h:AkHttpPort){this.h=h}get(platform:string,ok:(v:VersionPolicy)=>void,fail:(e:AkError)=>void):HttpCancellation{const q=new Map<string,string>();q.set('platform',platform);const r:HttpRequest<UTSJSONObject>={method:'GET',path:'/public/app-version',query:q,headers:new Map<string,string>(),retryOnUnauthorized:false,body:{} as UTSJSONObject,locale:akI18n.getLocale()};return this.h.execute<UTSJSONObject,Wire>(r,x=>ok(this.value(x.data)),fail)}private value(x:Wire):VersionPolicy{return{current:x.current_version,minimum:x.minimum_version,notes:x.release_notes,upgradeUrl:x.upgrade_url}}}
