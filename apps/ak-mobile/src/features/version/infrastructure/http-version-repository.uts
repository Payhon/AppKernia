import { akI18n } from '../../../core/i18n/ak-i18n.uts'
import { AkHttpPort, HttpRequest } from '../../../core/network/http-port.uts'
import { MobileAppVersionWire } from '../../../generated/api/mobile-app-version.uts'
import { UpgradePolicy, UpgradePolicyProvider, UpgradeStore } from '../../../../uni_modules/ak-upgrade/model.uts'

export type VersionPolicy = UpgradePolicy

export class HttpVersionRepository implements UpgradePolicyProvider {
  private readonly http: AkHttpPort
  constructor(http: AkHttpPort) { this.http = http }
  get(platform: string, onSuccess: (value: VersionPolicy) => void, onFailure: (kind: string, code: string) => void): void {
    const query = new Map<string, string>()
    query.set('platform', platform)
    query.set('package_type', 'native_app')
    const request: HttpRequest<UTSJSONObject> = { method: 'GET', path: '/public/app-version', query, headers: new Map<string, string>(), retryOnUnauthorized: false, body: {} as UTSJSONObject, locale: akI18n.getLocale() }
    this.http.execute<UTSJSONObject, MobileAppVersionWire>(request, response => onSuccess(this.value(response.data)), error => onFailure(error.kind, error.code))
  }
  private value(wire: MobileAppVersionWire): VersionPolicy {
    const stores: Array<UpgradeStore> = []
    for (let index = 0; index < wire.store_list.length; index++) {
      const store = wire.store_list[index]
      stores.push({ id: store.id, name: store.name, scheme: store.scheme, priority: store.priority })
    }
    return { platform: wire.platform, packageType: wire.package_type, deliveryMode: wire.delivery_mode, current: wire.current_version, minimum: wire.minimum_version, title: wire.title, notes: wire.release_notes, upgradeUrl: wire.upgrade_url, storeList: stores, silently: wire.is_silently, mandatory: wire.is_mandatory, publishedAt: wire.published_at }
  }
}
