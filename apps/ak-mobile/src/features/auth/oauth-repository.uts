import { AkError } from '../../core/errors/ak-error.uts'
import { akI18n } from '../../core/i18n/ak-i18n.uts'
import { AkHttpPort, HttpCancellation, HttpRequest } from '../../core/network/http-port.uts'
import {
  MobileLoginProviderListWire as OAuthProvidersWire,
  MobileLoginProviderWire as OAuthProviderWire,
  MobileOAuthAccountListWire as OAuthAccountsWire,
  MobileOAuthAccountWire as OAuthAccountWire,
  MobileOAuthAppleCallbackWire as OAuthAppleCallbackWire,
  MobileOAuthAppleProfileCallbackWire as OAuthAppleProfileCallbackWire,
  MobileOAuthAuthorizeBindWire as OAuthAuthorizeBindWire,
  MobileOAuthAuthorizeWire as OAuthAuthorizeWire,
  MobileOAuthCallbackWire as OAuthCallbackWire,
  MobileOAuthCodeCallbackWire as OAuthCodeCallbackWire,
  MobileOAuthFlowWire as OAuthFlowWire,
  MobileOAuthIDTokenCallbackWire as OAuthIDTokenCallbackWire,
  MobileOAuthReauthorizeWire as OAuthReauthorizeWire,
  MobileOAuthTicketCallbackWire as OAuthTicketCallbackWire,
  MobileStepUpTokenWire as OAuthUnbindWire,
  MobileUnboundWire as OAuthUnboundWire,
} from '../../generated/api/mobile-identity.uts'
import { MobileAuthToken } from './auth-repository.uts'
import { OAuthAccount, OAuthAuthorizationFlow, OAuthAuthorizationKind, OAuthBuildConfig, OAuthBuildVariant, OAuthCallbackResult, OAuthMode, OAuthPlatform, OAuthProviderCode, OAuthProviderDescriptor, OAuthReauthPurpose } from './oauth-models.uts'
import { isOAuthProviderCode } from './oauth-provider-registry.uts'

export class HttpOAuthRepository {
  private readonly http: AkHttpPort
  private readonly expectedAppId: string

  constructor(http: AkHttpPort, expectedAppId: string) { this.http = http; this.expectedAppId = expectedAppId }

  providers(platform: OAuthPlatform, buildVariant: OAuthBuildVariant, onSuccess: (items: Array<OAuthProviderDescriptor>) => void, onFailure: (error: AkError) => void): HttpCancellation {
    const query = new Map<string, string>()
    query.set('platform', platform)
    query.set('build_variant', buildVariant)
    const request: HttpRequest<UTSJSONObject> = { method: 'GET', path: '/auth/oauth/providers', query: query, headers: new Map<string, string>(), retryOnUnauthorized: false, body: {} as UTSJSONObject, locale: akI18n.getLocale() }
    return this.http.execute<UTSJSONObject, OAuthProvidersWire>(request, response => {
      const items: Array<OAuthProviderDescriptor> = []
      response.data.items.forEach((item: OAuthProviderWire) => {
        const mapped = this.provider(item)
        if (mapped != null) items.push(mapped)
      })
      onSuccess(items)
    }, onFailure)
  }

  authorize(provider: OAuthProviderCode, mode: OAuthMode, platform: OAuthPlatform, buildVariant: OAuthBuildVariant, buildConfigHash: string, stepUpToken: string, reauthPurpose: OAuthReauthPurpose | null, accountId: string, onSuccess: (flow: OAuthAuthorizationFlow) => void, onFailure: (error: AkError) => void): HttpCancellation {
    if (mode == 'reauth' && reauthPurpose != null && accountId.length > 0) {
      const body: OAuthReauthorizeWire = { mode: mode, platform: platform, build_variant: buildVariant, build_config_hash: buildConfigHash, reauth_purpose: reauthPurpose!, account_id: accountId }
      return this.executeAuthorize<OAuthReauthorizeWire>(provider, body, onSuccess, onFailure)
    }
    if (mode == 'bind' && stepUpToken.length > 0) {
      const body: OAuthAuthorizeBindWire = { mode: mode, platform: platform, build_variant: buildVariant, build_config_hash: buildConfigHash, step_up_token: stepUpToken }
      return this.executeAuthorize<OAuthAuthorizeBindWire>(provider, body, onSuccess, onFailure)
    }
    const body: OAuthAuthorizeWire = { mode: mode, platform: platform, build_variant: buildVariant, build_config_hash: buildConfigHash }
    return this.executeAuthorize<OAuthAuthorizeWire>(provider, body, onSuccess, onFailure)
  }

  private executeAuthorize<T>(provider: OAuthProviderCode, body: T, onSuccess: (flow: OAuthAuthorizationFlow) => void, onFailure: (error: AkError) => void): HttpCancellation {
    const request: HttpRequest<T> = { method: 'POST', path: '/auth/oauth/' + provider + '/authorize', query: new Map<string, string>(), headers: new Map<string, string>(), retryOnUnauthorized: false, body: body, locale: akI18n.getLocale() }
    return this.http.execute<T, OAuthFlowWire>(request, response => {
      const flow = this.flow(response.data)
      if (flow == null) { onFailure(this.invalidResponse()); return }
      onSuccess(flow)
    }, onFailure)
  }

  callbackCode(provider: OAuthProviderCode, flowId: string, state: string, authorizationCode: string, onSuccess: (result: OAuthCallbackResult) => void, onFailure: (error: AkError) => void): HttpCancellation {
    const body: OAuthCodeCallbackWire = { flow_id: flowId, state: state, authorization_code: authorizationCode }
    const request: HttpRequest<OAuthCodeCallbackWire> = { method: 'POST', path: '/auth/oauth/' + provider + '/callback', query: new Map<string, string>(), headers: new Map<string, string>(), retryOnUnauthorized: false, body: body, locale: akI18n.getLocale() }
    return this.http.execute<OAuthCodeCallbackWire, OAuthCallbackWire>(request, response => this.acceptCallback(response.data, onSuccess, onFailure), onFailure)
  }

  callbackIDToken(provider: OAuthProviderCode, flowId: string, state: string, idToken: string, onSuccess: (result: OAuthCallbackResult) => void, onFailure: (error: AkError) => void): HttpCancellation {
    const body: OAuthIDTokenCallbackWire = { flow_id: flowId, state: state, id_token: idToken }
    const request: HttpRequest<OAuthIDTokenCallbackWire> = { method: 'POST', path: '/auth/oauth/' + provider + '/callback', query: new Map<string, string>(), headers: new Map<string, string>(), retryOnUnauthorized: false, body: body, locale: akI18n.getLocale() }
    return this.http.execute<OAuthIDTokenCallbackWire, OAuthCallbackWire>(request, response => this.acceptCallback(response.data, onSuccess, onFailure), onFailure)
  }

  callbackApple(flowId: string, state: string, idToken: string, authorizationCode: string, displayName: string, onSuccess: (result: OAuthCallbackResult) => void, onFailure: (error: AkError) => void): HttpCancellation {
    if (displayName.length > 0) {
      const body: OAuthAppleProfileCallbackWire = { flow_id: flowId, state: state, id_token: idToken, authorization_code: authorizationCode, display_name: displayName }
      const request: HttpRequest<OAuthAppleProfileCallbackWire> = { method: 'POST', path: '/auth/oauth/apple/callback', query: new Map<string, string>(), headers: new Map<string, string>(), retryOnUnauthorized: false, body: body, locale: akI18n.getLocale() }
      return this.http.execute<OAuthAppleProfileCallbackWire, OAuthCallbackWire>(request, response => this.acceptCallback(response.data, onSuccess, onFailure), onFailure)
    }
    const body: OAuthAppleCallbackWire = { flow_id: flowId, state: state, id_token: idToken, authorization_code: authorizationCode }
    const request: HttpRequest<OAuthAppleCallbackWire> = { method: 'POST', path: '/auth/oauth/apple/callback', query: new Map<string, string>(), headers: new Map<string, string>(), retryOnUnauthorized: false, body: body, locale: akI18n.getLocale() }
    return this.http.execute<OAuthAppleCallbackWire, OAuthCallbackWire>(request, response => this.acceptCallback(response.data, onSuccess, onFailure), onFailure)
  }

  callbackTicket(provider: OAuthProviderCode, flowId: string, ticket: string, onSuccess: (result: OAuthCallbackResult) => void, onFailure: (error: AkError) => void): HttpCancellation {
    const body: OAuthTicketCallbackWire = { flow_id: flowId, one_time_ticket: ticket }
    const request: HttpRequest<OAuthTicketCallbackWire> = { method: 'POST', path: '/auth/oauth/' + provider + '/callback', query: new Map<string, string>(), headers: new Map<string, string>(), retryOnUnauthorized: false, body: body, locale: akI18n.getLocale() }
    return this.http.execute<OAuthTicketCallbackWire, OAuthCallbackWire>(request, response => this.acceptCallback(response.data, onSuccess, onFailure), onFailure)
  }

  accounts(onSuccess: (items: Array<OAuthAccount>) => void, onFailure: (error: AkError) => void): HttpCancellation {
    const request: HttpRequest<UTSJSONObject> = { method: 'GET', path: '/me/oauth-accounts', query: new Map<string, string>(), headers: new Map<string, string>(), retryOnUnauthorized: false, body: {} as UTSJSONObject, locale: akI18n.getLocale() }
    return this.http.execute<UTSJSONObject, OAuthAccountsWire>(request, response => {
      const items: Array<OAuthAccount> = []
      response.data.items.forEach((wire: OAuthAccountWire) => { const value = this.account(wire); if (value != null) items.push(value) })
      onSuccess(items)
    }, onFailure)
  }

  unbind(accountId: string, stepUpToken: string, onSuccess: () => void, onFailure: (error: AkError) => void): HttpCancellation {
    const body: OAuthUnbindWire = { step_up_token: stepUpToken }
    const request: HttpRequest<OAuthUnbindWire> = { method: 'DELETE', path: '/me/oauth-accounts/' + encodeURIComponent(accountId), query: new Map<string, string>(), headers: new Map<string, string>(), retryOnUnauthorized: false, body: body, locale: akI18n.getLocale() }
    return this.http.execute<OAuthUnbindWire, OAuthUnboundWire>(request, response => { if (response.data.unbound) onSuccess(); else onFailure(this.invalidResponse()) }, onFailure)
  }

  private provider(wire: OAuthProviderWire): OAuthProviderDescriptor | null {
    if (!isOAuthProviderCode(wire.provider_code)) return null
    if (wire.authorization_kind != 'native_code' && wire.authorization_kind != 'native_id_token' && wire.authorization_kind != 'browser_ticket') return null
    const config = wire.build_config
    const buildConfig = new OAuthBuildConfig(
      config.app_id == null ? '' : config.app_id!,
      config.client_id == null ? '' : config.client_id!,
      config.callback_uri == null ? '' : config.callback_uri!,
      config.app_return_uri == null ? '' : config.app_return_uri!,
      config.server_client_id == null ? '' : config.server_client_id!,
      config.android_package_name == null ? '' : config.android_package_name!,
      config.android_app_signature == null ? '' : config.android_app_signature!,
      config.android_certificate_sha256 == null ? [] : config.android_certificate_sha256!,
      config.ios_bundle_id == null ? '' : config.ios_bundle_id!,
      config.ios_universal_link == null ? '' : config.ios_universal_link!,
      config.harmony_bundle_name == null ? '' : config.harmony_bundle_name!,
    )
    return new OAuthProviderDescriptor(wire.provider_code as OAuthProviderCode, wire.display_name_key, wire.icon_key, wire.authorization_kind as OAuthAuthorizationKind, wire.supported_platforms, wire.build_variants, wire.login_enabled, wire.binding_enabled, wire.sort_order, wire.config_schema_version, wire.build_config_hash, buildConfig)
  }

  private flow(wire: OAuthFlowWire): OAuthAuthorizationFlow | null {
    if (!isOAuthProviderCode(wire.provider_code)) return null
    if (wire.mode != 'login' && wire.mode != 'bind' && wire.mode != 'reauth') return null
    if (wire.authorization_kind != 'native_code' && wire.authorization_kind != 'native_id_token' && wire.authorization_kind != 'browser_ticket') return null
    return new OAuthAuthorizationFlow(wire.flow_id, wire.provider_code as OAuthProviderCode, wire.mode as OAuthMode, wire.authorization_kind as OAuthAuthorizationKind, wire.authorization_url == null ? '' : wire.authorization_url!, wire.state, wire.nonce == null ? '' : wire.nonce!, wire.expires_at)
  }

  private account(wire: OAuthAccountWire): OAuthAccount | null {
    if (wire.provider_code.length == 0) return null
    return new OAuthAccount(wire.id, wire.provider_code, wire.display_name_key, wire.provider_username_hint == null ? '' : wire.provider_username_hint!, wire.status, wire.login_enabled, wire.login_capable, wire.can_bind, wire.can_change, wire.bound_at, wire.last_authenticated_at == null ? '' : wire.last_authenticated_at!, wire.can_unbind, wire.block_reason == null ? '' : wire.block_reason!)
  }

  private acceptCallback(wire: OAuthCallbackWire, onSuccess: (result: OAuthCallbackResult) => void, onFailure: (error: AkError) => void): void {
    if (wire.mode != 'login' && wire.mode != 'bind' && wire.mode != 'reauth') { onFailure(this.invalidResponse()); return }
    let session: MobileAuthToken | null = null
    if (wire.session != null) {
      if (wire.session!.app_id.toLowerCase() != this.expectedAppId.toLowerCase()) { onFailure(new AkError('unauthorized', 'auth.app_mismatch', 'errors.auth.appMismatch', null)); return }
      session = { accessToken: wire.session!.access_token, refreshToken: wire.session!.refresh_token, sessionId: wire.session!.session_id, appId: wire.session!.app_id }
    }
    let account: OAuthAccount | null = null
    if (wire.oauth_account != null) {
      account = this.account(wire.oauth_account!)
      if (account == null) { onFailure(this.invalidResponse()); return }
    }
    onSuccess(new OAuthCallbackResult(wire.mode as OAuthMode, session, account, wire.step_up_token == null ? '' : wire.step_up_token!, wire.step_up_expires_at == null ? '' : wire.step_up_expires_at!))
  }

  private invalidResponse(): AkError { return new AkError('unknown', 'response.invalid_oauth', 'errors.unknown', null) }
}
