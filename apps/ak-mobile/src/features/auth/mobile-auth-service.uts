import { AkError } from '../../core/errors/ak-error.uts'
import { HttpCancellation } from '../../core/network/http-port.uts'
import { SessionRuntime } from '../../core/stores/session-runtime.uts'
import { SessionCredential } from '../../core/stores/secure-session-storage-port.uts'
import { AcceptedResult, HttpAuthRepository, MobileAuthContext, MobileAuthToken, OTPChallenge, OTPIdentifierType, OTPLoginInput, OTPPasswordResetInput, OTPRegistrationInput, PasswordLoginInput, RegisterInput, VerificationInput } from './auth-repository.uts'
import { AkInteractiveCaptchaSubmission } from '../../../uni_modules/ak-interactive-captcha/model.uts'

/** Coordinates token rotation with atomic secure-storage replacement. */
export class MobileAuthService {
  private readonly repository: HttpAuthRepository
  private readonly sessions: SessionRuntime
  private deviceKey: string = ''

  constructor(repository: HttpAuthRepository, sessions: SessionRuntime) { this.repository = repository; this.sessions = sessions }

  setDeviceKey(value: string): void { this.deviceKey = value }

  login(input: PasswordLoginInput, onSuccess: () => void, onFailure: (error: AkError) => void): HttpCancellation {
    return this.repository.login(input, (token: MobileAuthToken) => this.persist(token, onSuccess, onFailure), onFailure)
  }

  sendEmailOTP(email: string, onSuccess: (challenge: OTPChallenge) => void, onFailure: (error: AkError) => void): HttpCancellation { return this.repository.sendEmailOTP(email, onSuccess, onFailure) }
  sendMobileOTP(mobile: string, captcha: AkInteractiveCaptchaSubmission, onSuccess: (challenge: OTPChallenge) => void, onFailure: (error: AkError) => void): HttpCancellation { return this.repository.sendMobileOTP(mobile, captcha, onSuccess, onFailure) }
  loginOTP(input: OTPLoginInput, onSuccess: () => void, onFailure: (error: AkError) => void): HttpCancellation { return this.repository.loginOTP(input, token => this.persist(token, onSuccess, onFailure), onFailure) }
  sendRegistrationOTP(identifierType: OTPIdentifierType, identifier: string, captcha: AkInteractiveCaptchaSubmission | null, onSuccess: (challenge: OTPChallenge) => void, onFailure: (error: AkError) => void): HttpCancellation { return this.repository.sendRegistrationOTP(identifierType, identifier, captcha, onSuccess, onFailure) }
  registerOTP(input: OTPRegistrationInput, onSuccess: () => void, onFailure: (error: AkError) => void): HttpCancellation { return this.repository.registerOTP(input, token => this.persist(token, onSuccess, onFailure), onFailure) }

  register(input: RegisterInput, onSuccess: (result: AcceptedResult) => void, onFailure: (error: AkError) => void): HttpCancellation { return this.repository.register(input, onSuccess, onFailure) }
  verifyRegistration(input: VerificationInput, onSuccess: () => void, onFailure: (error: AkError) => void): HttpCancellation { return this.repository.verifyRegistration(input, onSuccess, onFailure) }
  resendRegistration(email: string, onSuccess: (result: AcceptedResult) => void, onFailure: (error: AkError) => void): HttpCancellation { return this.repository.resendRegistration({ email: email }, onSuccess, onFailure) }
  forgotPassword(identifierType: OTPIdentifierType, identifier: string, captcha: AkInteractiveCaptchaSubmission | null, onSuccess: (challenge: OTPChallenge) => void, onFailure: (error: AkError) => void): HttpCancellation { return this.repository.forgotPassword(identifierType, identifier, captcha, onSuccess, onFailure) }
  resetPassword(input: OTPPasswordResetInput, onSuccess: () => void, onFailure: (error: AkError) => void): HttpCancellation { return this.repository.resetPassword(input, onSuccess, onFailure) }

  refresh(refreshToken: string, onSuccess: () => void, onFailure: (error: AkError) => void): HttpCancellation {
    return this.repository.refresh(refreshToken, (token: MobileAuthToken) => this.persist(token, onSuccess, onFailure), onFailure)
  }

  /** OAuth and OTP repositories may establish the same App-scoped token shape. */
  establish(token: MobileAuthToken, onSuccess: () => void, onFailure: (error: AkError) => void): void { this.persist(token, onSuccess, onFailure) }

  loadContext(onSuccess: (context: MobileAuthContext) => void, onFailure: (error: AkError) => void): HttpCancellation { return this.repository.loadContext(onSuccess, onFailure) }

  /** Always removes the local credential, including when the remote revoke cannot be reached. */
  signOut(onComplete: () => void): HttpCancellation {
    return this.repository.logout(() => this.sessions.signOut(onComplete), () => this.sessions.signOut(onComplete))
  }

  private persist(token: MobileAuthToken, onSuccess: () => void, onFailure: (error: AkError) => void): void {
    if (this.deviceKey.length == 0) {
      onFailure(new AkError('unknown', 'auth.device_key_missing', 'errors.auth.unauthorized', null))
      return
    }
    const credential: SessionCredential = {
      accessToken: token.accessToken,
      refreshToken: token.refreshToken,
      deviceKey: this.deviceKey,
      sessionId: token.sessionId,
      subjectVersion: token.sessionId,
    }
    this.sessions.establish(credential, onSuccess, () => {
      onFailure(new AkError('unknown', 'auth.secure_storage_failed', 'errors.auth.unauthorized', null))
    })
  }
}
