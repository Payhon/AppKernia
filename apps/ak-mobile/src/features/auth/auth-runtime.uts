import { AkHttpClient } from '../../core/network/ak-http-client.uts'
import { SessionRuntime } from '../../core/stores/session-runtime.uts'
import { PersistedSessionCredential } from '../../core/stores/secure-session-storage-port.uts'
import { MobileAuthService } from './mobile-auth-service.uts'
import { HttpAuthRepository } from './auth-repository.uts'
import { authContextStore } from '../../core/stores/auth-context-store.uts'
import { oauthCoordinator } from './oauth-coordinator.uts'
import { HttpOAuthRepository } from './oauth-repository.uts'
import { AkSecureInstallationStorage } from '../../core/stores/ak-secure-installation-storage.uts'
import { SecureInstallationStoragePort } from '../../core/stores/secure-installation-storage-port.uts'

export class AuthRuntime {
  private service: MobileAuthService | null = null
  private client: AkHttpClient | null = null
  private sessions: SessionRuntime | null = null
  private deviceKey: string = ''
  private readonly installationStorage: SecureInstallationStoragePort = new AkSecureInstallationStorage()

  private randomHex(length: number): string {
    const alphabet: string = '0123456789abcdef'
    let value: string = ''
    for (let index: number = 0; index < length; index += 1) {
      const offset: number = Math.floor(Math.random() * alphabet.length)
      value += alphabet.substring(offset, offset + 1)
    }
    return value
  }

  private createDeviceKey(): string {
    const variants: string = '89ab'
    const variantOffset: number = Math.floor(Math.random() * variants.length)
    const variant: string = variants.substring(variantOffset, variantOffset + 1)
    return this.randomHex(8) + '-' + this.randomHex(4) + '-4' + this.randomHex(3) + '-' + variant + this.randomHex(3) + '-' + this.randomHex(12)
  }

  private isDeviceKey(value: string): boolean {
    return /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(value)
  }

  private applyDeviceKey(value: string): void {
    this.deviceKey = value
    const activeClient = this.client
    if (activeClient != null) activeClient.setDeviceKey(value)
    const activeService = this.service
    if (activeService != null) activeService.setDeviceKey(value)
  }

  configure(client: AkHttpClient, sessions: SessionRuntime, onReady: () => void, onFailure: () => void): void {
    this.client = client
    this.sessions = sessions
    this.service = new MobileAuthService(new HttpAuthRepository(client, client.getAppId()), sessions)
    this.installationStorage.readDeviceKey(value => {
      if (value != null && this.isDeviceKey(value!)) { this.finishConfigure(value!, onReady); return }
      this.migrateSessionDeviceKeyOrCreate(onReady, onFailure)
    }, onFailure)
  }

  private finishConfigure(value: string, onReady: () => void): void {
    this.applyDeviceKey(value)
    oauthCoordinator.configure(new HttpOAuthRepository(this.client!, this.client!.getAppId()), this.service!, this.client!.getAppId())
    onReady()
  }

  private persistNewDeviceKey(onReady: () => void, onFailure: () => void): void {
    const value = this.createDeviceKey()
    this.installationStorage.writeDeviceKey(value, () => this.finishConfigure(value, onReady), onFailure)
  }

  /** One-time upgrade path for releases that stored the installation key only inside the session tuple. */
  private migrateSessionDeviceKeyOrCreate(onReady: () => void, onFailure: () => void): void {
    const activeSessions = this.sessions
    if (activeSessions == null) { onFailure(); return }
    activeSessions.readCredential(credential => {
      if (credential == null || !this.isDeviceKey(credential.deviceKey)) { this.persistNewDeviceKey(onReady, onFailure); return }
      this.installationStorage.writeDeviceKey(credential.deviceKey, () => this.finishConfigure(credential.deviceKey, onReady), onFailure)
    })
  }

  getService(): MobileAuthService | null { return this.service }
  getDeviceKey(): string { return this.deviceKey }
  restore(credential: PersistedSessionCredential, onSuccess: () => void, onFailure: () => void): void {
    if (this.service == null || !this.isDeviceKey(credential.deviceKey) || credential.deviceKey != this.deviceKey) { authContextStore.clear(); onFailure(); return }
    this.service.refresh(credential.refreshToken, onSuccess, () => { authContextStore.clear(); onFailure() })
  }
  refreshContext(onSuccess: () => void, onFailure: () => void): void {
    if (this.service == null) { onFailure(); return }
    this.service.loadContext(context => { authContextStore.set(context.permissions, context.enabledFlags); onSuccess() }, () => { onFailure() })
  }
  signOut(onComplete: () => void): void {
    authContextStore.clear()
    if (this.service == null) { onComplete(); return }
    this.service.signOut(onComplete)
  }
  clearDeletedAccount(onComplete: () => void): void {
    authContextStore.clear()
    const activeSessions = this.sessions
    if (activeSessions == null) { onComplete(); return }
    const replacement = this.createDeviceKey()
    this.installationStorage.writeDeviceKey(replacement, () => {
      this.applyDeviceKey(replacement)
      activeSessions.signOut(onComplete)
    }, () => activeSessions.signOut(onComplete))
  }
}

export const authRuntime = new AuthRuntime()
