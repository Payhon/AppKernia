import { AkError } from '../../core/errors/ak-error.uts'
import { akI18n } from '../../core/i18n/ak-i18n.uts'
import { AkHttpPort, HttpCancellation, HttpRequest } from '../../core/network/http-port.uts'
import { ArticleBodyFormat } from '../articles/domain/models.uts'

export type LegalDocument = { readonly slug: string; readonly documentType: string; readonly title: string; readonly body: string; readonly bodyFormat: ArticleBodyFormat; readonly version: string; readonly contentHash: string; readonly locale: string; readonly revisionId: string }
type LegalBlockWire = { readonly type: string; readonly text: string }
type LegalWire = { readonly slug: string; readonly document_type: string; readonly title: string; readonly body: string | Array<LegalBlockWire>; readonly body_format: string; readonly version: number; readonly content_hash: string; readonly locale: string; readonly revision_id: string }
type ConsentWire = { readonly document_type: string; readonly revision_id: string; readonly content_hash: string; readonly locale: string }

export class HttpLegalRepository {
  private readonly http: AkHttpPort
  constructor(http: AkHttpPort) { this.http = http }
  publicDocument(documentType: string, ok: (value: LegalDocument) => void, fail: (error: AkError) => void): HttpCancellation {
    const request: HttpRequest<UTSJSONObject> = { method: 'GET', path: '/public/legal/' + encodeURIComponent(documentType), query: new Map<string, string>(), headers: new Map<string, string>(), retryOnUnauthorized: false, body: {} as UTSJSONObject, locale: akI18n.getLocale() }
    return this.http.execute<UTSJSONObject, LegalWire>(request, response => ok(this.document(response.data)), fail)
  }
  publicPage(slug: string, ok: (value: LegalDocument) => void, fail: (error: AkError) => void): HttpCancellation {
    const request: HttpRequest<UTSJSONObject> = { method: 'GET', path: '/public/pages/' + encodeURIComponent(slug), query: new Map<string, string>(), headers: new Map<string, string>(), retryOnUnauthorized: false, body: {} as UTSJSONObject, locale: akI18n.getLocale() }
    return this.http.execute<UTSJSONObject, LegalWire>(request, response => ok(this.document(response.data)), fail)
  }
  recordConsent(value: LegalDocument, ok: () => void, fail: (error: AkError) => void): HttpCancellation {
    const body: ConsentWire = { document_type: value.documentType, revision_id: value.revisionId, content_hash: value.contentHash, locale: value.locale }
    const request: HttpRequest<ConsentWire> = { method: 'POST', path: '/me/legal-consents', query: new Map<string, string>(), headers: new Map<string, string>(), retryOnUnauthorized: false, body: body, locale: akI18n.getLocale() }
    return this.http.execute<ConsentWire, UTSJSONObject>(request, () => ok(), fail)
  }
  private document(value: LegalWire): LegalDocument {
    const body: string = typeof value.body == 'string' ? value.body : JSON.stringify(value.body)
    return { slug: value.slug, documentType: value.document_type, title: value.title, body: body, bodyFormat: value.body_format == 'blocks' ? 'blocks' : 'markdown', version: value.version.toString(), contentHash: value.content_hash, locale: value.locale, revisionId: value.revision_id }
  }
}
