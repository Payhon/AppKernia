import { AkConfig } from '../../../core/config/config.uts'
import { AkHttpClient } from '../../../core/network/ak-http-client.uts'
import { RefreshCoordinator } from '../../../core/network/refresh-coordinator.uts'
import { RefreshingHttpPort } from '../../../core/network/refreshing-http-port.uts'
import { SessionRuntime } from '../../../core/stores/session-runtime.uts'
import { SessionStore } from '../../../core/stores/session-store.uts'
import { MobileAuthService } from '../../auth/mobile-auth-service.uts'
import { HttpAccountDeletionRepository } from './http-account-deletion-repository.uts'

export class AccountDeletionRuntime {
  private repository: HttpAccountDeletionRepository | null = null

  configure(config: AkConfig, session: SessionStore, sessions: SessionRuntime, auth: MobileAuthService): void {
    this.repository = new HttpAccountDeletionRepository(new RefreshingHttpPort(new AkHttpClient(config, session), new RefreshCoordinator(sessions, auth)))
  }

  getRepository(): HttpAccountDeletionRepository | null { return this.repository }
}

export const accountDeletionRuntime = new AccountDeletionRuntime()
