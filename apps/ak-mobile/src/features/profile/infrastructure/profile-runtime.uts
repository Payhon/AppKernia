import { AkConfig } from '../../../core/config/config.uts'
import { SessionStore } from '../../../core/stores/session-store.uts'
import { AkHttpClient } from '../../../core/network/ak-http-client.uts'
import { RefreshCoordinator } from '../../../core/network/refresh-coordinator.uts'
import { RefreshingHttpPort } from '../../../core/network/refreshing-http-port.uts'
import { SessionRuntime } from '../../../core/stores/session-runtime.uts'
import { MobileAuthService } from '../../auth/mobile-auth-service.uts'
import { HttpProfileRepository } from './http-profile-repository.uts'
import { ProfileAvatarLoader } from './profile-avatar-loader.uts'
import { ProfileAvatarUploader } from './profile-avatar-uploader.uts'
export class ProfileRuntime { private repository:HttpProfileRepository|null=null;private avatarLoader:ProfileAvatarLoader|null=null;private avatarUploader:ProfileAvatarUploader|null=null; configure(config:AkConfig,session:SessionStore,sessions:SessionRuntime,auth:MobileAuthService):void{const refresh=new RefreshCoordinator(sessions,auth);this.repository=new HttpProfileRepository(new RefreshingHttpPort(new AkHttpClient(config,session),refresh));this.avatarLoader=new ProfileAvatarLoader(config,session,refresh);this.avatarUploader=new ProfileAvatarUploader(config,session,refresh,this.repository!)} getRepository():HttpProfileRepository|null{return this.repository} getAvatarLoader():ProfileAvatarLoader|null{return this.avatarLoader} getAvatarUploader():ProfileAvatarUploader|null{return this.avatarUploader} }
export const profileRuntime=new ProfileRuntime()
