<template>
  <ak-theme-root>
    <view class="page">
      <view v-if="!videoVertical" class="nav">
        <ak-back-button />
        <text class="nav-title">{{ typeLabel }}</text>
        <ak-icon-button name="share" :icon-size="20" :label="t('common.share', null)" @click="shareOpen = true" />
      </view>
      <scroll-view class="content" scroll-y>
        <ak-status-view v-if="state !== 'content'" :state="state" :title="stateTitle" :description="t('information.state.description', null)" @retry="reload" />
        <view v-else>
          <ak-content-viewer
            :content-type="contentType"
            :category="displayCategory"
            :title="articleTitle"
            :summary="articleSummary"
            :meta="viewerMeta"
            :cover="coverPath"
            :video-url="asset(videoUrl)"
            :blocks="safeBlocks"
            :media="media"
            :tags="tags"
            :bookmarked="bookmarked"
            :bookmark-loading="mutating"
            :bookmark-label="bookmarked ? t('common.bookmarked', null) : t('common.bookmark', null)"
            :comment-label="t('information.comments.title', null)"
            :share-label="t('common.share', null)"
            :horizontal-label="t('information.video.horizontal', null)"
            :vertical-label="t('information.video.vertical', null)"
            @mode-change="videoModeChanged"
            @video-error="videoFailed = true"
            @bookmark="toggleBookmark"
            @comments="commentsOpen = true"
            @share="shareOpen = true"
          />
          <loading v-if="nativeModuleAnchor" />
          <ak-status-view v-if="videoFailed && !videoVertical" state="error" :title="t('information.video.unavailable', null)" />
        </view>
      </scroll-view>
      <view v-if="state === 'content' && !videoVertical" class="action-bar">
        <view v-if="allowComments" class="comment-shortcut" role="button" @click="commentsOpen = true"><text class="comment-shortcut-text">{{ t('information.comments.placeholderShort', null) }}</text></view>
        <view v-else class="action-spacer" />
        <ak-icon-button class="action-icon" name="bookmark" :label="bookmarked ? t('common.bookmarked', null) : t('common.bookmark', null)" :active="bookmarked" :loading="mutating" @click="toggleBookmark" />
        <ak-icon-button class="action-icon" name="share" :label="t('common.share', null)" @click="shareOpen = true" />
      </view>
      <ak-auth-prompt :open="authOpen" @close="authOpen = false" @authenticated="authenticated" />
      <ak-bottom-sheet :open="commentsOpen" :expanded="true" :title="t('information.comments.title', null)" @close="commentsOpen = false">
        <ak-card v-for="comment in comments" :key="comment.id" class="comment">
          <view class="comment-header"><ak-avatar :src="asset(comment.authorAvatarUrl)" :fallback="comment.authorName" :label="commentAvatarLabel(comment.authorName)" :size="36" /><text class="comment-author">{{ comment.authorName }}</text></view>
          <text class="comment-body">{{ comment.body }}</text>
          <view class="comment-actions"><text class="comment-action" @click="report(comment.id)">{{ t('information.comments.report', null) }}</text><text class="comment-action comment-action-last" @click="block(comment.authorId)">{{ t('information.comments.block', null) }}</text></view>
        </ak-card>
        <view class="comment-composer">
          <ak-text-field v-model="commentBody" :label="t('information.comments.placeholder', null)" />
          <ak-button :disabled="commentBody.trim().length == 0" :label="t('information.comments.submit', null)" @click="submitComment" />
          <text v-if="commentFeedback.length > 0" class="feedback">{{ commentFeedback }}</text>
        </view>
      </ak-bottom-sheet>
      <ak-bottom-sheet :open="shareOpen" :title="t('information.share.title', null)" @close="shareOpen = false">
        <ak-card class="share-preview"><image v-if="coverPath.length > 0" class="share-cover" :src="coverPath" mode="aspectFill" /><text class="share-title">{{ articleTitle }}</text></ak-card>
        <view class="share-option" @click="share('WXSceneSession')"><text>{{ t('information.share.session', null) }}</text></view>
        <view class="share-option" @click="share('WXSceneTimeline')"><text>{{ t('information.share.timeline', null) }}</text></view>
        <view class="share-option" @click="share('WXSceneFavorite')"><text>{{ t('information.share.favorite', null) }}</text></view>
        <view class="share-option" @click="share('system')"><text>{{ t('information.share.system', null) }}</text></view>
      </ak-bottom-sheet>
    </view>
  </ak-theme-root>
</template>

<script lang="uts">
import { akI18n } from '../../../src/core/i18n/ak-i18n.uts'
import { AkError } from '../../../src/core/errors/ak-error.uts'
import { ArticleDetail, ContentComment, ContentMedia, ContentTag } from '../../../src/features/articles/domain/models.uts'
import { ArticleBodyBlock, ArticleBodyRenderer } from '../../../src/features/articles/application/article-body-renderer.uts'
import { articleRuntime } from '../../../src/features/articles/infrastructure/article-runtime.uts'
import { UniShareAdapter } from '../../../src/features/share/infrastructure/uni-share-adapter.uts'
import { appSessionStore } from '../../../src/core/stores/session-store.uts'

const renderer = new ArticleBodyRenderer()
const shareAdapter = new UniShareAdapter()

export default {
  data() {
    return {
      state: 'loading', authOpen: false, shareOpen: false, commentsOpen: false, bookmarked: false, mutating: false, allowComments: false,
      slug: '', coverPath: '', articleId: '', articleTitle: '', articleSummary: '', categoryName: '', publishedAt: '', readingMinutes: 0,
      contentType: 'article', videoUrl: '', videoFailed: false, videoVertical: false, nativeModuleAnchor: false,
      safeBlocks: [] as Array<ArticleBodyBlock>, media: [] as Array<ContentMedia>, tags: [] as Array<ContentTag>, comments: [] as Array<ContentComment>, commentBody: '', commentFeedback: '',
    }
  },
  computed: {
    t() { return akI18n.t },
    typeLabel(): string { return akI18n.t('information.type.' + this.contentType, null) },
    displayCategory(): string { return this.categoryName.length > 0 ? this.categoryName : akI18n.t('articles.uncategorized', null) },
    viewerMeta(): string { return this.publishedAt + ' · ' + akI18n.t('articles.readMinutes', this.readingParams) },
    stateTitle(): string { return akI18n.t(this.state === 'offline' ? 'state.offline.title' : this.state === 'forbidden' ? 'state.forbidden.title' : 'state.error.title', null) },
    readingParams() { return new Map<string, string>([['count', this.readingMinutes.toString()]]) },
  },
  onLoad(options: UTSJSONObject) { const raw = options.getString('slug'); this.slug = raw != null ? raw : ''; this.reload() },
  onHide() { this.pauseVideo() },
  onUnload() { this.pauseVideo() },
  methods: {
    asset(value: string | null): string { return articleRuntime.assetUrl(value) },
    commentAvatarLabel(name:string):string{return akI18n.t('information.comments.avatarAlt',new Map<string,string>([['name',name]]))},
    videoModeChanged(mode: string) { this.videoVertical = mode === 'vertical' },
    reload() {
      const repo = articleRuntime.getRepository()
      if (repo == null || this.slug.length == 0) { this.state = 'error'; return }
      this.state = 'loading'; this.videoFailed = false; this.videoVertical = false
      repo.detail(this.slug, (result: ArticleDetail) => {
        this.articleId = result.id; this.articleTitle = result.title; this.articleSummary = result.summary; this.categoryName = result.categoryName
        this.publishedAt = akI18n.formatDateTime(result.publishedAt); this.readingMinutes = result.readingMinutes; this.contentType = result.contentType
        this.allowComments = result.allowComments; this.bookmarked = result.bookmarked; this.coverPath = this.asset(result.coverUrl)
        const blocks = renderer.render(result.bodyFormat, result.body)
        for (let index = 0; index < blocks.length; index++) {
          if (blocks[index].kind !== 'image') continue
          if (blocks[index].fileId.length > 0) for (let mediaIndex = 0; mediaIndex < result.media.length; mediaIndex++) if (result.media[mediaIndex].fileId === blocks[index].fileId) { blocks[index].url = this.asset(result.media[mediaIndex].url); break }
          else blocks[index].url = this.asset(blocks[index].url)
        }
        this.safeBlocks = blocks; this.media = result.media; this.tags = result.tags; this.videoUrl = result.videoUrl != null ? result.videoUrl : ''; this.state = 'content'
        if (result.allowComments) this.loadComments()
      }, (error: AkError) => { this.state = this.errorState(error); this.authOpen = error.kind === 'unauthorized' })
    },
    errorState(error: AkError): string { if (error.kind === 'network_unavailable' || error.kind === 'timeout') return 'offline'; if (error.kind === 'forbidden') return 'forbidden'; return 'error' },
    protected(): boolean { if (appSessionStore.getAccessToken() == null) { this.authOpen = true; return false }; return true },
    toggleBookmark() {
      if (!this.protected() || this.mutating || this.articleId.length == 0) return
      const repo = articleRuntime.getRepository(); if (repo == null) return
      this.mutating = true; const next = !this.bookmarked
      repo.setBookmark(this.articleId, next, () => { this.bookmarked = next; this.mutating = false }, (error) => { this.mutating = false; if (error.kind === 'unauthorized') this.authOpen = true })
    },
    loadComments() { const repo = articleRuntime.getRepository(); if (repo == null) return; repo.listComments(this.articleId, (value: Array<ContentComment>) => { this.comments = value }, () => {}) },
    submitComment() {
      if (!this.protected()) return
      const repo = articleRuntime.getRepository(); if (repo == null) return
      const body = this.commentBody.trim(); if (body.length == 0 || body.length > 500) return
      repo.createComment(this.articleId, null, body, () => { this.commentBody = ''; this.commentFeedback = akI18n.t('information.comments.pending', null) }, (error) => { if (error.kind === 'unauthorized') this.authOpen = true; else this.commentFeedback = akI18n.t(error.messageKey, null) })
    },
    report(id: string) { if (!this.protected()) return; const repo = articleRuntime.getRepository(); if (repo == null) return; repo.reportComment(id, 'other', '', () => { this.commentFeedback = akI18n.t('information.comments.reported', null) }, () => {}) },
    block(userId: string) { if (!this.protected()) return; const repo = articleRuntime.getRepository(); if (repo == null) return; repo.blockUser(userId, true, () => { this.comments = this.comments.filter((item: ContentComment) => item.authorId !== userId) }, () => {}) },
    authenticated() { this.authOpen = false; this.reload() },
    share(scene: string) {
      const payload = { title: this.articleTitle, path: articleRuntime.shareUrl(this.slug), summary: this.articleSummary, imageUrl: this.coverPath.length > 0 ? this.coverPath : null, scene: scene === 'system' ? '' : scene }
      shareAdapter.share(payload, () => { this.shareOpen = false }, () => { uni.showToast({ title: akI18n.t('information.share.unavailable', null), icon: 'none' }) })
    },
    pauseVideo() { if (this.contentType !== 'video') return; const video = uni.createVideoContext('content-video'); if (video != null) video.pause() },
  },
}
</script>

<style lang="scss">
.page { height: 100%; background: var(--ak-page); }
.nav { min-height: 52px; padding: 4px 16px; flex-direction: row; align-items: center; justify-content: space-between; }
.nav-title { font-size: 16px; font-weight: 650; color: var(--ak-text); }
.content { flex: 1; min-height: 0; padding: 12px 20px 32px; }
.action-bar { min-height: 68px; padding: 8px 14px; padding-bottom: env(safe-area-inset-bottom); flex-direction: row; align-items: center; border-top: 1px solid var(--ak-border); background: var(--ak-surface); }
.action-icon { margin-left: 6px; }
.comment-shortcut { height: 42px; flex: 1; padding: 0 14px; border-radius: 21px; justify-content: center; background: var(--ak-surface-subtle); }
.comment-shortcut-text { color: var(--ak-text-tertiary); font-size: 14px; }
.action-spacer { flex: 1; }
.feedback { color: var(--ak-brand); font-size: 14px; margin: 12px 0; }
.comment { padding: 16px; margin-top: 12px; }
.comment-composer { margin-top: 16px; }
.comment-header { flex-direction:row; align-items:center; }
.comment-author { font-size: 15px; font-weight: 700; color: var(--ak-text); }
.comment-header .comment-author { margin-left:10px; }
.comment-body { font-size: 16px; line-height: 24px; color: var(--ak-text); margin-top: 8px; }
.comment-actions { min-height: 44px; flex-direction: row; align-items: center; }
.comment-action { min-height: 44px; line-height: 44px; color: var(--ak-muted); font-size: 13px; }
.comment-action-last { margin-left: 18px; }
.share-preview { padding: 12px; flex-direction: row; align-items: center; }
.share-cover { width: 72px; height: 72px; border-radius: 12px; margin-right: 12px; }
.share-title { flex: 1; font-size: 17px; font-weight: 700; color: var(--ak-text); }
.share-option { min-height: 56px; justify-content: center; border-bottom: 1px solid var(--ak-border); font-size: 17px; color: var(--ak-text); }
</style>
