<template><ak-theme-root><scroll-view class="page" scroll-y><view class="hero"><text class="title">{{t('legal.consent.title',null)}}</text><text class="description">{{t('legal.consent.description',null)}}</text></view><ak-card class="document"><text class="document-title">{{t('legal.privacy',null)}}</text><text class="body">{{privacyBody}}</text><ak-button variant="secondary" @click="privacy">{{t('legal.privacy',null)}}</ak-button></ak-card><ak-card class="document"><text class="document-title">{{t('legal.terms',null)}}</text><text class="body">{{termsBody}}</text><ak-button variant="secondary" @click="terms">{{t('legal.terms',null)}}</ak-button></ak-card><ak-button variant="primary" @click="accept">{{t('legal.consent.accept',null)}}</ak-button></scroll-view></ak-theme-root></template>
<script lang="uts">import{akI18n}from '../../../src/core/i18n/ak-i18n.uts';import{bundledLegalBody,bundledLegalSnapshot}from '../../../src/features/legal/legal-snapshots.uts';import{legalConsentStore}from '../../../src/features/legal/legal-consent-store.uts';export default{computed:{t(){return akI18n.t},privacyBody(){const v=bundledLegalSnapshot('privacy-policy');return v!=null?bundledLegalBody(v):''},termsBody(){const v=bundledLegalSnapshot('terms-of-service');return v!=null?bundledLegalBody(v):''}},methods:{privacy(){uni.navigateTo({url:'/pages/legal/privacy/index'})},terms(){uni.navigateTo({url:'/pages/legal/terms/index'})},accept(){const privacy=bundledLegalSnapshot('privacy-policy');const terms=bundledLegalSnapshot('terms-of-service');if(privacy==null||terms==null)return;legalConsentStore.accept(privacy);legalConsentStore.accept(terms);uni.reLaunch({url:'/pages/bootstrap/index'})}}}</script><style lang="scss">.page{height:100%;background:var(--ak-page);padding:48px 16px 32px}.hero{margin:0 8px 24px}.title{color:var(--ak-text);font-size:28px;font-weight:600}.description{color:var(--ak-muted);font-size:15px;line-height:24px;margin-top:16px}.document{padding:20px;margin-bottom:16px}.document-title{color:var(--ak-text);font-size:18px;font-weight:600;margin-bottom:12px}.body{color:var(--ak-text);font-size:14px;line-height:22px;margin-bottom:16px}</style>
