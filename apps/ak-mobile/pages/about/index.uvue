<template><ak-theme-root><view class="page"><view class="nav"><ak-back-button/><text>{{t('routes.about.title', null)}}</text><view/></view><ak-status-view v-if="state!=='content'" :state="state" :title="title" :loading-label="t('common.loading', null)" :retry-label="t('common.retry', null)" @retry="reload"/><ak-card v-else><text class="brand">AppKernia</text><text>{{t('about.current', null)}} {{currentVersion}}</text><text>{{t('about.minimum', null)}} {{minimumVersion}}</text><text>{{releaseNotes}}</text><ak-button v-if="upgradeAvailable" variant="primary" disabled>{{t('about.upgradeUnavailable', null)}}</ak-button></ak-card></view></ak-theme-root></template>
<script lang="uts">
import {akI18n} from '../../src/core/i18n/ak-i18n.uts'
import {versionRuntime} from '../../src/features/version/infrastructure/version-runtime.uts'

export default {
  data() { return {state:'loading', currentVersion:'', minimumVersion:'', releaseNotes:'', upgradeAvailable:false} },
  computed: {
    t() { return akI18n.t },
    title() { return akI18n.t(this.state==='offline'?'state.offline.title':this.state==='unavailable'?'state.versionUnavailable.title':'state.error.title', null) },
  },
  onLoad() { this.reload() },
  methods: {
    platform(): string {
      // #ifdef APP-ANDROID
      return 'android'
      // #endif
      // #ifdef APP-HARMONY
      return 'harmony'
      // #endif
      // #ifdef APP-IOS
      return 'ios'
      // #endif
      return 'ios'
    },
    reload() {
      const repository = versionRuntime.getRepository()
      if (repository == null) { this.state='error'; return }
      this.state='loading'
      repository.get(this.platform(), value => {
        this.currentVersion=value.current
        this.minimumVersion=value.minimum
        this.releaseNotes=value.notes
        this.upgradeAvailable=value.upgradeUrl != null && value.upgradeUrl.length>0
        this.state='content'
      }, error => { this.state=error.kind==='network_unavailable'?'offline':error.kind==='maintenance'?'unavailable':'error' })
    },
  },
}
</script>
<style lang="scss">.page{height:100%;flex:1;padding:16px;background:var(--ak-page)}.nav{height:48px;flex-direction:row;align-items:center;justify-content:space-between}.brand{font-size:28px;color:var(--ak-text)}</style>
