<template><ak-theme-root><scroll-view class="page" scroll-y><view class="nav"><ak-back-button fallback-url="/pages/auth/login/index"/><text class="nav-title">{{title.length>0?title:t('routes.legal.page.title',null)}}</text><view class="nav-space"/></view><ak-status-view v-if="state!=='content'" :state="state" :title="stateTitle" :loading-label="t('common.loading',null)" :retry-label="t('common.retry',null)" @retry="reload"/><ak-card v-else class="legal-document"><text class="title">{{title}}</text><text class="meta">{{t('legal.version',versionParams)}}</text><view v-for="block in blocks" :key="block.id" :class="block.kind==='heading'?'heading':block.kind==='callout'?'callout':'paragraph'"><text :class="block.kind==='heading'?'heading-text':block.kind==='callout'?'callout-text':'paragraph-text'">{{block.text}}</text></view></ak-card></scroll-view></ak-theme-root></template>
<script lang="uts">import{HttpCancellation}from '../../../src/core/network/http-port.uts';import{akI18n}from '../../../src/core/i18n/ak-i18n.uts';import{legalRuntime}from '../../../src/features/legal/legal-runtime.uts';import{LegalDocument}from '../../../src/features/legal/legal-repository.uts';import{ArticleBodyRenderer,ArticleBodyBlock}from '../../../src/features/articles/application/article-body-renderer.uts';const renderer=new ArticleBodyRenderer();export default{data(){return{request:null as HttpCancellation|null,state:'loading',slug:'',title:'',version:'',blocks:[] as Array<ArticleBodyBlock>}},computed:{t(){return akI18n.t},stateTitle(){return akI18n.t(this.state==='empty'?'help.notConfigured':this.state==='offline'?'state.offline.title':'state.error.title',null)},versionParams(){return new Map<string,string>([['version',this.version]])}},onUnload(){if(this.request!=null)this.request!.cancel()},onShow(){if(this.slug.length>0)this.reload()},onLoad(options:UTSJSONObject){const raw=options.getString('slug');this.slug=raw!=null?raw:''},methods:{reload(){if(this.request!=null)this.request!.cancel();if(!/^[a-z0-9-]{1,96}$/.test(this.slug)){this.state='error';return};const repo=legalRuntime.getRepository();if(repo==null){this.state='error';return};this.state='loading';this.request=repo.publicPage(this.slug,(value:LegalDocument)=>{this.title=value.title;this.version=value.version;this.blocks=renderer.render(value.bodyFormat,value.body);this.state='content'},e=>{this.state=e.code==='CONTENT.PAGE.NOT_FOUND'?'empty':e.kind==='network_unavailable'?'offline':e.kind==='forbidden'?'forbidden':'error'})}}}</script><style lang="scss">.page{height:100%;background:var(--ak-page);padding:0 20px 48px}.nav{height:52px;flex-direction:row;align-items:center;justify-content:space-between;margin-bottom:12px}.nav-title{color:var(--ak-text);font-size:17px;font-weight:600}.nav-space{width:44px;height:44px}.legal-document{padding:24px}.title{color:var(--ak-text);font-size:30px;font-weight:700;margin:4px 0 8px}.meta{color:var(--ak-muted);font-size:13px;margin-bottom:24px}.heading{color:var(--ak-text);font-size:22px;font-weight:600;line-height:30px;margin:24px 0 8px}.paragraph{color:var(--ak-text);font-size:17px;line-height:28px;margin:10px 0}.callout{background:var(--ak-accent-surface);border-left:3px solid var(--ak-brand);border-radius:12px;padding:16px;margin:18px 0;color:var(--ak-callout-text)}.heading-text{color:var(--ak-text);font-size:22px;font-weight:600;line-height:30px}.paragraph-text{color:var(--ak-text);font-size:17px;line-height:28px}.callout-text{color:var(--ak-callout-text);font-size:17px;line-height:28px}</style>
