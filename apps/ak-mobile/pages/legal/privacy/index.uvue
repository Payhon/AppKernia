<template><ak-theme-root><scroll-view class="page" scroll-y><view class="nav"><ak-back-button/><text>{{t('routes.legal.privacy.title',null)}}</text><view/></view><ak-status-view v-if="state!=='content'" :state="state" :title="stateTitle" :loading-label="t('common.loading',null)" :retry-label="t('common.retry',null)" @retry="reload"/><view v-else><text class="title">{{title}}</text><text class="meta">{{t('legal.version',versionParams)}}</text><view v-for="block in blocks" :key="block.id" :class="block.kind==='heading'?'heading':block.kind==='callout'?'callout':'paragraph'"><text>{{block.text}}</text></view></view></scroll-view></ak-theme-root></template>
<script lang="uts">import{akI18n}from '../../../src/core/i18n/ak-i18n.uts';import{legalRuntime}from '../../../src/features/legal/legal-runtime.uts';import{LegalDocument}from '../../../src/features/legal/legal-repository.uts';import{bundledLegalBody,bundledLegalSnapshot}from '../../../src/features/legal/legal-snapshots.uts';import{ArticleBodyRenderer,ArticleBodyBlock}from '../../../src/features/articles/application/article-body-renderer.uts';const renderer=new ArticleBodyRenderer();export default{data(){return{state:'loading',title:'',version:'',blocks:[] as Array<ArticleBodyBlock>}},computed:{t(){return akI18n.t},stateTitle(){return akI18n.t(this.state==='offline'?'state.offline.title':'state.error.title',null)},versionParams(){return new Map<string,string>([['version',this.version]])}},onLoad(){this.reload()},methods:{fallback(){const v=bundledLegalSnapshot('privacy-policy');if(v==null){this.state='error';return};this.title=akI18n.t(v.titleKey,null);this.version=v.version;this.blocks=renderer.render('markdown',bundledLegalBody(v));this.state='content'},reload(){const repo=legalRuntime.getRepository();if(repo==null){this.fallback();return};this.state='loading';repo.publicDocument('privacy-policy',(value:LegalDocument)=>{this.title=value.title;this.version=value.version;this.blocks=renderer.render(value.bodyFormat,value.body);this.state='content'},e=>{if(e.kind==='network_unavailable'){this.fallback()}else{this.state='error'}})}}}</script><style lang="scss">.page{height:100%;background:var(--ak-page);padding:16px}.nav{height:48px;flex-direction:row;align-items:center;justify-content:space-between;color:var(--ak-text);font-size:20px;font-weight:600}.title{color:var(--ak-text);font-size:28px;font-weight:600;margin:20px 0 8px}.meta{color:var(--ak-muted);font-size:13px;margin-bottom:20px}.heading{color:var(--ak-text);font-size:22px;font-weight:600;line-height:30px;margin:20px 0 8px}.paragraph{color:var(--ak-text);font-size:16px;line-height:28px;margin:10px 0}.callout{background:var(--ak-accent-surface);border-left:3px solid var(--ak-brand);padding:16px;margin:16px 0;color:var(--ak-text)}</style>
