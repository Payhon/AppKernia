<template><ak-theme-root><view class="page"><view class="nav"><ak-back-button fallback-url="/pages/auth/login/index"/><text class="nav-title">{{t('routes.auth.forgotPassword.title',null)}}</text><view class="nav-space"/></view><ak-card class="form-card"><text class="hint">{{t('auth.forgotHint',null)}}</text><view v-if="emailEnabled&&smsEnabled" class="channel-switch" role="tablist" :aria-label="t('auth.otp.channel',null)"><view :class="type==='email'?'channel-option channel-option--selected':'channel-option'" role="tab" :aria-selected="type==='email'" @click="selectType('email')"><text>{{t('auth.method.emailOtp',null)}}</text></view><view :class="type==='mobile'?'channel-option channel-option--selected':'channel-option'" role="tab" :aria-selected="type==='mobile'" @click="selectType('mobile')"><text>{{t('auth.method.smsOtp',null)}}</text></view></view><ak-text-field v-if="type==='email'" v-model="email" :label="t('auth.email',null)" :error="identifierError" input-type="email"/><ak-text-field v-else v-model="mobile" :label="t('auth.mobile',null)" :placeholder="t('auth.mobilePlaceholder',null)" :error="identifierError" input-type="tel"/><ak-status-view v-if="state==='error'" state="error" :title="t('state.error.title',null)" :description="errorText"/><ak-button variant="primary" :loading="state==='loading'" :loading-text="t('common.loading',null)" @click="submit">{{t('auth.sendCode',null)}}</ak-button></ak-card></view><ak-interactive-captcha :open="captchaOpen" :challenge="captchaChallenge" :loading="captchaLoading" :error-text="captchaError" @confirm="confirmCaptcha" @refresh="openCaptcha" @close="closeCaptcha" /></ak-theme-root></template>
<script lang="uts">import{akI18n}from '../../../src/core/i18n/ak-i18n.uts';import{authRuntime}from '../../../src/features/auth/auth-runtime.uts';import{OTPChallenge,OTPIdentifierType}from '../../../src/features/auth/auth-repository.uts';import{appPublicConfigRuntime}from '../../../src/features/app-config/public-config-runtime.uts';import{captchaRuntime}from '../../../src/features/captcha/captcha-runtime.uts';import{AkInteractiveCaptchaChallenge,AkInteractiveCaptchaResponse}from '../../../uni_modules/ak-interactive-captcha/model.uts';export default{data(){return{type:(appPublicConfigRuntime.emailOTPEnabled()?'email':'mobile') as OTPIdentifierType,email:'',mobile:'',identifierError:'',state:'content',errorText:'',captchaOpen:false,captchaLoading:false,captchaError:'',captchaChallenge:null as AkInteractiveCaptchaChallenge|null}},computed:{t(){return akI18n.t},emailEnabled():boolean{return appPublicConfigRuntime.emailOTPEnabled()},smsEnabled():boolean{return appPublicConfigRuntime.smsOTPEnabled()}},methods:{selectType(value:string){this.type=value==='mobile'?'mobile':'email';this.identifierError='';this.closeCaptcha()},identifier():string{return this.type==='email'?this.email.trim():this.mobile.trim()},valid():boolean{this.identifierError='';const value=this.identifier();if(value.length==0){this.identifierError=akI18n.t('errors.validation.required',null);return false};if(this.type==='email'&&(value.indexOf('@')<=0||value.endsWith('@'))){this.identifierError=akI18n.t('errors.validation.email',null);return false};if(this.type==='mobile'&&!/^\+[1-9][0-9]{7,14}$/.test(value)){this.identifierError=akI18n.t('errors.validation.mobile',null);return false};return true},submit(){if(!this.valid())return;const service=authRuntime.getService();if(service==null){this.fail('errors.runtime.unavailable');return};if(this.type==='mobile'){this.openCaptcha();return};this.state='loading';service.forgotPassword('email',this.identifier(),null,(challenge:OTPChallenge)=>this.complete(challenge),e=>this.fail(e.messageKey))},openCaptcha(){const repo=captchaRuntime.getRepository();if(repo==null){this.fail('errors.runtime.unavailable');return};this.captchaOpen=true;this.captchaLoading=true;this.captchaError='';repo.create({scene:'password_reset',mobile:this.identifier(),identifierId:'',purpose:'',resource:''},challenge=>{this.captchaChallenge=challenge;this.captchaLoading=false},e=>{this.captchaLoading=false;this.captchaError=akI18n.t(e.messageKey,null)})},closeCaptcha(){this.captchaOpen=false;this.captchaLoading=false;this.captchaChallenge=null;this.captchaError='';this.state='content'},confirmCaptcha(response:AkInteractiveCaptchaResponse){const repo=captchaRuntime.getRepository();const service=authRuntime.getService();const challenge=this.captchaChallenge;if(repo==null||service==null||challenge==null)return;this.captchaLoading=true;service.forgotPassword('mobile',this.identifier(),repo.submission(challenge,response),(result:OTPChallenge)=>{this.closeCaptcha();this.complete(result)},e=>{this.captchaLoading=false;this.captchaError=akI18n.t(e.messageKey,null)})},complete(challenge:OTPChallenge){uni.redirectTo({url:'/pages/auth/reset-password/index?type='+this.type+'&identifier='+encodeURIComponent(this.identifier())+'&challenge_id='+challenge.challengeId})},fail(key:string){this.errorText=akI18n.t(key,null);this.state='error'}}}</script>
<style lang="scss">.page{height:100%;flex:1;background:var(--ak-page);padding:0 20px 40px}.nav{height:52px;flex-direction:row;align-items:center;justify-content:space-between;margin-bottom:20px}.nav-title{color:var(--ak-text);font-size:17px;font-weight:600}.nav-space{width:44px;height:44px}.form-card{padding:24px}.hint{color:var(--ak-muted);font-size:15px;line-height:22px;margin-bottom:24px}.channel-switch{flex-direction:row;margin-bottom:16px}.channel-option{min-height:44px;padding:0 14px;align-items:center;justify-content:center;border-bottom:2px solid transparent}.channel-option--selected{border-bottom-color:var(--ak-brand)}</style>
