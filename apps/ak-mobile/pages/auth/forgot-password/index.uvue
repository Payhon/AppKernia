<template><ak-theme-root><view class="page"><view class="nav"><ak-back-button fallback-url="/pages/auth/login/index"/><text class="nav-title">{{t('routes.auth.forgotPassword.title',null)}}</text><view class="nav-space"/></view><ak-card class="form-card"><text class="hint">{{t('auth.forgotHint',null)}}</text><ak-text-field v-model="email" :label="t('auth.email',null)" :error="emailError"/><ak-status-view v-if="state==='error'" state="error" :title="t('state.error.title',null)" :description="errorText"/><ak-button variant="primary" :loading="state==='loading'" :loading-text="t('common.loading',null)" @click="submit">{{t('auth.sendCode',null)}}</ak-button></ak-card></view></ak-theme-root></template>
<script lang="uts">import{akI18n}from '../../../src/core/i18n/ak-i18n.uts';import{authRuntime}from '../../../src/features/auth/auth-runtime.uts';export default{data(){return{email:'',emailError:'',state:'content',errorText:''}},computed:{t(){return akI18n.t}},methods:{submit(){this.emailError='';if(this.email.trim().length==0){this.emailError=akI18n.t('errors.validation.required',null);return};const s=authRuntime.getService();if(s==null){this.errorText=akI18n.t('errors.runtime.unavailable',null);this.state='error';return};this.state='loading';s.forgotPassword(this.email.trim(),()=>{uni.redirectTo({url:'/pages/auth/reset-password/index?email='+encodeURIComponent(this.email.trim())})},e=>{this.errorText=akI18n.t(e.messageKey,null);this.state='error'})}}}</script><style lang="scss">.page{height:100%;flex:1;background:var(--ak-page);padding:0 20px 40px}.nav{height:52px;flex-direction:row;align-items:center;justify-content:space-between;margin-bottom:20px}.nav-title{color:var(--ak-text);font-size:17px;font-weight:600}.nav-space{width:44px;height:44px}.form-card{padding:24px}.hint{color:var(--ak-muted);font-size:15px;line-height:22px;margin-bottom:24px}</style>
