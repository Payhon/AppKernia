<template><ak-theme-root><scroll-view class="page" scroll-y><view class="nav"><ak-back-button fallback-url="/pages/auth/login/index"/><text class="nav-title">{{t('routes.auth.resetPassword.title',null)}}</text><view class="nav-space"/></view><ak-card class="form-card"><ak-text-field v-model="code" :label="t('auth.verificationCode',null)" :error="codeError" input-type="number" :max-length="6"/><ak-text-field v-model="password" :label="t('auth.newPassword',null)" :error="passwordError" password/><ak-text-field v-model="confirmPassword" :label="t('auth.confirmNewPassword',null)" :error="confirmPasswordError" password/><ak-status-view v-if="state==='error'" state="error" :title="t('state.error.title',null)" :description="errorText"/><ak-button variant="primary" :loading="state==='loading'" :loading-text="t('common.loading',null)" @click="submit">{{t('auth.resetPassword',null)}}</ak-button></ak-card></scroll-view></ak-theme-root></template>
<script lang="uts">import{akI18n}from '../../../src/core/i18n/ak-i18n.uts';import{authRuntime}from '../../../src/features/auth/auth-runtime.uts';import{OTPIdentifierType}from '../../../src/features/auth/auth-repository.uts';export default{data(){return{type:'email' as OTPIdentifierType,identifier:'',challengeId:'',code:'',password:'',confirmPassword:'',codeError:'',passwordError:'',confirmPasswordError:'',state:'content',errorText:''}},computed:{t(){return akI18n.t}},onLoad(options:UTSJSONObject){this.type=options.getString('type')==='mobile'?'mobile':'email';this.identifier=options.getString('identifier')??'';this.challengeId=options.getString('challenge_id')??''},methods:{submit(){this.codeError='';this.passwordError='';this.confirmPasswordError='';if(!/^[0-9]{6}$/.test(this.code)){this.codeError=akI18n.t('errors.validation.otp',null);return};if(this.password.length<12){this.passwordError=akI18n.t('auth.passwordMinLength',null);return};if(this.password!=this.confirmPassword){this.confirmPasswordError=akI18n.t('errors.validation.passwordMismatch',null);return};const service=authRuntime.getService();if(service==null){this.errorText=akI18n.t('errors.runtime.unavailable',null);this.state='error';return};this.state='loading';service.resetPassword({identifierType:this.type,identifier:this.identifier,challengeId:this.challengeId,verificationCode:this.code,newPassword:this.password},()=>{uni.reLaunch({url:'/pages/auth/login/index'})},e=>{this.errorText=akI18n.t(e.messageKey,null);this.state='error'})}}}</script>
<style lang="scss">.page{height:100%;background:var(--ak-page);padding:0 20px 40px}.nav{height:52px;flex-direction:row;align-items:center;justify-content:space-between;margin-bottom:20px}.nav-title{color:var(--ak-text);font-size:17px;font-weight:600}.nav-space{width:44px;height:44px}.form-card{padding:24px}</style>
