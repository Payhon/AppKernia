<template><ak-theme-root><scroll-view class="page" scroll-y><view class="nav"><ak-back-button/><text>{{t('routes.auth.resetPassword.title',null)}}</text><view/></view><ak-card class="form-card"><ak-text-field v-model="code" :label="t('auth.verificationCode',null)" :error="codeError"/><ak-text-field v-model="password" :label="t('auth.newPassword',null)" :error="passwordError" password/><ak-text-field v-model="confirmPassword" :label="t('auth.confirmNewPassword',null)" :error="confirmPasswordError" password/><ak-status-view v-if="state==='error'" state="error" :title="t('state.error.title',null)" :description="errorText"/><ak-button variant="primary" :loading="state==='loading'" :loading-text="t('common.loading',null)" @click="submit">{{t('auth.resetPassword',null)}}</ak-button></ak-card></scroll-view></ak-theme-root></template>
<script lang="uts">import{akI18n}from '../../../src/core/i18n/ak-i18n.uts';import{authRuntime}from '../../../src/features/auth/auth-runtime.uts';export default{data(){return{email:'',code:'',password:'',confirmPassword:'',codeError:'',passwordError:'',confirmPasswordError:'',state:'content',errorText:''}},computed:{t(){return akI18n.t}},onLoad(options:UTSJSONObject){const raw=options.getString('email');this.email=raw!=null?raw:''},methods:{submit(){this.codeError='';this.passwordError='';this.confirmPasswordError='';if(this.code.length==0){this.codeError=akI18n.t('errors.validation.required',null);return};if(this.password.length<12){this.passwordError=akI18n.t('auth.passwordMinLength',null);return};if(this.password!=this.confirmPassword){this.confirmPasswordError=akI18n.t('errors.validation.passwordMismatch',null);return};const s=authRuntime.getService();if(s==null){this.errorText=akI18n.t('errors.runtime.unavailable',null);this.state='error';return};this.state='loading';s.resetPassword({email:this.email,code:this.code,newPassword:this.password},()=>{uni.reLaunch({url:'/pages/auth/login/index'})},e=>{this.errorText=akI18n.t(e.messageKey,null);this.state='error'})}}}</script><style lang="scss">.page{height:100%;background:var(--ak-page);padding:16px}.nav{height:48px;flex-direction:row;align-items:center;justify-content:space-between;color:var(--ak-text);font-size:20px;font-weight:600}.form-card{padding:20px}</style>
