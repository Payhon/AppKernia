<template><ak-theme-root><view class="page"><view class="nav"><ak-back-button fallback-url="/pages/auth/login/index"/><text class="nav-title">{{t('routes.auth.verifyContact.title',null)}}</text><view class="nav-space"/></view><ak-card class="form-card"><text class="hint">{{t('auth.verifyHint',params)}}</text><ak-text-field v-model="code" :label="t('auth.verificationCode',null)" :error="codeError"/><ak-status-view v-if="state==='error'" state="error" :title="t('state.error.title',null)" :description="errorText"/><ak-button variant="primary" :loading="state==='loading'" :loading-text="t('common.loading',null)" @click="verify">{{t('common.submit',null)}}</ak-button><ak-button class="resend-action" variant="secondary" :disabled="seconds>0" @click="resend">{{seconds>0?t('auth.resendAfter',secondsParams):t('common.resend',null)}}</ak-button></ak-card></view></ak-theme-root></template>
<script lang="uts">import{akI18n}from '../../../src/core/i18n/ak-i18n.uts';import{authRuntime}from '../../../src/features/auth/auth-runtime.uts';export default{data(){return{email:'',code:'',codeError:'',state:'content',errorText:'',seconds:0,timer:0}},computed:{t(){return akI18n.t},params(){return new Map<string,string>([['email',this.email]])},secondsParams(){return new Map<string,string>([['seconds',this.seconds.toString()]])}},onLoad(options:UTSJSONObject){const raw=options.getString('email');this.email=raw!=null?raw:'';this.startTimer(60)},onUnload(){if(this.timer>0)clearInterval(this.timer)},methods:{startTimer(seconds:number){this.seconds=seconds;if(this.timer>0)clearInterval(this.timer);this.timer=setInterval(()=>{if(this.seconds>0)this.seconds-=1},1000)},verify(){this.codeError='';if(this.email.length==0||this.code.length==0){this.codeError=akI18n.t('errors.validation.required',null);return};const s=authRuntime.getService();if(s==null){this.errorText=akI18n.t('errors.runtime.unavailable',null);this.state='error';return};this.state='loading';s.verifyRegistration({email:this.email,code:this.code},()=>{uni.reLaunch({url:'/pages/auth/login/index'})},e=>{this.errorText=akI18n.t(e.messageKey,null);this.state='error'})},resend(){if(this.seconds>0)return;const s=authRuntime.getService();if(s==null)return;this.state='loading';s.resendRegistration(this.email,result=>{this.state='content';this.startTimer(result.retryAfterSeconds)},e=>{this.errorText=akI18n.t(e.messageKey,null);this.state='error'})}}}</script><style lang="scss">.page{height:100%;flex:1;background:var(--ak-page);padding:0 20px 40px}.nav{height:52px;flex-direction:row;align-items:center;justify-content:space-between;margin-bottom:20px}.nav-title{color:var(--ak-text);font-size:17px;font-weight:600}.nav-space{width:44px;height:44px}.form-card{padding:24px}.hint{color:var(--ak-muted);font-size:15px;line-height:22px;margin-bottom:24px}.resend-action{margin-top:12px}</style>
