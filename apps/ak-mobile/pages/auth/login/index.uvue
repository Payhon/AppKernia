<template>
  <ak-theme-root><scroll-view class="page" scroll-y>
    <view class="hero"><text class="brand">{{t('information.appName', null)}}</text><text class="title">{{t('routes.auth.login.title', null)}}</text></view>
    <ak-card class="form-card">
      <ak-login-method-form @authenticated="authenticated" />
      <ak-login-provider-list mode="login" @authenticated="authenticated" />
      <view class="auth-link-row">
        <view class="auth-link" @click="goForgot"><text class="auth-link-text">{{t('auth.forgotPassword', null)}}</text></view>
        <view v-if="registrationEnabled" class="auth-link auth-link-register" @click="goRegister"><text class="auth-link-text">{{t('auth.register.link', null)}}</text></view>
      </view>
    </ak-card>
    <view class="legal-links"><text class="legal-link" @click="goPrivacy">{{t('legal.privacy', null)}}</text><text class="separator"> · </text><text class="legal-link" @click="goTerms">{{t('legal.terms', null)}}</text></view>
  </scroll-view></ak-theme-root>
</template>
<script lang="uts">
import {akI18n} from '../../../src/core/i18n/ak-i18n.uts'
import {completeAuthenticatedBootstrap} from '../../../src/core/bootstrap/app-bootstrap.uts'
import {appPublicConfigRuntime} from '../../../src/features/app-config/public-config-runtime.uts'
export default { computed: { t(){return akI18n.t}, registrationEnabled(): boolean { return appPublicConfigRuntime.registrationEnabled() } }, onLoad(options:UTSJSONObject){const deleted=options.getString('account_deleted');if(deleted=='1')setTimeout(()=>uni.showToast({title:akI18n.t('accountDeletion.success',null),icon:'success'}),100)}, methods: {
  goForgot(){uni.navigateTo({url:'/pages/auth/forgot-password/index'})}, goRegister(){uni.navigateTo({url:'/pages/auth/register/index'})}, goPrivacy(){uni.navigateTo({url:'/pages/legal/privacy/index'})}, goTerms(){uni.navigateTo({url:'/pages/legal/terms/index'})},
  authenticated(){completeAuthenticatedBootstrap()}
} }
</script>
<style lang="scss">
.page{height:100%;flex:1;background:var(--ak-page);padding:32px 20px 40px}
.hero{margin:0 4px 28px}
.brand{color:var(--ak-brand);font-size:22px;font-weight:700}
.title{color:var(--ak-text);font-size:34px;font-weight:700;margin-top:18px}
.form-card{padding:24px}
.auth-link-row{margin-top:12px;flex-direction:row;align-items:center;justify-content:center}
.auth-link{height:44px;padding:0 8px;align-items:center;justify-content:center}
.auth-link-register{margin-left:8px}
.auth-link-text{color:var(--ak-brand);font-size:15px;font-weight:500}
.legal-links{margin-top:24px;min-height:44px;flex-direction:row;align-items:center;justify-content:center}
.legal-link{color:var(--ak-brand);font-size:14px}
.separator{color:var(--ak-muted);font-size:14px;margin:0 6px}
</style>
