<template><ak-theme-root><view class="page"><text class="brand">AppKernia</text><text class="title">{{t('routes.auth.login.title', null)}}</text><ak-text-field v-model="email" :label="t('auth.email', null)"/><ak-text-field v-model="password" :label="t('auth.password', null)" password/><ak-status-view v-if="state==='error'" state="error" :title="t('state.error.title', null)" :description="errorText"/><ak-button variant="primary" :loading="state==='loading'" :loading-text="t('common.loading', null)" @click="login">{{t('auth.login', null)}}</ak-button></view></ak-theme-root></template>
<script lang="uts">import {akI18n} from '../../../src/core/i18n/ak-i18n.uts';import {completeAuthenticatedBootstrap} from '../../../src/core/bootstrap/app-bootstrap.uts';import {authRuntime} from '../../../src/features/auth/auth-runtime.uts';export default{data(){return{email:'',password:'',state:'content',errorText:''}},computed:{t(){return akI18n.t}},methods:{login(){if(this.email.length==0||this.password.length==0){this.errorText=akI18n.t('errors.validation.required', null);this.state='error';return}const service=authRuntime.getService();if(service==null){this.errorText=akI18n.t('errors.runtime.unavailable', null);this.state='error';return}this.state='loading';service.login({email:this.email,password:this.password,deviceKey:authRuntime.getDeviceKey()},()=>{completeAuthenticatedBootstrap()},(error)=>{this.errorText=akI18n.t(error.messageKey, null);this.state='error'})}}}</script>
<style lang="scss">.page{height:100%;flex:1;background:var(--ak-page);padding:80px 24px}.brand{color:var(--ak-brand);font-size:28px;font-weight:700}.title{color:var(--ak-text);font-size:30px;font-weight:600;margin:24px 0}</style>
