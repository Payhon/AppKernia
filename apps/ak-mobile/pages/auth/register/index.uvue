<template><ak-theme-root><scroll-view class="page" scroll-y><view class="nav"><ak-back-button fallback-url="/pages/auth/login/index"/><text class="nav-title">{{t('routes.auth.register.title',null)}}</text><view class="nav-space"/></view><ak-status-view v-if="configState!=='content'" :state="configState" :title="configTitle" :loading-label="t('common.loading',null)" :retry-label="t('common.retry',null)" @retry="loadLegal"/><ak-card v-else class="form-card"><ak-text-field v-model="displayName" :label="t('auth.displayName',null)" :error="displayNameError"/><ak-text-field v-model="email" :label="t('auth.email',null)" :error="emailError"/><ak-text-field v-model="password" :label="t('auth.password',null)" :error="passwordError" password/><ak-text-field v-model="confirmPassword" :label="t('auth.confirmNewPassword',null)" :error="confirmPasswordError" password/><ak-status-view v-if="state==='error'" state="error" :title="t('state.error.title',null)" :description="errorText"/><text class="consent">{{t('legal.consent.required',null)}}</text><view class="legal-actions"><ak-button class="legal-action" variant="secondary" @click="privacy">{{t('legal.privacy',null)}}</ak-button><ak-button class="legal-action" variant="secondary" @click="terms">{{t('legal.terms',null)}}</ak-button></view><ak-button class="register-action" variant="primary" :loading="state==='loading'" :loading-text="t('common.loading',null)" @click="submit">{{t('auth.register',null)}}</ak-button></ak-card></scroll-view></ak-theme-root></template>
<script lang="uts">
import{akI18n}from '../../../src/core/i18n/ak-i18n.uts';import{authRuntime}from '../../../src/features/auth/auth-runtime.uts';import{appPublicConfigRuntime}from '../../../src/features/app-config/public-config-runtime.uts';import{legalRuntime}from '../../../src/features/legal/legal-runtime.uts';
export default{data(){return{configState:'loading',state:'content',displayName:'',email:'',password:'',confirmPassword:'',displayNameError:'',emailError:'',passwordError:'',confirmPasswordError:'',errorText:''}},computed:{t(){return akI18n.t},configTitle(){return akI18n.t(this.configState==='offline'?'state.offline.title':'state.error.title',null)}},onLoad(){this.loadLegal()},methods:{privacy(){uni.navigateTo({url:'/pages/legal/privacy/index'})},terms(){uni.navigateTo({url:'/pages/legal/terms/index'})},loadLegal(){if(!appPublicConfigRuntime.registrationEnabled()){this.configState='error';return};const repo=legalRuntime.getRepository();if(repo==null){this.configState='error';return};this.configState='loading';repo.publicDocument('privacy-policy',()=>{repo.publicDocument('terms-of-service',()=>{this.configState='content'},e=>{this.configState=e.kind==='network_unavailable'?'offline':'error'})},e=>{this.configState=e.kind==='network_unavailable'?'offline':'error'})},submit(){this.displayNameError='';this.emailError='';this.passwordError='';this.confirmPasswordError='';if(this.displayName.trim().length==0){this.displayNameError=akI18n.t('errors.validation.required',null);return};if(this.email.trim().length==0){this.emailError=akI18n.t('errors.validation.required',null);return};if(this.password.length<12){this.passwordError=akI18n.t('auth.passwordMinLength',null);return};if(this.password!=this.confirmPassword){this.confirmPasswordError=akI18n.t('errors.validation.passwordMismatch',null);return};const service=authRuntime.getService();if(service==null){this.errorText=akI18n.t('errors.runtime.unavailable',null);this.state='error';return};this.state='loading';service.register({email:this.email.trim(),displayName:this.displayName.trim(),password:this.password,acceptTerms:true},result=>{if(result.verificationRequired){uni.redirectTo({url:'/pages/auth/verify-contact/index?email='+encodeURIComponent(this.email.trim())})}else{uni.reLaunch({url:'/pages/auth/login/index'})}},e=>{this.errorText=akI18n.t(e.messageKey,null);this.state='error'})}}}
</script><style lang="scss">.page{height:100%;background:var(--ak-page);padding:0 20px 40px}.nav{height:52px;flex-direction:row;align-items:center;justify-content:space-between;margin-bottom:20px}.nav-title{color:var(--ak-text);font-size:17px;font-weight:600}.nav-space{width:44px;height:44px}.form-card{padding:24px}.consent{color:var(--ak-muted);font-size:13px;line-height:20px;margin:4px 0 12px}.legal-actions{flex-direction:row;justify-content:space-between}.legal-action{width:48%}.register-action{margin-top:16px}</style>
