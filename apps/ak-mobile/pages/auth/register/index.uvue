<template>
  <ak-theme-root><scroll-view class="page" scroll-y>
    <view class="nav"><ak-back-button fallback-url="/pages/auth/login/index"/><text class="nav-title">{{t('routes.auth.register.title',null)}}</text><view class="nav-space"/></view>
    <ak-card class="form-card">
      <ak-login-method-switch v-model="method" :otp-enabled="otpEnabled"/>
      <view v-if="configState!=='content'" class="config-notice" role="status">
        <text class="config-message">{{t(configMessageKey,null)}}</text>
        <ak-button v-if="configState!=='loading'&&configState!=='disabled'" variant="secondary" @click="loadLegal">{{t('common.retry',null)}}</ak-button>
      </view>
      <ak-text-field v-model="displayName" :label="t('auth.displayName',null)" :error="displayNameError"/>
      <view v-if="method==='otp'&&emailOTPEnabled&&smsOTPEnabled" class="channel-switch" role="tablist" :aria-label="t('auth.otp.channel',null)">
        <view :class="identifierType==='email'?'channel-option channel-option--selected':'channel-option'" role="tab" :aria-selected="identifierType==='email'" @click="selectType('email')"><text>{{t('auth.method.emailOtp',null)}}</text></view>
        <view :class="identifierType==='mobile'?'channel-option channel-option--selected':'channel-option'" role="tab" :aria-selected="identifierType==='mobile'" @click="selectType('mobile')"><text>{{t('auth.method.smsOtp',null)}}</text></view>
      </view>
      <ak-text-field v-if="method==='password'||identifierType==='email'" v-model="email" :label="t('auth.email',null)" :error="identifierError" input-type="email"/>
      <ak-text-field v-else v-model="mobile" :label="t('auth.mobile',null)" :placeholder="t('auth.mobilePlaceholder',null)" :error="identifierError" input-type="tel"/>
      <template v-if="method==='password'"><ak-text-field v-model="password" :label="t('auth.password',null)" :error="passwordError" password/><ak-text-field v-model="confirmPassword" :label="t('auth.confirmNewPassword',null)" :error="confirmPasswordError" password/></template>
      <view v-else class="otp-row"><view class="otp-field"><ak-text-field v-model="code" :label="t('auth.verificationCode',null)" :error="codeError" input-type="number" :max-length="6"/></view><view class="otp-send" :class="configState!=='content'?'otp-send--disabled':''" role="button" :aria-disabled="configState!=='content'" :aria-label="t('auth.otp.send',null)" @click="sendCode"><text class="otp-send-label">{{t(challengeId.length>0?'auth.otp.resend':'auth.otp.send',null)}}</text></view></view>
      <ak-status-view v-if="state==='error'" state="error" :title="t('state.error.title',null)" :description="errorText"/>
      <view class="register-consent">
        <text class="register-consent-text">{{t('auth.register.consent.before',null)}}</text>
        <text class="register-consent-link" role="link" @click="privacy">{{t('legal.privacy',null)}}</text>
        <text class="register-consent-text">{{t('legal.consent.statement.middle',null)}}</text>
        <text class="register-consent-link" role="link" @click="terms">{{t('legal.terms',null)}}</text>
      </view>
      <ak-button class="register-action" variant="primary" :disabled="configState!=='content'" :loading="state==='loading'" :loading-text="t('common.loading',null)" @click="submit">{{t('auth.register',null)}}</ak-button>
    </ak-card>
  </scroll-view></ak-theme-root>
</template>
<script lang="uts">
import {akI18n} from '../../../src/core/i18n/ak-i18n.uts'
import {AkError} from '../../../src/core/errors/ak-error.uts'
import {completeAuthenticatedBootstrap} from '../../../src/core/bootstrap/app-bootstrap.uts'
import {authRuntime} from '../../../src/features/auth/auth-runtime.uts'
import {OTPChallenge, OTPIdentifierType} from '../../../src/features/auth/auth-repository.uts'
import {appPublicConfigRuntime} from '../../../src/features/app-config/public-config-runtime.uts'
import {legalRuntime} from '../../../src/features/legal/legal-runtime.uts'
export default {data(){return{configState:'loading',configMessageKey:'common.loading',state:'content',method:'password',identifierType:(appPublicConfigRuntime.emailOTPEnabled()?'email':'mobile') as OTPIdentifierType,displayName:'',email:'',mobile:'',password:'',confirmPassword:'',code:'',challengeId:'',displayNameError:'',identifierError:'',passwordError:'',confirmPasswordError:'',codeError:'',errorText:''}},computed:{t(){return akI18n.t},otpEnabled():boolean{return appPublicConfigRuntime.otpEnabled()},emailOTPEnabled():boolean{return appPublicConfigRuntime.emailOTPEnabled()},smsOTPEnabled():boolean{return appPublicConfigRuntime.smsOTPEnabled()},activeIdentifierType():OTPIdentifierType{return this.method==='password'?'email':this.identifierType}},onLoad(){this.loadLegal()},methods:{privacy(){uni.navigateTo({url:'/pages/legal/privacy/index'})},terms(){uni.navigateTo({url:'/pages/legal/terms/index'})},selectType(value:string){this.identifierType=value==='mobile'?'mobile':'email';this.challengeId='';this.code=''},identifier():string{return this.activeIdentifierType==='email'?this.email.trim():this.mobile.trim()},loadLegal(){if(!appPublicConfigRuntime.registrationEnabled()){this.configState='disabled';this.configMessageKey='auth.register.disabled';return};const repo=legalRuntime.getRepository();if(repo==null){this.configState='error';this.configMessageKey='errors.runtime.unavailable';return};this.configState='loading';this.configMessageKey='common.loading';repo.publicDocument('privacy-policy',()=>{repo.publicDocument('terms-of-service',()=>{this.configState='content'},e=>this.legalFailure(e))},e=>this.legalFailure(e))},validBase():boolean{this.displayNameError='';this.identifierError='';if(this.displayName.trim().length==0){this.displayNameError=akI18n.t('errors.validation.required',null);return false};const value=this.identifier();if(value.length==0){this.identifierError=akI18n.t('errors.validation.required',null);return false};if(this.activeIdentifierType==='email'&&(value.indexOf('@')<=0||value.endsWith('@'))){this.identifierError=akI18n.t('errors.validation.email',null);return false};if(this.activeIdentifierType==='mobile'&&!/^\+[1-9][0-9]{7,14}$/.test(value)){this.identifierError=akI18n.t('errors.validation.mobile',null);return false};return true},sendCode(){if(this.configState!=='content'||this.state==='loading'||this.method!=='otp'||!this.otpEnabled)return;if(!this.validBase())return;const service=authRuntime.getService();if(service==null){this.fail('errors.runtime.unavailable');return};service.sendRegistrationOTP(this.identifierType,this.identifier(),(challenge:OTPChallenge)=>{this.challengeId=challenge.challengeId;this.state='content'},e=>this.fail(e.messageKey))},submit(){if(this.configState!=='content'||this.state==='loading')return;if(!this.validBase())return;const service=authRuntime.getService();if(service==null){this.fail('errors.runtime.unavailable');return};this.state='loading';if(this.method==='password'){this.passwordError='';this.confirmPasswordError='';if(this.password.length<12){this.passwordError=akI18n.t('auth.passwordMinLength',null);this.state='content';return};if(this.password!=this.confirmPassword){this.confirmPasswordError=akI18n.t('errors.validation.passwordMismatch',null);this.state='content';return};service.register({email:this.email.trim(),displayName:this.displayName.trim(),password:this.password,acceptTerms:true},result=>{if(result.verificationRequired)uni.redirectTo({url:'/pages/auth/verify-contact/index?email='+encodeURIComponent(this.email.trim())});else uni.reLaunch({url:'/pages/auth/login/index'})},e=>this.fail(e.messageKey));return};this.codeError='';if(this.challengeId.length==0){this.codeError=akI18n.t('auth.otp.sendFirst',null);this.state='content';return};if(!/^[0-9]{6}$/.test(this.code)){this.codeError=akI18n.t('errors.validation.otp',null);this.state='content';return};service.registerOTP({identifierType:this.identifierType,identifier:this.identifier(),challengeId:this.challengeId,verificationCode:this.code,displayName:this.displayName.trim(),acceptTerms:true},()=>completeAuthenticatedBootstrap(),e=>this.fail(e.messageKey))},legalFailure(error:AkError){this.configState=error.kind==='network_unavailable'?'offline':'error';this.configMessageKey=error.code==='CONTENT.PAGE.NOT_FOUND'?'auth.register.legalUnavailable':error.messageKey},fail(key:string){this.errorText=akI18n.t(key,null);this.state='error'}}}
</script>
<style lang="scss">
.register-consent{flex-direction:row;flex-wrap:wrap;margin-top:4px}
.register-consent-text{color:var(--ak-muted);font-size:14px;line-height:44px}
.register-consent-link{color:var(--ak-brand);font-size:14px;line-height:44px;font-weight:500;text-decoration-line:underline}
.otp-send--disabled{opacity:.5}
.config-notice{padding:12px;margin-bottom:16px;border-radius:12px;background:var(--ak-surface-subtle)}.config-message{color:var(--ak-muted);font-size:14px;line-height:21px;margin-bottom:8px}
.page{height:100%;background:var(--ak-page);padding:0 20px 40px}.nav{height:52px;flex-direction:row;align-items:center;justify-content:space-between;margin-bottom:20px}.nav-title{color:var(--ak-text);font-size:17px;font-weight:600}.nav-space{width:44px;height:44px}.form-card{padding:24px}.channel-switch{flex-direction:row;margin:-6px 0 14px}.channel-option{min-height:44px;padding:0 14px;align-items:center;justify-content:center;border-bottom:2px solid transparent}.channel-option--selected{border-bottom-color:var(--ak-brand)}.otp-row{flex-direction:row;align-items:flex-start}.otp-field{flex:1}.otp-send{width:112px;min-height:48px;margin-left:10px;margin-top:23px;padding:0 8px;border:1px solid var(--ak-brand);border-radius:12px;align-items:center;justify-content:center}.otp-send-label{color:var(--ak-brand);font-size:13px;font-weight:600}.register-action{margin-top:16px}
</style>
