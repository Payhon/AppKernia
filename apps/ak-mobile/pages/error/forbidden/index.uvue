<template><ak-theme-root><view class="page"><view class="error-card"><ak-empty icon="error" :title="t('state.forbidden.title', null)" :action-label="t('common.back', null)" action-icon="back" @action="back"/></view></view></ak-theme-root></template><script lang="uts">import {akI18n} from '../../../src/core/i18n/ak-i18n.uts';export default{computed:{t(){return akI18n.t}},methods:{back(){uni.reLaunch({url:'/pages/home/index'})}}}</script><style lang="scss">.page{flex:1;background:var(--ak-page);justify-content:center;padding:20px}.error-card{background:var(--ak-surface);border:1px solid var(--ak-border);border-radius:18px}</style>
