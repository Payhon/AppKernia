<template><ak-theme-root><view class="page"><view class="error-card"><ak-empty icon="offline" :title="title" :action-label="t('common.retry', null)" action-icon="retry" @action="retry"/></view></view></ak-theme-root></template><script lang="uts">import {akI18n} from '../../../src/core/i18n/ak-i18n.uts';export default{data(){return{reason:''}},computed:{t(){return akI18n.t},title(){return akI18n.t(this.reason==='app_config_mismatch'?'state.appConfigMismatch.title':'state.offline.title',null)}},onLoad(options:UTSJSONObject){const value=options.getString('reason');this.reason=value!=null?value:''},methods:{retry(){uni.reLaunch({url:'/pages/bootstrap/index'})}}}</script><style lang="scss">.page{flex:1;background:var(--ak-page);justify-content:center;padding:20px}.error-card{background:var(--ak-surface);border:1px solid var(--ak-border);border-radius:18px}</style>
