<template><ak-theme-root><view class="page"><view class="error-card"><ak-empty-state :title="t('state.offline.title', null)"><ak-button class="error-action" variant="secondary" @click="retry">{{t('common.retry', null)}}</ak-button></ak-empty-state></view></view></ak-theme-root></template><script lang="uts">import {akI18n} from '../../../src/core/i18n/ak-i18n.uts';export default{computed:{t(){return akI18n.t}},methods:{retry(){uni.reLaunch({url:'/pages/bootstrap/index'})}}}</script><style lang="scss">.page{flex:1;background:var(--ak-page);justify-content:center;padding:20px}.error-card{background:var(--ak-surface);border:1px solid var(--ak-border);border-radius:18px}.error-action{margin-top:20px;min-width:140px}</style>
