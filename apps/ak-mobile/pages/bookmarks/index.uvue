<template>
  <ak-theme-root
    ><scroll-view class="page" scroll-y
      ><view class="nav"
        ><ak-back-button /><text class="nav-title">{{
          t("profile.bookmarks", null)
        }}</text
        ><view class="space" /></view
      ><ak-text-field
        v-model="query"
        :label="t('information.searchBookmarks', null)"
        @confirm="reload" /><scroll-view class="types" scroll-x
        ><view class="row"
          ><view
            v-for="type in types"
            :key="type"
            class="filter"
            :class="{ active: selectedType === type }"
            @click="select(type)"
            ><text>{{ typeName(type) }}</text></view
          ></view
        ></scroll-view
      ><ak-status-view
        v-if="state !== 'content'"
        :state="state"
        :title="stateTitle"
        :description="t('information.state.description', null)"
        @retry="reload" /><section-list
        v-else
        :title="t('profile.bookmarks', null)"
        :items="items"
        @open="open" /></scroll-view
  ></ak-theme-root>
</template>
<script lang="uts">
import{akI18n}from'../../src/core/i18n/ak-i18n.uts';import{articleRuntime}from'../../src/features/articles/infrastructure/article-runtime.uts';import{ArticlePage,ArticleQuery,ArticleSummary}from'../../src/features/articles/domain/models.uts';import{navigateArticleDetail}from'../../src/core/navigation/app-routes.uts';export default{data(){return{state:'loading',query:'',selectedType:'',types:['','article','gallery','video']as Array<string>,items:[]as Array<ArticleSummary>}},computed:{t(){return akI18n.t},stateTitle():string{return akI18n.t(this.state==='empty'?'state.empty.title':this.state==='offline'?'state.offline.title':'state.error.title',null)}},onLoad(){this.reload()},methods:{typeName(x:string):string{return x.length==0?akI18n.t('information.all',null):akI18n.t('information.type.'+x,null)},select(x:string){this.selectedType=x;this.reload()},reload(){const repo=articleRuntime.getRepository();if(repo==null){this.state='error';return};const request:ArticleQuery={query:this.query.trim().length>0?this.query.trim():null,category:null,topic:null,tag:null,contentType:this.selectedType.length>0?this.selectedType:null,featured:null,cursor:null,limit:50};repo.listBookmarks(request,(page:ArticlePage)=>{this.items=page.items;this.state=page.items.length==0?'empty':'content'},error=>{this.state=error.kind==='network_unavailable'?'offline':'error'})},open(slug:string){navigateArticleDetail(slug)}}}
</script>
<style lang="scss">
.page {
  height: 100%;
  background: var(--ak-page);
  padding: 0 20px 48px;
}
.nav {
  height: 56px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.nav-title {
  font-size: 17px;
  font-weight: 600;
  color: var(--ak-text);
}
.space {
  width: 44px;
}
.types {
  margin: 12px 0;
}
.row {
  flex-direction: row;
}
.filter {
  min-height: 44px;
  padding: 0 16px;
  border-radius: 22px;
  background: var(--ak-surface);
  margin-right: 8px;
  justify-content: center;
}
.active {
  background: var(--ak-brand);
  color: #fff;
}
</style>
