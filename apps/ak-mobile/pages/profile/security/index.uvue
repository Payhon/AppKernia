<template><ak-theme-root><scroll-view class="page" scroll-y><view class="nav"><ak-back-button/><text class="nav-title">{{t('routes.profile.security.title', null)}}</text><view class="nav-slot"/></view><ak-cell-list class="action-list"><view class="row" @click="open('/pages/profile/change-password/index')"><view class="row-lead"><view class="icon-well"><ak-icon name="security"/></view><text>{{t('profile.changePassword', null)}}</text></view><ak-icon name="chevron-right"/></view><view class="row" @click="open('/pages/profile/sessions/index')"><view class="row-lead"><view class="icon-well icon-well--session"><ak-icon name="profile"/></view><text>{{t('profile.sessions', null)}}</text></view><ak-icon name="chevron-right"/></view><view class="row" @click="open('/pages/profile/devices/index')"><view class="row-lead"><view class="icon-well icon-well--device"><ak-icon name="device"/></view><text>{{t('profile.devices', null)}}</text></view><ak-icon name="chevron-right"/></view></ak-cell-list><text class="section">{{t('profile.securityEvents', null)}}</text><ak-status-view v-if="state!=='content'" :state="state" :title="stateTitle" :loading-label="t('common.loading', null)" :retry-label="t('common.retry', null)" @retry="reload"/><ak-cell-list v-else class="event-list"><view v-for="item in events" :key="item.id" class="event"><text class="event-title">{{item.eventType}}</text><text class="event-time">{{item.occurredAt}}</text></view></ak-cell-list></scroll-view></ak-theme-root></template>
<script lang="uts">import {HttpCancellation} from '../../../src/core/network/http-port.uts';import{akI18n}from'../../../src/core/i18n/ak-i18n.uts';import{profileRuntime}from'../../../src/features/profile/infrastructure/profile-runtime.uts';import{SecurityEvent}from'../../../src/features/profile/domain/models.uts';let task:HttpCancellation|null=null;export default{data(){return{state:'loading',events:[] as Array<SecurityEvent>}},computed:{t(){return akI18n.t},stateTitle(){return akI18n.t(this.state==='empty'?'state.empty.title':'state.error.title',null)}},onLoad(){this.reload()},onUnload(){const activeTask=task;if(activeTask!=null)activeTask.cancel()},methods:{open(url:string){uni.navigateTo({url})},reload(){const r=profileRuntime.getRepository();if(r==null){this.state='error';return}this.state='loading';task=r.securityEvents(x=>{this.events=x;this.state=x.length>0?'content':'empty'},()=>{this.state='error'})}}}</script>
<style lang="scss">.page{height:100%;flex:1;padding:16px 20px 32px;background:var(--ak-page)}.nav,.row,.row-lead{flex-direction:row;align-items:center}.nav,.row{justify-content:space-between}.nav{height:44px;margin-bottom:20px}.nav-title{color:var(--ak-text);font-size:17px;font-weight:600}.nav-slot{width:44px;height:44px}.action-list,.event-list{border-radius:18px}.row{min-height:60px;padding:0 16px;border-bottom:1px solid var(--ak-border)}.row-lead{flex:1;color:var(--ak-text);font-size:16px;font-weight:500}.icon-well{width:32px;height:32px;border-radius:10px;background:var(--ak-accent-surface);align-items:center;justify-content:center;margin-right:12px}.icon-well--session,.icon-well--device{background:var(--ak-accent-surface)}.section{font-size:20px;font-weight:600;margin:28px 0 12px;color:var(--ak-text)}.event{min-height:64px;padding:12px 16px;border-bottom:1px solid var(--ak-border)}.event-title{color:var(--ak-text);font-size:16px;font-weight:500}.event-time{color:var(--ak-muted);font-size:13px;margin-top:4px}</style>
