<template><ak-theme-root><scroll-view class="page" scroll-y><view class="nav"><ak-back-button/><text>{{t('routes.profile.security.title', null)}}</text><view/></view><ak-cell-list><view class="row" @click="open('/pages/profile/change-password/index')"><text>{{t('profile.changePassword', null)}}</text><ak-icon name="chevron-right"/></view><view class="row" @click="open('/pages/profile/sessions/index')"><text>{{t('profile.sessions', null)}}</text><ak-icon name="chevron-right"/></view><view class="row" @click="open('/pages/profile/devices/index')"><text>{{t('profile.devices', null)}}</text><ak-icon name="chevron-right"/></view></ak-cell-list><text class="section">{{t('profile.securityEvents', null)}}</text><ak-status-view v-if="state!=='content'" :state="state" :title="stateTitle" :loading-label="t('common.loading', null)" :retry-label="t('common.retry', null)" @retry="reload"/><ak-cell-list v-else><view v-for="item in events" :key="item.id" class="event"><text>{{item.eventType}}</text><text>{{item.occurredAt}}</text></view></ak-cell-list></scroll-view></ak-theme-root></template>
<script lang="uts">import {HttpCancellation} from '../../../src/core/network/http-port.uts';import{akI18n}from'../../../src/core/i18n/ak-i18n.uts';import{profileRuntime}from'../../../src/features/profile/infrastructure/profile-runtime.uts';import{SecurityEvent}from'../../../src/features/profile/domain/models.uts';let task:HttpCancellation|null=null;export default{data(){return{state:'loading',events:[] as Array<SecurityEvent>}},computed:{t(){return akI18n.t},stateTitle(){return akI18n.t(this.state==='empty'?'state.empty.title':'state.error.title',null)}},onLoad(){this.reload()},onUnload(){const activeTask=task;if(activeTask!=null)activeTask.cancel()},methods:{open(url:string){uni.navigateTo({url})},reload(){const r=profileRuntime.getRepository();if(r==null){this.state='error';return}this.state='loading';task=r.securityEvents(x=>{this.events=x;this.state=x.length>0?'content':'empty'},()=>{this.state='error'})}}}</script>
<style lang="scss">.page{height:100%;flex:1;padding:16px;background:var(--ak-page)}.nav,.row{flex-direction:row;align-items:center}.nav,.row{justify-content:space-between}.nav{height:48px}.row,.event{min-height:58px;border-bottom:1px solid var(--ak-border)}.section{font-size:18px;margin-top:20px;color:var(--ak-text)}</style>
