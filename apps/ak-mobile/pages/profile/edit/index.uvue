<template><ak-theme-root><scroll-view class="page" scroll-y><view class="nav"><ak-back-button/><text>{{t('routes.profile.edit.title', null)}}</text><view/></view><ak-status-view v-if="state==='loading'" state="loading" :loading-label="t('common.loading', null)"/><view v-else><ak-text-field v-model="displayName" :label="t('profile.displayName', null)" :error="nameError"/><ak-text-field :model-value="email" :label="t('profile.email', null)" disabled/><ak-text-field v-model="timeZone" :label="t('profile.timeZone', null)"/><ak-button variant="primary" :loading="mutating" :loading-text="t('state.mutating', null)" @click="save">{{t('common.save', null)}}</ak-button></view></scroll-view></ak-theme-root></template>
<script lang="uts">import {HttpCancellation} from '../../../src/core/network/http-port.uts';import {akI18n} from '../../../src/core/i18n/ak-i18n.uts';import {profileRuntime} from '../../../src/features/profile/infrastructure/profile-runtime.uts';let task:HttpCancellation|null=null;export default{data(){return{state:'loading',displayName:'',email:'',timeZone:'',locale:'zh-CN',nameError:'',mutating:false}},computed:{t(){return akI18n.t}},onLoad(){this.load()},onUnload(){const activeTask=task;if(activeTask!=null)activeTask.cancel()},methods:{load(){const repo=profileRuntime.getRepository();if(repo==null){this.state='error';return}task=repo.profile(x=>{this.displayName=x.displayName;this.email=x.email;this.timeZone=x.timeZone;this.locale=x.locale;this.state='content'},()=>{this.state='error'})},save(){if(this.displayName.length==0){this.nameError=akI18n.t('errors.validation.required', null);return}const repo=profileRuntime.getRepository();if(repo==null)return;this.mutating=true;task=repo.update({displayName:this.displayName,locale:this.locale,timeZone:this.timeZone},()=>{this.mutating=false;uni.redirectTo({url:'/pages/profile/basic/index'})},()=>{this.mutating=false})}}}</script>
<style lang="scss">.page{height:100%;flex:1;padding:16px;background:var(--ak-page)}.nav{height:48px;flex-direction:row;align-items:center;justify-content:space-between}</style>
