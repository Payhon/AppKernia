<template><ak-theme-root><scroll-view class="page" scroll-y><view class="nav"><ak-back-button/><text class="nav-title">{{t('routes.profile.changePassword.title', null)}}</text><view class="nav-slot"/></view><ak-card class="form-card"><ak-text-field v-model="currentPassword" :label="t('profile.currentPassword', null)" password/><ak-text-field v-model="newPassword" :label="t('profile.newPassword', null)" password/><ak-text-field v-model="confirmation" :label="t('profile.confirmPassword', null)" :error="errorText" password/></ak-card><ak-button class="submit-button" variant="primary" :loading="mutating" :loading-text="t('state.mutating', null)" @click="submit">{{t('common.save', null)}}</ak-button></scroll-view></ak-theme-root></template><script lang="uts">import {HttpCancellation} from '../../../src/core/network/http-port.uts';import{akI18n}from'../../../src/core/i18n/ak-i18n.uts';import{profileRuntime}from'../../../src/features/profile/infrastructure/profile-runtime.uts';let task:HttpCancellation|null=null;export default{data(){return{currentPassword:'',newPassword:'',confirmation:'',errorText:'',mutating:false}},computed:{t(){return akI18n.t}},onUnload(){const activeTask=task;if(activeTask!=null)activeTask.cancel()},methods:{submit(){if(this.newPassword!==this.confirmation){this.errorText=akI18n.t('errors.validation.passwordMismatch', null);return}const repo=profileRuntime.getRepository();if(repo==null)return;this.mutating=true;task=repo.changePassword({currentPassword:this.currentPassword,newPassword:this.newPassword},()=>{this.mutating=false;uni.showToast({title:akI18n.t('profile.passwordChanged', null),icon:'success'});uni.redirectTo({url:'/pages/profile/security/index'})},e=>{this.mutating=false;this.errorText=akI18n.t(e.messageKey, null)})}}}</script><style lang="scss">.page{height:100%;flex:1;padding:16px 20px 32px;background:var(--ak-page)}.nav{height:44px;flex-direction:row;align-items:center;justify-content:space-between;margin-bottom:20px}.nav-title{color:var(--ak-text);font-size:17px;font-weight:600}.nav-slot{width:44px;height:44px}.form-card{padding:20px;border-radius:18px}.submit-button{margin-top:20px}</style>
