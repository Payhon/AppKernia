<template><ak-theme-root><scroll-view class="page" scroll-y><view class="topbar"><text class="brand">AppKernia</text><view class="notification" @click="go('notifications.list')"><ak-icon name="bell"/><text v-if="unreadCount>0" class="badge">{{unreadCount}}</text></view></view><ak-status-view v-if="state!=='content'" :state="state" :title="stateTitle" :loading-label="t('common.loading', null)" :retry-label="t('common.retry', null)" @retry="reload"/><view v-else><text class="page-title">{{t('profile.title', null)}}</text><ak-card class="identity" @click="go('profile.basic')"><view class="avatar"><text>{{initials}}</text></view><view class="copy"><text>{{displayName}}</text><text>{{email}}</text></view><ak-icon name="chevron-right"/></ak-card><ak-cell-list class="menu-group"><view class="row" @click="go('profile.basic')"><view class="row-lead"><ak-icon name="profile"/><text>{{t('profile.basic', null)}}</text></view><ak-icon name="chevron-right"/></view><view class="row" @click="go('profile.security')"><view class="row-lead"><ak-icon name="security"/><text>{{t('profile.security', null)}}</text></view><ak-icon name="chevron-right"/></view><view class="row" @click="go('profile.devices')"><view class="row-lead"><ak-icon name="device"/><text>{{t('profile.devices', null)}}</text></view><ak-icon name="chevron-right"/></view></ak-cell-list><ak-cell-list class="menu-group"><view class="row" @click="go('settings.notifications')"><view class="row-lead"><ak-icon name="bell"/><text>{{t('profile.notifications', null)}}</text></view><ak-icon name="chevron-right"/></view><view class="row" @click="go('settings.language')"><view class="row-lead"><ak-icon name="settings"/><text>{{t('profile.languageAppearance', null)}}</text></view><ak-icon name="chevron-right"/></view><view class="row" @click="go('settings.appearance')"><view class="row-lead"><ak-icon name="settings"/><text>{{t('settings.appearance', null)}}</text></view><ak-icon name="chevron-right"/></view><view class="row" @click="go('help')"><view class="row-lead"><ak-icon name="help"/><text>{{t('profile.helpAbout', null)}}</text></view><ak-icon name="chevron-right"/></view><view class="row" @click="go('about')"><view class="row-lead"><ak-icon name="help"/><text>{{t('routes.about.title', null)}}</text></view><ak-icon name="chevron-right"/></view></ak-cell-list><ak-button class="sign-out" variant="danger" @click="signOut">{{t('common.signOut', null)}}</ak-button></view></scroll-view></ak-theme-root></template>
<script lang="uts">import {HttpCancellation} from '../../src/core/network/http-port.uts';import {akI18n} from '../../src/core/i18n/ak-i18n.uts';import {profileRuntime} from '../../src/features/profile/infrastructure/profile-runtime.uts';import {akNavigator,authenticatedNavigationContext} from '../../src/core/navigation/app-routes.uts';import {authRuntime} from '../../src/features/auth/auth-runtime.uts';let profileTask:HttpCancellation|null=null;let unreadTask:HttpCancellation|null=null;export default{data(){return{state:'loading',displayName:'',email:'',initials:'',unreadCount:0}},computed:{t(){return akI18n.t},stateTitle(){return akI18n.t(this.state==='offline'?'state.offline.title':'state.error.title',null)}},onLoad(){this.reload()},onUnload(){const activeProfile=profileTask;if(activeProfile!=null)activeProfile.cancel();const activeUnread=unreadTask;if(activeUnread!=null)activeUnread.cancel()},methods:{reload(){const repo=profileRuntime.getRepository();if(repo==null){this.state='error';return}this.state='loading';profileTask=repo.profile(x=>{this.displayName=x.displayName;this.email=x.email;this.initials=x.displayName.substring(0,1);this.state='content'},e=>{this.state=e.kind==='network_unavailable'?'offline':'error'});unreadTask=repo.unreadCount(x=>{this.unreadCount=x},()=>{})},go(key:string){akNavigator.navigate(key,authenticatedNavigationContext())},signOut(){authRuntime.signOut(()=>{uni.reLaunch({url:'/pages/auth/login/index'})})}}}</script>
<style lang="scss">.page{height:100%;flex:1;background:var(--ak-page);padding:24px 16px}.topbar,.identity,.row,.row-lead{flex-direction:row;align-items:center}.topbar,.row{justify-content:space-between}.brand{font-size:28px;font-weight:700;color:var(--ak-text)}.notification{position:relative;width:44px;height:44px;align-items:center;justify-content:center}.badge{position:absolute;right:0;top:0;background:var(--ak-danger);color:var(--ak-on-danger);border-radius:10px;font-size:12px}.page-title{font-size:30px;color:var(--ak-text);margin:24px 0}.identity{margin-bottom:16px}.avatar{width:64px;height:64px;border-radius:32px;background:var(--ak-brand);align-items:center;justify-content:center;color:var(--ak-on-brand)}.copy{flex:1;margin-left:12px;color:var(--ak-text)}.menu-group{margin-bottom:16px}.row{min-height:58px;padding:0 12px;border-bottom:1px solid var(--ak-border)}.row-lead{color:var(--ak-text);font-size:16px}.sign-out{margin-top:8px}</style>
