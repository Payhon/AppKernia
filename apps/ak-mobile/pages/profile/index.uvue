  font-size: 18px;
  font-weight: 700;
  color: var(--ak-text);
}
.identity-email {
  font-size: 14px;
  color: var(--ak-muted);
  margin-top: 4px;
}
.menu-group {
  margin-bottom: 16px;
}
.row {
  min-height: 60px;
  padding: 0 16px;
  border-bottom: 1px solid var(--ak-border);
}
.row-lead {
  font-size: 16px;
  color: var(--ak-text);
}
.row-label {
  margin-left: 12px;
}
.sign-out {
  margin-top: 8px;
}
</style>
