<template>
  <ak-theme-root
    ><scroll-view class="page" scroll-y
      ><view class="topbar"
        ><text class="brand">{{ t("information.appName", null) }}</text
        ><ak-icon-button
          class="notification"
          name="bell"
          :icon-size="20"
          :label="t('routes.notifications.title', null)"
          @click="protectedGo('/pages/notifications/index')"
        /></view
      ><text class="page-title">{{ t("profile.title", null) }}</text
      ><view class="identity-action" role="button" :aria-label="t('routes.profile.basic.title', null)" @click="identity"
        ><ak-card class="identity"
          ><ak-avatar :src="avatarPath" :fallback="guest ? '?' : initials" :label="t('profile.avatar.alt', avatarParams)" :size="60" />
          <view class="identity-copy"
          ><text class="identity-name">{{
            guest ? t("profile.guest", null) : displayName
          }}</text
          ><text class="identity-email">{{
            guest ? t("profile.guestHint", null) : email
          }}</text></view
          ><ak-icon name="chevron-right" /></ak-card
        ></view
      ><ak-cell-list class="menu-group"
        ><view class="row" role="button" :aria-label="t('profile.bookmarks', null)" @click="protectedGo('/pages/bookmarks/index')"
          ><view class="row-lead"
            ><ak-icon name="bookmark" /><text class="row-label">{{
              t("profile.bookmarks", null)
            }}</text></view
          ><ak-icon name="chevron-right" /></view
        ><view class="row" role="button" :aria-label="t('profile.notifications', null)" @click="protectedGo('/pages/settings/notifications/index')"
          ><view class="row-lead"
            ><ak-icon name="bell" /><text class="row-label">{{
              t("profile.notifications", null)
            }}</text></view
          ><ak-icon name="chevron-right" /></view
        ><view class="row" @click="protectedGo('/pages/profile/security/index')"
          ><view class="row-lead"
            ><ak-icon name="security" /><text class="row-label">{{
              t("profile.security", null)
            }}</text></view
          ><ak-icon name="chevron-right" /></view
        ><view class="row" @click="publicGo('/pages/settings/language/index')"
          ><view class="row-lead"
            ><ak-icon name="language" /><text class="row-label">{{
              t("profile.languageAppearance", null)
            }}</text></view
          ><ak-icon name="chevron-right" /></view
        ><view class="row" @click="protectedGo('/pages/settings/permissions/index')"
          ><view class="row-lead"
            ><ak-icon name="settings" /><text class="row-label">{{
              t("profile.appPermissions", null)
            }}</text></view
          ><ak-icon name="chevron-right" /></view
        ><view class="row" @click="publicGo('/pages/help/index')"
          ><view class="row-lead"
            ><ak-icon name="help" /><text class="row-label">{{
              t("profile.helpAbout", null)
            }}</text></view
          ><ak-icon name="chevron-right" /></view></ak-cell-list
      ></scroll-view
    ><view v-if="!guest" class="profile-actions"
      ><ak-button
        class="sign-out"
        variant="danger"
        @click="signOut"
        >{{ t("common.signOut", null) }}</ak-button
      ><view v-if="accountDeletionEnabled" class="delete-account-link" role="button" :aria-label="t('profile.deleteAccount', null)" @click="deleteAccount"
        ><text class="delete-account-text">{{ t('profile.deleteAccount', null) }}</text></view
      ></view
    ><ak-auth-prompt
      :open="authOpen"
      @close="authOpen = false"
      @authenticated="authenticated"
  /></ak-theme-root>
</template>
<script lang="uts">
import{akI18n}from'../../src/core/i18n/ak-i18n.uts';import{HttpCancellation}from'../../src/core/network/http-port.uts';import{profileRuntime}from'../../src/features/profile/infrastructure/profile-runtime.uts';import{authRuntime}from'../../src/features/auth/auth-runtime.uts';import{appSessionStore}from'../../src/core/stores/session-store.uts';import{authContextStore}from'../../src/core/stores/auth-context-store.uts';import{akNavigator,authenticatedNavigationContext}from'../../src/core/navigation/app-routes.uts';import{pushCoordinator}from'../../src/features/push/application/push-coordinator.uts';let avatarTask:HttpCancellation|null=null;export default{data(){return{guest:true,authOpen:false,accountDeletionEnabled:false,displayName:'',email:'',initials:'',avatarPath:''}},computed:{t(){return akI18n.t},avatarParams(){return new Map<string,string>([['name',this.guest?akI18n.t('profile.guest',null):this.displayName]])}},onShow(){this.reload()},onUnload(){if(avatarTask!=null)avatarTask!.cancel()},methods:{reload(){this.guest=appSessionStore.getAccessToken()==null;this.accountDeletionEnabled=!this.guest&&authContextStore.hasEnabledFlag('account_deletion');if(this.guest){this.avatarPath='';return};authRuntime.refreshContext(()=>{this.accountDeletionEnabled=!this.guest&&authContextStore.hasEnabledFlag('account_deletion')},()=>{});const repo=profileRuntime.getRepository();if(repo==null)return;repo.profile(x=>{this.displayName=x.displayName;this.email=x.email;this.initials=x.displayName.substring(0,1);this.loadAvatar(x.avatarUrl)},error=>{if(error.kind==='unauthorized'){this.guest=true;this.accountDeletionEnabled=false;this.avatarPath='';this.authOpen=true}})},loadAvatar(path:string|null){if(avatarTask!=null)avatarTask!.cancel();this.avatarPath='';if(path==null)return;const loader=profileRuntime.getAvatarLoader();if(loader==null)return;avatarTask=loader.load(path,value=>{this.avatarPath=value},()=>{})},identity(){if(this.guest){this.authOpen=true;return};this.publicGo('/pages/profile/basic/index')},protectedGo(url:string){if(this.guest){this.authOpen=true;return};this.publicGo(url)},publicGo(url:string){uni.navigateTo({url:url})},deleteAccount(){akNavigator.navigate('account.deletion',authenticatedNavigationContext())},authenticated(){this.authOpen=false;this.reload()},signOut(){pushCoordinator.disableActive(()=>{authRuntime.signOut(()=>{this.guest=true;this.accountDeletionEnabled=false;this.displayName='';this.email='';this.initials='';this.avatarPath=''})})}}}
</script>
<style lang="scss">
.page {
  flex: 1;
  height: auto;
  background: var(--ak-page);
  padding: 16px 20px;
}
.topbar,
.identity,
.row,
.row-lead {
  flex-direction: row;
  align-items: center;
}
.topbar,
.row {
  justify-content: space-between;
}
.topbar {
  min-height: 44px;
}
.brand {
  font-size: 20px;
  font-weight: 700;
  color: var(--ak-brand);
}
.notification {
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
}
.page-title {
  font-size: 34px;
  font-weight: 800;
  color: var(--ak-text);
  margin: 24px 0 16px;
}
.identity {
  padding: 18px;
  min-height: 92px;
}
.identity-action {
  margin-bottom: 20px;
}
.identity-copy {
  flex: 1;
  margin-left: 14px;
}
.identity-name {
  font-size: 18px;
  font-weight: 700;
  color: var(--ak-text);
}
.identity-email {
  font-size: 14px;
  color: var(--ak-muted);
  margin-top: 4px;
}
.menu-group {
  margin-bottom: 16px;
}
.row {
  min-height: 60px;
  padding: 0 16px;
  border-bottom: 1px solid var(--ak-border);
}
.row-lead {
  font-size: 16px;
  color: var(--ak-text);
}
.row-label {
  margin-left: 12px;
}
.sign-out {
  margin-top: 0;
}
.profile-actions {
  flex-shrink: 0;
  padding: 8px 20px 12px;
  background: var(--ak-page);
}
.delete-account-link {
  min-height: 44px;
  margin-top: 8px;
  align-items: center;
  justify-content: center;
}
.delete-account-text {
  color: var(--ak-danger);
  font-size: 15px;
  line-height: 22px;
  text-decoration-line: underline;
}
</style>
