  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
}
.page-title {
  font-size: 34px;
  font-weight: 800;
  color: var(--ak-text);
  margin: 24px 0 16px;
}
.identity {
  padding: 18px;
  margin-bottom: 20px;
  min-height: 92px;
}
.avatar {
  width: 60px;
  height: 60px;
  border-radius: 30px;
  background: var(--ak-brand);
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22px;
  font-weight: 700;
}
.avatar-guest {
  background: #c7c7cc;
  color: #fff;
}
.identity-copy {
  flex: 1;
  margin-left: 14px;
}
