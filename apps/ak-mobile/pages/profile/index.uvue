<template>
  <ak-theme-root
    ><scroll-view class="page" scroll-y
      ><view class="topbar"
        ><text class="brand">{{ t("information.appName", null) }}</text
        ><view
          class="notification"
          @click="protectedGo('/pages/notifications/index')"
          ><ak-icon name="bell" /></view></view
      ><text class="page-title">{{ t("profile.title", null) }}</text
      ><ak-card class="identity" @click="identity"
        ><view class="avatar" :class="{ 'avatar-guest': guest }"
          ><text>{{ guest ? "?" : initials }}</text></view
        ><view class="identity-copy"
          ><text class="identity-name">{{
            guest ? t("profile.guest", null) : displayName
          }}</text
          ><text class="identity-email">{{
            guest ? t("profile.guestHint", null) : email
          }}</text></view
        ><ak-icon name="chevron-right" /></ak-card
      ><ak-cell-list class="menu-group"
        ><view class="row" @click="protectedGo('/pages/bookmarks/index')"
          ><view class="row-lead"
            ><ak-icon name="bookmark" /><text class="row-label">{{
              t("profile.bookmarks", null)
            }}</text></view
          ><ak-icon name="chevron-right" /></view
        ><view class="row" @click="protectedGo('/pages/notifications/index')"
          ><view class="row-lead"
            ><ak-icon name="bell" /><text class="row-label">{{
              t("profile.notifications", null)
            }}</text></view
          ><ak-icon name="chevron-right" /></view
        ><view class="row" @click="protectedGo('/pages/profile/security/index')"
          ><view class="row-lead"
            ><ak-icon name="security" /><text class="row-label">{{
              t("profile.security", null)
            }}</text></view
          ><ak-icon name="chevron-right" /></view
        ><view class="row" @click="publicGo('/pages/settings/language/index')"
          ><view class="row-lead"
            ><ak-icon name="settings" /><text class="row-label">{{
              t("profile.languageAppearance", null)
            }}</text></view
          ><ak-icon name="chevron-right" /></view
        ><view class="row" @click="protectedGo('/pages/settings/permissions/index')"
          ><view class="row-lead"
            ><ak-icon name="settings" /><text class="row-label">{{
              t("profile.appPermissions", null)
            }}</text></view
          ><ak-icon name="chevron-right" /></view
        ><view class="row" @click="publicGo('/pages/help/index')"
          ><view class="row-lead"
            ><ak-icon name="help" /><text class="row-label">{{
              t("profile.helpAbout", null)
            }}</text></view
          ><ak-icon name="chevron-right" /></view></ak-cell-list
      ><ak-button
        v-if="!guest"
        class="sign-out"
        variant="danger"
        @click="signOut"
        >{{ t("common.signOut", null) }}</ak-button
      ></scroll-view
    ><ak-auth-prompt
      :open="authOpen"
      @close="authOpen = false"
      @authenticated="authenticated"
  /></ak-theme-root>
</template>
<script lang="uts">
import{akI18n}from'../../src/core/i18n/ak-i18n.uts';import{profileRuntime}from'../../src/features/profile/infrastructure/profile-runtime.uts';import{authRuntime}from'../../src/features/auth/auth-runtime.uts';import{appSessionStore}from'../../src/core/stores/session-store.uts';import{pushCoordinator}from'../../src/features/push/application/push-coordinator.uts';export default{data(){return{guest:true,authOpen:false,displayName:'',email:'',initials:''}},computed:{t(){return akI18n.t}},onShow(){this.reload()},methods:{reload(){this.guest=appSessionStore.getAccessToken()==null;if(this.guest)return;const repo=profileRuntime.getRepository();if(repo==null)return;repo.profile(x=>{this.displayName=x.displayName;this.email=x.email;this.initials=x.displayName.substring(0,1)},error=>{if(error.kind==='unauthorized'){this.guest=true;this.authOpen=true}})},identity(){if(this.guest){this.authOpen=true;return};this.publicGo('/pages/profile/basic/index')},protectedGo(url:string){if(this.guest){this.authOpen=true;return};this.publicGo(url)},publicGo(url:string){uni.navigateTo({url:url})},authenticated(){this.authOpen=false;this.reload()},signOut(){pushCoordinator.disableActive(()=>{authRuntime.signOut(()=>{this.guest=true;this.displayName='';this.email='';this.initials=''})})}}}
</script>
<style lang="scss">
