<template><ak-theme-root><scroll-view class="page" scroll-y><view class="topbar"><text class="brand">AppKernia</text><view class="notification" @click="go('notifications.list')"><ak-icon name="bell"/><text v-if="unreadCount>0" class="badge">{{unreadCount}}</text></view></view><ak-status-view v-if="state!=='content'" :state="state" :title="stateTitle" :loading-label="t('common.loading', null)" :retry-label="t('common.retry', null)" @retry="reload"/><view v-else><text class="page-title">{{t('profile.title', null)}}</text><ak-card class="identity" @click="go('profile.basic')"><view class="avatar"><text>{{initials}}</text></view><view class="identity-copy"><text class="identity-name">{{displayName}}</text><text class="identity-email">{{email}}</text></view><ak-icon name="chevron-right"/></ak-card><ak-cell-list class="menu-group"><view class="row" @click="go('profile.basic')"><view class="row-lead"><view class="icon-well"><ak-icon name="profile"/></view><text>{{t('profile.basic', null)}}</text></view><ak-icon name="chevron-right"/></view><view class="row" @click="go('profile.security')"><view class="row-lead"><view class="icon-well icon-well--security"><ak-icon name="security"/></view><text>{{t('profile.security', null)}}</text></view><ak-icon name="chevron-right"/></view><view class="row" @click="go('profile.devices')"><view class="row-lead"><view class="icon-well icon-well--device"><ak-icon name="device"/></view><text>{{t('profile.devices', null)}}</text></view><ak-icon name="chevron-right"/></view></ak-cell-list><ak-cell-list class="menu-group"><view class="row" @click="go('settings.notifications')"><view class="row-lead"><view class="icon-well icon-well--notification"><ak-icon name="bell"/></view><text>{{t('profile.notifications', null)}}</text></view><ak-icon name="chevron-right"/></view><view class="row" @click="go('settings.language')"><view class="row-lead"><view class="icon-well icon-well--settings"><ak-icon name="settings"/></view><text>{{t('profile.languageAppearance', null)}}</text></view><ak-icon name="chevron-right"/></view><view class="row" @click="go('settings.appearance')"><view class="row-lead"><view class="icon-well icon-well--settings"><ak-icon name="settings"/></view><text>{{t('settings.appearance', null)}}</text></view><ak-icon name="chevron-right"/></view><view class="row" @click="go('help')"><view class="row-lead"><view class="icon-well icon-well--help"><ak-icon name="help"/></view><text>{{t('profile.helpAbout', null)}}</text></view><ak-icon name="chevron-right"/></view><view class="row" @click="go('about')"><view class="row-lead"><view class="icon-well icon-well--about"><ak-icon name="help"/></view><text>{{t('routes.about.title', null)}}</text></view><ak-icon name="chevron-right"/></view></ak-cell-list><ak-button class="sign-out" variant="danger" @click="signOut">{{t('common.signOut', null)}}</ak-button></view></scroll-view></ak-theme-root></template>
<script lang="uts">import {HttpCancellation} from '../../src/core/network/http-port.uts';import {akI18n} from '../../src/core/i18n/ak-i18n.uts';import {NavigationLocaleSync} from '../../src/core/i18n/navigation-sync.uts';import {profileRuntime} from '../../src/features/profile/infrastructure/profile-runtime.uts';import {akNavigator,authenticatedNavigationContext} from '../../src/core/navigation/app-routes.uts';import {authRuntime} from '../../src/features/auth/auth-runtime.uts';let profileTask:HttpCancellation|null=null;let unreadTask:HttpCancellation|null=null;export default{data(){return{state:'loading',displayName:'',email:'',initials:'',unreadCount:0}},computed:{t(){return akI18n.t},stateTitle(){return akI18n.t(this.state==='offline'?'state.offline.title':'state.error.title',null)}},onLoad(){this.reload()},onShow(){new NavigationLocaleSync(akI18n).apply(akI18n.getLocale(),'routes.profile.title')},onUnload(){const activeProfile=profileTask;if(activeProfile!=null)activeProfile.cancel();const activeUnread=unreadTask;if(activeUnread!=null)activeUnread.cancel()},methods:{reload(){const repo=profileRuntime.getRepository();if(repo==null){this.state='error';return}this.state='loading';profileTask=repo.profile(x=>{this.displayName=x.displayName;this.email=x.email;this.initials=x.displayName.substring(0,1);this.state='content'},e=>{this.state=e.kind==='network_unavailable'?'offline':'error'});unreadTask=repo.unreadCount(x=>{this.unreadCount=x},()=>{})},go(key:string){akNavigator.navigate(key,authenticatedNavigationContext())},signOut(){authRuntime.signOut(()=>{uni.reLaunch({url:'/pages/auth/login/index'})})}}}</script>
<style lang="scss">.page{height:100%;flex:1;background:var(--ak-page);padding:16px 20px 32px}.topbar,.identity,.row,.row-lead{flex-direction:row;align-items:center}.topbar,.row{justify-content:space-between}.topbar{min-height:44px}.brand{font-size:20px;font-weight:700;color:var(--ak-text)}.notification{position:relative;width:44px;height:44px;align-items:center;justify-content:center}.badge{position:absolute;right:1px;top:1px;min-width:18px;height:18px;background:var(--ak-danger);color:var(--ak-on-danger);border-radius:9px;font-size:11px;text-align:center}.page-title{font-size:32px;font-weight:700;color:var(--ak-text);margin:20px 0 16px}.identity{padding:16px;margin-bottom:20px;min-height:80px;border-radius:18px}.avatar{width:56px;height:56px;border-radius:28px;background:var(--ak-brand);align-items:center;justify-content:center;color:var(--ak-on-brand);font-size:20px;font-weight:600}.identity-copy{flex:1;margin-left:14px}.identity-name{color:var(--ak-text);font-size:17px;font-weight:600}.identity-email{color:var(--ak-muted);font-size:14px;margin-top:4px}.menu-group{margin-bottom:16px;border-radius:18px}.row{min-height:60px;padding:0 16px;border-bottom:1px solid var(--ak-border)}.row-lead{flex:1;color:var(--ak-text);font-size:16px;font-weight:500}.icon-well{width:32px;height:32px;border-radius:10px;background:var(--ak-accent-surface);align-items:center;justify-content:center;margin-right:12px}.icon-well--security,.icon-well--device,.icon-well--notification,.icon-well--settings,.icon-well--help,.icon-well--about{background:var(--ak-accent-surface)}.sign-out{margin:4px 0 20px}</style>
