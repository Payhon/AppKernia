<template><ak-theme-root><scroll-view class="page" scroll-y><view class="nav"><ak-back-button/><text>{{t('routes.profile.sessions.title', null)}}</text><view/></view><ak-status-view v-if="state!=='content'" :state="state" :title="stateTitle" :loading-label="t('common.loading', null)" :retry-label="t('common.retry', null)" @retry="reload"/><ak-cell-list v-else><view v-for="item in items" :key="item.id" class="row"><view><text>{{item.userAgent}}</text><text>{{item.lastSeenAt}}</text></view><ak-button v-if="!item.current" variant="danger" :loading="mutatingId===item.id" @click="revoke(item.id)">{{t('common.remove', null)}}</ak-button><text v-else>{{t('common.current', null)}}</text></view></ak-cell-list></scroll-view></ak-theme-root></template>
<script lang="uts">import {HttpCancellation} from '../../../src/core/network/http-port.uts';import{akI18n}from'../../../src/core/i18n/ak-i18n.uts';import{profileRuntime}from'../../../src/features/profile/infrastructure/profile-runtime.uts';import{SelfSession}from'../../../src/features/profile/domain/models.uts';let task:HttpCancellation|null=null;export default{data(){return{state:'loading',items:[] as Array<SelfSession>,mutatingId:''}},computed:{t(){return akI18n.t},stateTitle(){return akI18n.t(this.state==='empty'?'state.empty.title':'state.error.title',null)}},onLoad(){this.reload()},onUnload(){const activeTask=task;if(activeTask!=null)activeTask.cancel()},methods:{reload(){const r=profileRuntime.getRepository();if(r==null){this.state='error';return}this.state='loading';task=r.sessions(x=>{this.items=x;this.state=x.length>0?'content':'empty'},()=>{this.state='error'})},revoke(id:string){const r=profileRuntime.getRepository();if(r==null)return;this.mutatingId=id;task=r.revokeSession(id,()=>{this.mutatingId='';this.reload()},()=>{this.mutatingId=''})}}}</script>
<style lang="scss">.page{height:100%;flex:1;padding:16px;background:var(--ak-page)}.nav,.row{flex-direction:row;align-items:center}.nav,.row{justify-content:space-between}.nav{height:48px}.row{min-height:70px}</style>
