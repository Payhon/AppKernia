<template>
  <ak-theme-root>
    <scroll-view class="page" scroll-y>
      <view class="nav">
        <ak-back-button />
        <text class="nav-title">{{ t('routes.profile.basic.title', null) }}</text>
        <ak-icon-button name="edit" :label="t('common.edit', null)" @click="edit" />
      </view>
      <ak-status-view v-if="state !== 'content'" :state="state" :title="stateTitle" :loading-label="t('common.loading', null)" :retry-label="t('common.retry', null)" @retry="reload" />
      <ak-cell-list v-else class="details-list">
        <view class="row"><text class="row-label">{{ t('displayName', null) }}</text><text class="row-value">{{ displayName }}</text></view>
        <view class="row"><text class="row-label">{{ t('email', null) }}</text><text class="row-value">{{ email }}</text></view>
        <view class="row"><text class="row-label">{{ t('settings.language', null) }}</text><text class="row-value">{{ locale }}</text></view>
        <view class="row"><text class="row-label">{{ t('timeZone', null) }}</text><text class="row-value">{{ timeZone }}</text></view>
      </ak-cell-list>
    </scroll-view>
  </ak-theme-root>
</template>

<script lang="uts">
import { HttpCancellation } from '../../../src/core/network/http-port.uts'
import { akI18n } from '../../../src/core/i18n/ak-i18n.uts'
import { profileRuntime } from '../../../src/features/profile/infrastructure/profile-runtime.uts'

let task: HttpCancellation | null = null

export default {
  data() { return { state: 'loading', displayName: '', email: '', locale: '', timeZone: '' } },
  computed: {
    t() { return akI18n.t },
    stateTitle(): string { return akI18n.t(this.state === 'offline' ? 'state.offline.title' : 'state.error.title', null) },
  },
  onLoad() { this.reload() },
  onUnload() { const activeTask = task; if (activeTask != null) activeTask.cancel() },
  methods: {
    edit() { uni.navigateTo({ url: '/pages/profile/edit/index' }) },
    reload() {
      const repo = profileRuntime.getRepository()
      if (repo == null) { this.state = 'error'; return }
      this.state = 'loading'
      task = repo.profile((value) => {
        this.displayName = value.displayName
        this.email = value.email
        this.locale = value.locale
        this.timeZone = value.timeZone
        this.state = 'content'
      }, (error) => { this.state = error.kind === 'network_unavailable' ? 'offline' : 'error' })
    },
  },
}
</script>

<style lang="scss">
.page { height: 100%; flex: 1; background: var(--ak-page); padding: 16px 20px 32px; }
.nav, .row { flex-direction: row; align-items: center; }
.nav { height: 44px; justify-content: space-between; margin-bottom: 20px; }
.nav-title { color: var(--ak-text); font-size: 17px; font-weight: 600; }
.details-list { border-radius: 18px; }
.row { min-height: 60px; padding: 0 16px; justify-content: space-between; border-bottom: 1px solid var(--ak-border); }
.row-label { color: var(--ak-text); font-size: 16px; }
.row-value { flex: 1; margin-left: 16px; color: var(--ak-muted); font-size: 15px; text-align: right; }
</style>
