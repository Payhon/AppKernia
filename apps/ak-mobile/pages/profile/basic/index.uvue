<template><ak-theme-root><scroll-view class="page" scroll-y><view class="nav"><ak-back-button/><text>{{t('routes.profile.basic.title', null)}}</text><text @click="edit">{{t('common.edit', null)}}</text></view><ak-status-view v-if="state!=='content'" :state="state" :title="stateTitle" :loading-label="t('common.loading', null)" :retry-label="t('common.retry', null)" @retry="reload"/><ak-cell-list v-else><view class="row"><text>{{t('displayName', null)}}</text><text>{{displayName}}</text></view><view class="row"><text>{{t('email', null)}}</text><text>{{email}}</text></view><view class="row"><text>{{t('settings.language', null)}}</text><text>{{locale}}</text></view><view class="row"><text>{{t('timeZone', null)}}</text><text>{{timeZone}}</text></view></ak-cell-list></scroll-view></ak-theme-root></template>
<script lang="uts">import {HttpCancellation} from '../../../src/core/network/http-port.uts';import {akI18n} from '../../../src/core/i18n/ak-i18n.uts';import {profileRuntime} from '../../../src/features/profile/infrastructure/profile-runtime.uts';let task:HttpCancellation|null=null;export default{data(){return{state:'loading',displayName:'',email:'',locale:'',timeZone:''}},computed:{t(){return akI18n.t},stateTitle(){return akI18n.t(this.state==='offline'?'state.offline.title':'state.error.title',null)}},onLoad(){this.reload()},onUnload(){const activeTask=task;if(activeTask!=null)activeTask.cancel()},methods:{edit(){uni.navigateTo({url:'/pages/profile/edit/index'})},reload(){const repo=profileRuntime.getRepository();if(repo==null){this.state='error';return}this.state='loading';task=repo.profile(x=>{this.displayName=x.displayName;this.email=x.email;this.locale=x.locale;this.timeZone=x.timeZone;this.state='content'},e=>{this.state=e.kind==='network_unavailable'?'offline':'error'})}}}</script>
<style lang="scss">.page{height:100%;flex:1;background:var(--ak-page);padding:16px}.nav,.row{flex-direction:row;align-items:center}.nav{height:48px;justify-content:space-between}.row{min-height:58px;padding:0 16px;justify-content:space-between;border-bottom:1px solid var(--ak-border)}</style>
