<template><ak-theme-root><scroll-view class="page" scroll-y><view class="nav"><ak-back-button/><text class="nav-title">{{t('routes.profile.devices.title', null)}}</text><view class="nav-slot"/></view><ak-status-view v-if="state!=='content'" :state="state" :title="stateTitle" :loading-label="t('common.loading', null)" :retry-label="t('common.retry', null)" @retry="reload"/><ak-cell-list v-else class="device-list"><view v-for="item in items" :key="item.id" class="row"><view class="device-copy"><text class="device-name">{{item.deviceName}}</text><text class="device-meta">{{item.platform}} · {{item.appVersion}}</text></view><ak-button v-if="!item.current" class="remove-button" variant="danger" :loading="mutatingId===item.id" @click="remove(item.id)">{{t('common.remove', null)}}</ak-button><text v-else class="current-label">{{t('common.current', null)}}</text></view></ak-cell-list></scroll-view></ak-theme-root></template><script lang="uts">import {HttpCancellation} from '../../../src/core/network/http-port.uts';import{akI18n}from'../../../src/core/i18n/ak-i18n.uts';import{profileRuntime}from'../../../src/features/profile/infrastructure/profile-runtime.uts';import{SelfDevice}from'../../../src/features/profile/domain/models.uts';let task:HttpCancellation|null=null;export default{data(){return{state:'loading',items:[] as Array<SelfDevice>,mutatingId:''}},computed:{t(){return akI18n.t},stateTitle(){return akI18n.t(this.state==='empty'?'state.empty.title':'state.error.title',null)}},onLoad(){this.reload()},onUnload(){const activeTask=task;if(activeTask!=null)activeTask.cancel()},methods:{reload(){const r=profileRuntime.getRepository();if(r==null){this.state='error';return}this.state='loading';task=r.devices(x=>{this.items=x;this.state=x.length>0?'content':'empty'},()=>{this.state='error'})},remove(id:string){const r=profileRuntime.getRepository();if(r==null)return;this.mutatingId=id;task=r.removeDevice(id,()=>{this.mutatingId='';this.reload()},()=>{this.mutatingId=''})}}}</script><style lang="scss">.page{height:100%;flex:1;padding:16px 20px 32px;background:var(--ak-page)}.nav,.row{flex-direction:row;align-items:center}.nav,.row{justify-content:space-between}.nav{height:44px;margin-bottom:20px}.nav-title{color:var(--ak-text);font-size:17px;font-weight:600}.nav-slot{width:44px;height:44px}.device-list{border-radius:18px}.row{min-height:76px;padding:12px 16px;border-bottom:1px solid var(--ak-border)}.device-copy{flex:1;margin-right:12px}.device-name{color:var(--ak-text);font-size:16px;font-weight:600}.device-meta{color:var(--ak-muted);font-size:13px;margin-top:5px}.remove-button{min-width:72px}.current-label{color:var(--ak-brand);font-size:14px;font-weight:600}</style>
