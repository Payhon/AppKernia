<template><ak-theme-root><scroll-view class="page" scroll-y><view class="nav"><ak-back-button/><text class="nav-title">{{t('routes.help.title', null)}}</text><view class="nav-slot"/></view><ak-cell-list class="help-list"><view class="row" @click="toggleFaq"><text>{{t('help.faq', null)}}</text><ak-icon name="chevron-right" tone="muted"/></view><view v-if="faqOpen" class="faq"><text>{{t('help.faqAnswer', null)}}</text></view><view class="row"><view class="row-copy"><text>{{t('help.contact', null)}}</text><text class="hint">{{t('help.contactUnavailable', null)}}</text></view></view><view class="row" @click="about"><text>{{t('routes.about.title', null)}}</text><ak-icon name="chevron-right" tone="muted"/></view></ak-cell-list></scroll-view></ak-theme-root></template>
<script lang="uts">import {akI18n} from '../../src/core/i18n/ak-i18n.uts';export default{data(){return{faqOpen:false}},computed:{t(){return akI18n.t}},methods:{toggleFaq(){this.faqOpen=!this.faqOpen},about(){uni.navigateTo({url:'/pages/about/index'})}}}</script>
<style lang="scss">.page{height:100%;flex:1;background:var(--ak-page);padding:16px 20px 32px}.nav,.row{flex-direction:row;align-items:center}.nav{height:44px;justify-content:space-between;margin-bottom:20px}.nav-title{color:var(--ak-text);font-size:17px;font-weight:600}.nav-slot{width:44px;height:44px}.help-list{border-radius:18px}.row{min-height:60px;padding:0 16px;justify-content:space-between;color:var(--ak-text);font-size:16px;border-bottom:1px solid var(--ak-border)}.row-copy{flex:1;padding:12px 0}.faq{padding:16px;color:var(--ak-text);font-size:15px;line-height:22px;background:var(--ak-accent-surface);border-bottom:1px solid var(--ak-border)}.hint{color:var(--ak-muted);font-size:13px;margin-top:4px}</style>
