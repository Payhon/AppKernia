<template><ak-theme-root><view class="page"><view class="nav"><ak-back-button/><text>{{t('routes.help.title', null)}}</text><view/></view><ak-cell-list><view class="row" @click="toggleFaq"><text>{{t('help.faq', null)}}</text><ak-icon name="chevron-right" tone="muted"/></view><view v-if="faqOpen" class="faq"><text>{{t('help.faqAnswer', null)}}</text></view><view class="row"><view><text>{{t('help.contact', null)}}</text><text class="hint">{{t('help.contactUnavailable', null)}}</text></view></view><view class="row" @click="about"><text>{{t('routes.about.title', null)}}</text><ak-icon name="chevron-right" tone="muted"/></view></ak-cell-list></view></ak-theme-root></template>
<script lang="uts">import {akI18n} from '../../src/core/i18n/ak-i18n.uts';export default{data(){return{faqOpen:false}},computed:{t(){return akI18n.t}},methods:{toggleFaq(){this.faqOpen=!this.faqOpen},about(){uni.navigateTo({url:'/pages/about/index'})}}}</script>
<style lang="scss">.page{flex:1;background:var(--ak-page);padding:16px}.nav,.row{flex-direction:row;align-items:center}.nav{height:48px;justify-content:space-between;color:var(--ak-text);font-size:18px;font-weight:600;margin-bottom:16px}.row{min-height:60px;padding:0 16px;justify-content:space-between;border-bottom:1px solid var(--ak-border)}.faq{padding:12px 16px;color:var(--ak-text)}.hint{color:var(--ak-muted);font-size:13px;margin-top:4px}</style>
