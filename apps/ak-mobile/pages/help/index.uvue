<template><ak-theme-root><scroll-view class="page" scroll-y><view class="nav"><ak-back-button/><text class="nav-title">{{t('routes.help.title',null)}}</text><view class="nav-slot"/></view><ak-cell-list class="help-list"><view class="row" role="button" :aria-label="t('help.faq',null)" @click="faq"><text class="row-label">{{t('help.faq',null)}}</text><ak-icon name="chevron-right" tone="muted"/></view><view class="row" role="button" :aria-label="t('help.contact',null)" @click="contact"><text class="row-label">{{t('help.contact',null)}}</text><ak-icon name="chevron-right" tone="muted"/></view><view class="row" role="button" :aria-label="t('routes.about.title',null)" @click="about"><text class="row-label">{{t('routes.about.title',null)}}</text><ak-icon name="chevron-right" tone="muted"/></view><view class="row" role="button" :aria-label="t('feedback.create',null)" @click="feedback"><text class="row-label">{{t('feedback.create',null)}}</text><ak-icon name="chevron-right" tone="muted"/></view><view class="row" role="button" :aria-label="t('feedback.mine',null)" @click="mine"><text class="row-label">{{t('feedback.mine',null)}}</text><ak-icon name="chevron-right" tone="muted"/></view></ak-cell-list><text class="version">{{t('help.currentVersion',versionParams)}}</text></scroll-view></ak-theme-root></template>
<script setup lang="uts">
import { akI18n } from '../../src/core/i18n/ak-i18n.uts'
import { installedAppVersion,requireFeedbackLogin } from '../../src/features/feedback/feedback-runtime.uts'
const t=akI18n.t
const versionParams=new Map<string,string>([['version',installedAppVersion()]])
function faq():void{uni.navigateTo({url:'/pages/legal/page/index?slug=faq'})}
function contact():void{uni.navigateTo({url:'/pages/legal/page/index?slug=contact-support'})}
function about():void{uni.navigateTo({url:'/pages/about/index'})}
function feedback():void{uni.navigateTo({url:'/pages/feedback/create/index'})}
function mine():void{uni.navigateTo({url:'/pages/feedback/index'})}
onShow(()=>{requireFeedbackLogin()})
</script>
<style lang="scss">.page{height:100%;flex:1;background:var(--ak-page);padding:16px 20px 32px}.nav,.row{flex-direction:row;align-items:center}.nav{height:44px;justify-content:space-between;margin-bottom:20px}.nav-title{color:var(--ak-text);font-size:17px;font-weight:600}.nav-slot{width:44px;height:44px}.help-list{border-radius:18px}.row{min-height:60px;padding:0 16px;justify-content:space-between;color:var(--ak-text);font-size:16px;border-bottom:1px solid var(--ak-border)}.row-label{color:var(--ak-text);font-size:16px}.version{text-align:center;color:var(--ak-muted);font-size:13px;margin:32px 0;padding-bottom:24px}</style>
