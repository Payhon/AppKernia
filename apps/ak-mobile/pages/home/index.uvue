<template>
  <ak-theme-root
    ><scroll-view
      class="page"
      scroll-y
      refresher-enabled
      :refresher-triggered="refreshing"
      @refresherrefresh="reload"
      ><view class="nav"
        ><text class="eyebrow">{{ t("information.appName", null) }}</text
        ><view class="nav-title-row"
          ><text class="title">{{ t("information.home.title", null) }}</text
          ><view class="nav-actions"
            ><ak-icon-button name="search" :icon-size="20" :label="t('information.search', null)" @click="search" />
            <ak-icon-button class="nav-action-spaced" name="bell" :icon-size="20" :label="t('routes.notifications.title', null)" @click="notifications" />
            <ak-icon-button class="nav-action-last" name="scan" :icon-size="22" :label="t('scanner.action.open', null)" :loading="scanBusy" :disabled="scanBusy" @click="scan" /></view
          ></view
        ></view
      ><ak-status-view
        v-if="state !== 'content'"
        :state="state"
        :title="stateTitle"
        :description="t('information.state.description', null)"
        @retry="reload" /><view v-else
        ><view
          v-if="pinned.length > 0"
          class="hero"
          @click="open(pinned[0].slug)"
          ><image
            v-if="pinned[0].coverUrl != null"
            class="hero-image"
            :src="asset(pinned[0].coverUrl)"
            mode="aspectFill"
            :alt="pinned[0].title"
          /><view class="hero-copy"
            ><text class="section-label">{{
              t("information.pinned", null)
            }}</text
            ><text class="hero-title">{{ pinned[0].title }}</text
            ><text class="hero-summary">{{ pinned[0].summary }}</text></view
          ></view
        ><section-list
          :title="t('information.featured', null)"
          :items="featured"
          horizontal
          @open="open" /><section-list
          :title="t('information.latest', null)"
          :items="latest"
          @open="open" /></view></scroll-view
    ><ak-auth-prompt
      :open="authOpen"
      @close="authOpen = false"
      @authenticated="authenticated"
  /><ak-bottom-sheet :open="scanSheetOpen" :title="scanSheetTitle" @close="closeScanSheet">
      <view v-if="scanSheetMode === 'result'" class="scan-sheet" role="status" aria-live="polite">
        <text class="scan-format">{{ scanFormatLabel }}</text>
        <text v-if="scanNotice.length > 0" class="scan-notice" role="alert">{{ scanNotice }}</text>
        <text class="scan-value">{{ scanValue }}</text>
        <ak-button class="scan-primary" :label="t('scanner.result.copy', null)" @click="copyScanResult" />
      </view>
      <view v-else class="scan-sheet" role="alert" aria-live="assertive">
        <text class="scan-permission-copy">{{ t('scanner.permission.description', null) }}</text>
        <ak-button class="scan-primary" :label="t('common.retry', null)" @click="retryScan" />
        <ak-button class="scan-secondary" variant="secondary" :label="t('scanner.permission.settings', null)" @click="openCameraSettings" />
        <ak-button class="scan-secondary" variant="text" :label="t('common.cancel', null)" @click="closeScanSheet" />
      </view>
    </ak-bottom-sheet></ak-theme-root>
</template>
<script lang="uts">
import { akI18n } from '../../src/core/i18n/ak-i18n.uts'
import { articleRuntime } from '../../src/features/articles/infrastructure/article-runtime.uts'
import { ArticleSummary, ContentHome } from '../../src/features/articles/domain/models.uts'
import { navigateArticleDetail } from '../../src/core/navigation/app-routes.uts'
import { appSessionStore } from '../../src/core/stores/session-store.uts'
import { scannerCoordinator, AkScanSubscription } from '../../src/features/scanner/application/scanner-coordinator.uts'
import { AkScanResult } from '@/uni_modules/ak-scanner'
import { AkScanEvent } from '../../src/features/scanner/domain/models.uts'
import { AkBlockedScanResult, webViewTicketStore } from '../../src/features/scanner/application/webview-ticket-store.uts'
let scanSubscription:AkScanSubscription|null=null
export default{data(){return{state:'loading',refreshing:false,authOpen:false,scanBusy:false,scanSheetOpen:false,scanSheetMode:'result',scanValue:'',scanFormat:'unknown',scanNotice:'',pinned:[] as Array<ArticleSummary>,featured:[] as Array<ArticleSummary>,latest:[] as Array<ArticleSummary>}},computed:{t(){return akI18n.t},stateTitle():string{return akI18n.t(this.state==='offline'?'state.offline.title':this.state==='empty'?'state.empty.title':'state.error.title',null)},scanSheetTitle():string{return akI18n.t(this.scanSheetMode==='permission'?'scanner.permission.title':'scanner.result.title',null)},scanFormatLabel():string{return akI18n.t('scanner.format.'+this.scanFormat,null)}},onLoad(){scanSubscription=scannerCoordinator.subscribe((event:AkScanEvent)=>this.onScanEvent(event));this.reload()},onShow(){const blocked=webViewTicketStore.takeBlocked();if(blocked!=null)this.presentBlocked(blocked)},onUnload(){const subscription=scanSubscription;scanSubscription=null;if(subscription!=null)subscription.dispose()},methods:{asset(value:string|null):string{return articleRuntime.assetUrl(value)},reload(){const repo=articleRuntime.getRepository();if(repo==null){this.state='error';return};this.refreshing=true;repo.home((value:ContentHome)=>{this.pinned=value.pinned;this.featured=value.featured;this.latest=value.latest;this.state=value.pinned.length+value.featured.length+value.latest.length==0?'empty':'content';this.refreshing=false},error=>{this.state=error.kind==='network_unavailable'?'offline':'error';this.authOpen=error.kind==='unauthorized';this.refreshing=false})},open(slug:string){navigateArticleDetail(slug)},search(){uni.switchTab({url:'/pages/browse/index'})},notifications(){if(appSessionStore.getAccessToken()==null){this.authOpen=true;return};uni.navigateTo({url:'/pages/notifications/index'})},scan(){if(this.scanBusy)return;this.scanBusy=true;scannerCoordinator.scan()},onScanEvent(event:AkScanEvent){if(event.name==='resolved'||event.name==='cancelled'||event.name==='failed')this.scanBusy=false;if(event.name==='resolved'&&event.resolution==='present_result'&&event.result!=null){this.presentScanResult(event.result!,'');return};if(event.name==='failed'&&event.error==='permission_denied'){this.scanSheetMode='permission';this.scanSheetOpen=true;return};if(event.name==='failed'&&event.error!=='busy')uni.showToast({title:akI18n.t('scanner.error.unavailable',null),icon:'none'})},presentScanResult(result:AkScanResult,notice:string){this.scanValue=result.rawValue;this.scanFormat=result.format;this.scanNotice=notice;this.scanSheetMode='result';this.scanSheetOpen=true},presentBlocked(blocked:AkBlockedScanResult){this.presentScanResult(blocked.result,akI18n.t(blocked.reason==='load_failed'?'scanner.webview.loadFailed':'scanner.webview.blocked',null))},closeScanSheet(){this.scanSheetOpen=false},retryScan(){this.closeScanSheet();this.scan()},openCameraSettings(){if(!scannerCoordinator.openCameraSettings())uni.showToast({title:akI18n.t('scanner.permission.settingsFailed',null),icon:'none'})},copyScanResult(){const value=this.scanValue;if(value.length==0)return;uni.setClipboardData({data:value,success:()=>uni.showToast({title:akI18n.t('scanner.result.copySuccess',null),icon:'success'}),fail:()=>uni.showToast({title:akI18n.t('scanner.result.copyFailed',null),icon:'none'})})},authenticated(){this.authOpen=false;this.reload()}}}
</script>
<style lang="scss">
.page {
  height: 100%;
  background: var(--ak-page);
  padding: 20px 20px 120px;
}
.nav {
  margin: 12px 0 24px;
}
.eyebrow {
  font-size: 15px;
  color: var(--ak-brand);
  font-weight: 700;
}
.title {
  flex: 1;
  font-size: 38px;
  line-height: 46px;
  font-weight: 800;
  color: var(--ak-text);
}
.nav-title-row {
  min-height: 46px;
  margin-top: 4px;
  flex-direction: row;
  align-items: center;
}
.nav-actions {
  flex-direction: row;
  align-items: center;
  margin-left: 12px;
}
.nav-action-spaced { margin-left: 8px; }
.nav-action-last { margin-left: 8px; }
.scan-sheet{padding-bottom:12px}.scan-format{color:var(--ak-brand);font-size:14px;font-weight:700}.scan-notice{color:var(--ak-danger);font-size:14px;line-height:21px;margin-top:10px}.scan-value{width:100%;color:var(--ak-text);font-size:16px;line-height:24px;margin-top:12px;padding:14px;border-radius:14px;background:var(--ak-surface-subtle)}.scan-permission-copy{color:var(--ak-muted);font-size:15px;line-height:23px}.scan-primary{margin-top:18px}.scan-secondary{margin-top:10px}
.hero {
  border-radius: 22px;
  overflow: hidden;
  background: var(--ak-surface);
  margin-bottom: 28px;
}
.hero-image {
  width: 100%;
  height: 240px;
}
.hero-copy {
  padding: 20px;
}
.section-label {
  color: var(--ak-brand);
  font-size: 14px;
  font-weight: 700;
}
.hero-title {
  color: var(--ak-text);
  font-size: 26px;
  line-height: 34px;
  font-weight: 800;
  margin-top: 8px;
}
.hero-summary {
  color: var(--ak-muted);
  font-size: 16px;
  line-height: 24px;
  margin-top: 8px;
}
</style>
