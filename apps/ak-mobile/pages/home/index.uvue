<template>
  <ak-theme-root
    ><scroll-view
      class="page"
      scroll-y
      refresher-enabled
      :refresher-triggered="refreshing"
      @refresherrefresh="reload"
      ><view class="nav"
        ><text class="eyebrow">{{ t("information.appName", null) }}</text
        ><text class="title">{{ t("information.home.title", null) }}</text
        ><view class="nav-actions"
          ><ak-icon-button name="search" :label="t('information.search', null)" @click="search" />
          <ak-icon-button class="nav-action-last" name="bell" :label="t('routes.notifications.title', null)" @click="notifications" /></view
        ></view
      ><ak-status-view
        v-if="state !== 'content'"
        :state="state"
        :title="stateTitle"
        :description="t('information.state.description', null)"
        @retry="reload" /><view v-else
        ><view
          v-if="pinned.length > 0"
          class="hero"
          @click="open(pinned[0].slug)"
          ><image
            v-if="pinned[0].coverUrl != null"
            class="hero-image"
            :src="asset(pinned[0].coverUrl)"
            mode="aspectFill"
            :alt="pinned[0].title"
          /><view class="hero-copy"
            ><text class="section-label">{{
              t("information.pinned", null)
            }}</text
            ><text class="hero-title">{{ pinned[0].title }}</text
            ><text class="hero-summary">{{ pinned[0].summary }}</text></view
          ></view
        ><section-list
          :title="t('information.featured', null)"
          :items="featured"
          horizontal
          @open="open" /><section-list
          :title="t('information.latest', null)"
          :items="latest"
          @open="open" /></view></scroll-view
    ><ak-auth-prompt
      :open="authOpen"
      @close="authOpen = false"
      @authenticated="authenticated"
  /></ak-theme-root>
</template>
<script lang="uts">
import { akI18n } from '../../src/core/i18n/ak-i18n.uts'
import { articleRuntime } from '../../src/features/articles/infrastructure/article-runtime.uts'
import { ArticleSummary, ContentHome } from '../../src/features/articles/domain/models.uts'
import { navigateArticleDetail } from '../../src/core/navigation/app-routes.uts'
import { appSessionStore } from '../../src/core/stores/session-store.uts'
export default{data(){return{state:'loading',refreshing:false,authOpen:false,pinned:[] as Array<ArticleSummary>,featured:[] as Array<ArticleSummary>,latest:[] as Array<ArticleSummary>}},computed:{t(){return akI18n.t},stateTitle():string{return akI18n.t(this.state==='offline'?'state.offline.title':this.state==='empty'?'state.empty.title':'state.error.title',null)}},onLoad(){this.reload()},methods:{asset(value:string|null):string{return articleRuntime.assetUrl(value)},reload(){const repo=articleRuntime.getRepository();if(repo==null){this.state='error';return};this.refreshing=true;repo.home((value:ContentHome)=>{this.pinned=value.pinned;this.featured=value.featured;this.latest=value.latest;this.state=value.pinned.length+value.featured.length+value.latest.length==0?'empty':'content';this.refreshing=false},error=>{this.state=error.kind==='network_unavailable'?'offline':'error';this.authOpen=error.kind==='unauthorized';this.refreshing=false})},open(slug:string){navigateArticleDetail(slug)},search(){uni.switchTab({url:'/pages/browse/index'})},notifications(){if(appSessionStore.getAccessToken()==null){this.authOpen=true;return};uni.navigateTo({url:'/pages/notifications/index'})},authenticated(){this.authOpen=false;this.reload()}}}
</script>
<style lang="scss">
.page {
  height: 100%;
  background: var(--ak-page);
  padding: 20px 20px 120px;
}
.nav {
  margin: 12px 0 24px;
}
.eyebrow {
  font-size: 15px;
  color: var(--ak-brand);
  font-weight: 700;
}
.title {
  font-size: 38px;
  line-height: 46px;
  font-weight: 800;
  color: var(--ak-text);
  margin-top: 4px;
}
.nav-actions {
  margin-top: 8px;
  flex-direction: row;
  justify-content: flex-end;
}
.nav-action-last { margin-left: 8px; }
.hero {
  border-radius: 22px;
  overflow: hidden;
  background: var(--ak-surface);
  margin-bottom: 28px;
}
.hero-image {
  width: 100%;
  height: 240px;
}
.hero-copy {
  padding: 20px;
}
.section-label {
  color: var(--ak-brand);
  font-size: 14px;
  font-weight: 700;
}
.hero-title {
  color: var(--ak-text);
  font-size: 26px;
  line-height: 34px;
  font-weight: 800;
  margin-top: 8px;
}
.hero-summary {
  color: var(--ak-muted);
  font-size: 16px;
  line-height: 24px;
  margin-top: 8px;
}
</style>
