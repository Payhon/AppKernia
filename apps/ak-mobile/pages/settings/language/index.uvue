<template>
  <ak-theme-root><scroll-view class="page" scroll-y>
    <view class="nav"><ak-back-button/><text class="nav-title">{{t('routes.settings.language.title', null)}}</text><view class="nav-slot"/></view>
    <ak-status-view v-if="state==='loading'" state="loading" :loading-label="t('common.loading', null)"/>
    <ak-cell-list v-else class="selection-list">
      <view class="row" :class="locale==='zh-CN' ? 'row-selected' : ''" @click="save('zh-CN')"><text>{{t('settings.localeZhCN', null)}}</text><ak-icon v-if="locale==='zh-CN'" name="check"/></view>
      <view class="row" :class="locale==='en-US' ? 'row-selected' : ''" @click="save('en-US')"><text>{{t('settings.localeEnUS', null)}}</text><ak-icon v-if="locale==='en-US'" name="check"/></view>
    </ak-cell-list>
  </scroll-view></ak-theme-root>
</template>

<script lang="uts">
import {akI18n} from '../../../src/core/i18n/ak-i18n.uts'
import {preferencesRuntime, Prefs} from '../../../src/features/preferences/infrastructure/preferences-runtime.uts'
import {NavigationLocaleSync} from '../../../src/core/i18n/navigation-sync.uts'

let prefs: Prefs | null = null

export default {
  data() { return {state:'loading', locale:'zh-CN'} },
  computed: { t() { return akI18n.t } },
  onLoad() {
    const repository = preferencesRuntime.getRepository()
    if (repository == null) { this.state='error'; return }
    repository.get(value => { prefs=value; this.locale=value.locale; this.state='content' }, () => { this.state='error' })
  },
  methods: {
    save(locale: 'zh-CN' | 'en-US') {
      const repository = preferencesRuntime.getRepository()
      const currentPrefs: Prefs | null = prefs
      if (repository == null || currentPrefs == null) return
      repository.put({locale:locale, appearance:currentPrefs.appearance, email:currentPrefs.email, push:currentPrefs.push, inApp:currentPrefs.inApp}, saved => {
        prefs=saved
        this.locale=saved.locale
        new NavigationLocaleSync(akI18n).apply(saved.locale, 'routes.settings.language.title')
      }, () => {})
    },
  },
}
</script>

<style lang="scss">
.page{height:100%;flex:1;padding:16px 20px 32px;background:var(--ak-page)}.nav,.row{flex-direction:row;align-items:center;justify-content:space-between}.nav{height:44px;margin-bottom:20px}.nav-title{color:var(--ak-text);font-size:17px;font-weight:600}.nav-slot{width:44px;height:44px}.selection-list{border-radius:18px}.row{min-height:60px;padding:0 16px;color:var(--ak-text);font-size:16px;border-bottom:1px solid var(--ak-border)}.row-selected{background:var(--ak-accent-surface);font-weight:600}
</style>
