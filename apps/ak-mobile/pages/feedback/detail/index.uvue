<template><ak-theme-root><scroll-view class="page" scroll-y>
 <view class="nav"><ak-back-button fallback-url="/pages/feedback/index"/><text class="title">{{t('feedback.detail',null)}}</text><view class="slot"/></view>
 <ak-status-view v-if="state!=='content'" :state="state" :title="t(state==='offline'?'state.offline.title':'state.error.title',null)" :loading-label="t('common.loading',null)" :retry-label="t('common.retry',null)" @retry="reload"/>
 <view v-else-if="item!=null"><ak-card class="card"><text class="status">{{t('feedback.status.'+item!.status,null)}}</text><text class="body">{{item!.description}}</text><text v-if="item!.contact.length>0" class="hint">{{t('feedback.contact',null)}}: {{item!.contact}}</text><text class="hint">{{akI18n.formatDateTime(item!.created_at)}}</text><text class="hint">{{t('feedback.platform.'+item!.platform,null)}} · {{item!.app_version}}</text><view v-for="preview in previews" :key="preview.id"><image v-if="preview.path.length>0" class="screenshot" :src="preview.path" mode="widthFix" :aria-label="t('feedback.screenshot',null)"/><text v-else class="hint">{{t(preview.failed?'feedback.imageLoadFailed':'common.loading',null)}}</text></view></ak-card>
 <ak-card class="card"><text class="label">{{t('feedback.replies',null)}}</text><text v-if="item!.replies.length==0" class="hint">{{t('feedback.noReply',null)}}</text><view v-for="reply in item!.replies" :key="reply.id" class="reply"><text class="body">{{reply.body}}</text><text class="hint">{{akI18n.formatDateTime(reply.created_at)}}</text></view></ak-card><ak-button variant="secondary" :label="t('feedback.refresh',null)" @click="reload"/></view>
</scroll-view></ak-theme-root></template>
<script setup lang="uts">
import { feedbackRuntime,requireFeedbackLogin,discardFeedbackPreview } from '../../../src/features/feedback/feedback-runtime.uts'
import { FeedbackWire,FeedbackAttachmentWire } from '../../../src/generated/api/mobile-feedback.uts'
import { HttpCancellation } from '../../../src/core/network/http-port.uts'
import { akI18n } from '../../../src/core/i18n/ak-i18n.uts'
type Preview={id:string;path:string;failed:boolean}
const t=akI18n.t;const state=ref('loading');const item=ref<FeedbackWire|null>(null);const previews=ref<Array<Preview>>([]);let id='';let task:HttpCancellation|null=null;let imageTasks:Array<HttpCancellation>=[]
function clearImages():void{imageTasks.forEach((task:HttpCancellation)=>task.cancel());imageTasks=[];previews.value.forEach((p:Preview)=>discardFeedbackPreview(p.path));previews.value=[]}
function setPreview(fileID:string,path:string,failed:boolean):void{previews.value=previews.value.map((p:Preview):Preview=>p.id==fileID?{id:fileID,path:path,failed:failed}:p)}
function reload():void{if(!requireFeedbackLogin())return;if(task!=null)task!.cancel();clearImages();state.value='loading';task=feedbackRuntime.get(id,value=>{item.value=value;state.value='content';previews.value=value.attachments.map((a:FeedbackAttachmentWire):Preview=>({id:a.file_id,path:'',failed:false}));value.attachments.forEach((a:FeedbackAttachmentWire)=>{imageTasks.push(feedbackRuntime.download(id,a.file_id,path=>setPreview(a.file_id,path,false),()=>setPreview(a.file_id,'',true)))})},e=>{state.value=e.kind=='network_unavailable'?'offline':e.kind=='forbidden'?'forbidden':'error'})}
onLoad((options:OnLoadOptions)=>{const value=options['id'];id=value==null?'':value;reload()});onUnload(()=>{if(task!=null)task!.cancel();clearImages();item.value=null})
</script>
<style lang="scss">.page{height:100%;flex:1;padding:16px 20px 32px;background:var(--ak-page)}.nav{height:44px;flex-direction:row;justify-content:space-between;align-items:center;margin-bottom:20px}.title{font-size:17px;font-weight:600;color:var(--ak-text)}.slot{width:44px}.card{padding:16px;margin-bottom:16px}.body{font-size:16px;line-height:24px;color:var(--ak-text);margin:12px 0}.label{font-size:16px;font-weight:600;color:var(--ak-text)}.status{color:var(--ak-brand);font-size:15px}.hint{font-size:13px;line-height:20px;color:var(--ak-muted);margin-top:8px}.screenshot{width:100%;margin-top:12px}.reply{padding:12px 0;border-bottom:1px solid var(--ak-border)}</style>
