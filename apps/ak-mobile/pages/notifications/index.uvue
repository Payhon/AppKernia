<template><ak-theme-root><scroll-view class="page" scroll-y @scrolltolower="more"><view class="nav"><text>{{t('tabs.notifications', null)}}</text></view><ak-status-view v-if="state!=='content'" :state="state" :title="title" :loading-label="t('common.loading', null)" :retry-label="t('common.retry', null)" @retry="reload"/><ak-cell-list v-else><view v-for="item in items" :key="item.id" class="item" @click="read(item)"><text>{{item.title}}</text><text>{{plain(item.body)}}</text><text>{{item.createdAt}}</text></view><ak-button v-if="cursor.length>0" variant="secondary" :loading="moreLoading" @click="more">{{t('articles.loadMore', null)}}</ak-button></ak-cell-list></scroll-view></ak-theme-root></template><script lang="uts">import{akI18n}from'../../src/core/i18n/ak-i18n.uts';import{HttpCancellation}from'../../src/core/network/http-port.uts';import{notificationPlainText}from'../../src/features/notifications/application/plain-text-sanitizer.uts';import{MobileNotification,MobileNotificationPage}from'../../src/features/notifications/infrastructure/http-notifications-repository.uts';import{notificationsRuntime}from'../../src/features/notifications/infrastructure/notifications-runtime.uts';let task:HttpCancellation|null=null;export default{data(){return{state:'loading',items:[] as Array<MobileNotification>,cursor:'',moreLoading:false}},computed:{t(){return akI18n.t},title(){return akI18n.t(this.state==='empty'?'state.empty.title':'state.error.title',null)}},onLoad(){this.reload()},onUnload(){const activeTask=task;if(activeTask!=null)activeTask.cancel()},methods:{plain(v:string){return notificationPlainText(v)},reload(){const r=notificationsRuntime.getRepository();if(r==null){this.state='error';return}this.state='loading';task=r.list(null as string|null,(p:MobileNotificationPage)=>{this.items=p.items;this.cursor=p.nextCursor!=null?p.nextCursor:'';this.state=this.items.length>0?'content':'empty'},()=>{this.state='error'})},more(){if(this.cursor.length==0||this.moreLoading)return;const r=notificationsRuntime.getRepository();if(r==null)return;this.moreLoading=true;task=r.list(this.cursor,(p:MobileNotificationPage)=>{this.items=this.items.concat(p.items);this.cursor=p.nextCursor!=null?p.nextCursor:'';this.moreLoading=false},()=>{this.moreLoading=false})},read(item:MobileNotification){if(item.readAt!=null)return;const r=notificationsRuntime.getRepository();if(r==null)return;task=r.read(item.id,()=>{item.readAt='now'},()=>{})}}}</script><style lang="scss">.page{height:100%;flex:1;padding:16px;background:var(--ak-page)}.nav{height:48px}.item{padding:12px;border-bottom:1px solid var(--ak-border)}</style>
