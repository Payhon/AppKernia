{
	"name": "应核 AppKernia",
	"appid": "__UNI__196F2FC",
	"description": "应核 AppKernia 官方资讯与跨平台样板应用",
	"versionName": "0.2.0",
	"versionCode": "100",
	"locale": "zh-CN",
	"fallbackLocale": "zh-CN",
	"akRuntime": {
		"environment": "development",
		"apiBaseUrl": "http://127.0.0.1:8080/api/v1",
		"appId": "00000000-0000-4000-8000-000000000001"
	},
	"uni-app-x": {
		"renderer": "vdom"
	},
	"app": {
		"defaultAppTheme": "light",
		"minSdkVersion": 26,
		"distribute": {
			"modules": { "uni-video": {}, "uni-loading": {} },
			"android": { "modules": { "Share": {} } },
			"ios": {
				"deploymentTarget": "13.0",
				"CFBundleName": "应核"
			},
			"harmony": {
				"minAPILevel": 14
			}
		}
	},
	"app-android": {
		"minSdkVersion": 26,
		"distribute": {
			"syncDebug": true,
			"modules": { "Share": {} },
			"icons": {
				"hdpi": "static/app-icons/android/icon-72.png",
				"xhdpi": "static/app-icons/android/icon-96.png",
				"xxhdpi": "static/app-icons/android/icon-144.png",
				"xxxhdpi": "static/app-icons/android/icon-192.png"
			},
			"splashScreens": {
				"default": {},
				"background": "#F2F2F7",
				"icon": {
					"xhdpi": "static/app-icons/android/splash-icon-480.png",
					"xxhdpi": "static/app-icons/android/splash-icon-720.png",
					"xxxhdpi": "static/app-icons/android/splash-icon-960.png"
				}
			}
		}
	},
	"app-ios": {
		"minSdkVersion": 26,
		"distribute": {
			"syncDebug": true,
			"deploymentTarget": "13.0",
			"pushRegisterMode": "manual",
			"modules": { "Share": {}, "Push": {} },
			"icons": {
				"appstore": "static/app-icons/ios/appstore-1024.png"
			},
			"splashScreens": {}
		}
	},
	"app-harmony": {
		"distribute": {
			"bundleName": "com.appkernia.mobile",
			"modules": {}
		}
	}
}
