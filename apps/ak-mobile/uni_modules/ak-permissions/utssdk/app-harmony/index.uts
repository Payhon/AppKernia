import { common, Want } from '@kit.AbilityKit'
import { notificationManager } from '@kit.NotificationKit'
import { getAbilityContext } from '@dcloudio/uni-runtime'
import { GetPermissionStatus, ListPermissionCapabilities, OnPermissionStatusChanged, OpenPermissionSettings, PermissionCapability, PermissionStatusListener, RequestPermission } from '../interface.uts'

let listener:PermissionStatusListener|null=null
function value(status:string):PermissionCapability{return new PermissionCapability('notifications',status=='authorized'?'authorized':status=='denied'?'denied':'unavailable',false,true,'harmony',Date.now())}
function camera():PermissionCapability{try{const status=uni.getAppAuthorizeSetting().cameraAuthorized;const normalized=status=='authorized'?'authorized':status=='denied'?'denied':status=='not determined'?'not_determined':'unavailable';return new PermissionCapability('camera',normalized,normalized=='not_determined',true,'harmony',Date.now())}catch(error){return new PermissionCapability('camera','unavailable',true,true,'harmony',Date.now())}}
function read(ok:(capability:PermissionCapability)=>void,fail:()=>void):void{notificationManager.isNotificationEnabled().then((enabled:boolean)=>ok(value(enabled?'authorized':'denied'))).catch(()=>fail())}
function emit(capability:PermissionCapability):void{const current=listener;if(current!=null)current(capability)}
export const listCapabilities:ListPermissionCapabilities=function(success,failure){read(capability=>success([capability,camera()]),()=>failure('native_failure'))}
export const getStatus:GetPermissionStatus=function(key,success,failure){if(key=='notifications'){read(success,()=>failure('native_failure'));return};if(key=='camera'){success(camera());return};failure('invalid_capability')}
export const request:RequestPermission=function(key,success,failure){if(key=='notifications'){notificationManager.requestEnableNotification().then(()=>read(capability=>{emit(capability);success(capability)},()=>failure('native_failure'))).catch(()=>failure('native_failure'));return};if(key=='camera'){const capability=camera();emit(capability);success(capability);return};failure('invalid_capability')}
export const openSettings:OpenPermissionSettings=function(key){if(key=='camera'){try{uni.openAppAuthorizeSetting({});return true}catch(error){return false}};if(key!='notifications')return false;try{const context=getAbilityContext() as common.UIAbilityContext|null;if(context==null)return false;const want:Want={bundleName:'com.huawei.hmos.settings',abilityName:'com.huawei.hmos.settings.MainAbility',uri:'settings://notification_settings'};context.startAbility(want);return true}catch(error){return false}}
export const onStatusChanged:OnPermissionStatusChanged=function(value){listener=value}
