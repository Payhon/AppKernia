import { GetPermissionStatus, ListPermissionCapabilities, OnPermissionStatusChanged, OpenPermissionSettings, PermissionCapability, PermissionCapabilitySuccess, PermissionFailure, PermissionKey, PermissionStatusListener, RequestPermission } from '../interface.uts'

let listener: PermissionStatusListener | null = null
function notification(): PermissionCapability {
  const status=AkPermissionsAndroidBridge.notificationStatus()
  const normalized=status=='authorized'?'authorized':status=='denied'?'denied':status=='not_determined'?'not_determined':'unavailable'
  return new PermissionCapability('notifications',normalized,AkPermissionsAndroidBridge.notificationCanRequest(),true,'android',Date.now())
}
function camera(): PermissionCapability {
  const status=AkPermissionsAndroidBridge.cameraStatus()
  const normalized=status=='authorized'?'authorized':status=='denied'?'denied':status=='not_determined'?'not_determined':'unavailable'
  return new PermissionCapability('camera',normalized,AkPermissionsAndroidBridge.cameraCanRequest(),true,'android',Date.now())
}
function emit(value:PermissionCapability):void{const current=listener;if(current!=null)current(value)}
export const listCapabilities:ListPermissionCapabilities=function(success,_failure){success([notification(),camera()])}
export const getStatus:GetPermissionStatus=function(key,success,failure){if(key=='notifications'){success(notification());return};if(key=='camera'){success(camera());return};failure('invalid_capability')}
export const request:RequestPermission=function(key,success,failure){if(key=='notifications'){AkPermissionsAndroidBridge.requestNotifications((_status:string)=>{const value=notification();emit(value);success(value)});return};if(key=='camera'){AkPermissionsAndroidBridge.requestCamera((_status:string)=>{const value=camera();emit(value);success(value)});return};failure('invalid_capability')}
export const openSettings:OpenPermissionSettings=function(key){if(key=='notifications')return AkPermissionsAndroidBridge.openNotificationSettings();if(key=='camera')return AkPermissionsAndroidBridge.openCameraSettings();return false}
export const onStatusChanged:OnPermissionStatusChanged=function(value){listener=value}
