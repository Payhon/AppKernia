import { AbilityConstant, Want, bundleManager, common } from '@kit.AbilityKit'
import OpenLinkOptions from '@ohos.app.ability.OpenLinkOptions'
import { getAbilityContext } from '@dcloudio/uni-runtime'
import { AuthorizeOAuth, ConsumeOAuthReturn, GetOAuthCapability, OAuthNativeAuthorizationRequest, OAuthNativeAuthorizationResult, OAuthNativeFailure, OAuthNativeSuccess, OAuthNativeCapability, OAuthNativeProvider, OnOAuthReturn, OAuthReturnListener } from '../interface.uts'

let returnListener: OAuthReturnListener | null = null
let pendingReturnURL: string = ''

function captureWant(want: Want): void {
  const value = want.uri
  if (value == null || value!.length == 0) return
  const listener = returnListener
  if (listener == null) pendingReturnURL = value!
  else listener(value!)
}

UTSHarmony.onAppAbilityCreate((want: Want, _launchParam: AbilityConstant.LaunchParam) => { captureWant(want) })
UTSHarmony.onAppAbilityNewWant((want: Want, _launchParam: AbilityConstant.LaunchParam) => { captureWant(want) })

export const getOAuthCapability: GetOAuthCapability = function (): OAuthNativeCapability {
  const providers: Array<OAuthNativeProvider> = ['wechat', 'github']
  return new OAuthNativeCapability('harmony', 'harmony', providers)
}

export const authorizeOAuth: AuthorizeOAuth = function (request: OAuthNativeAuthorizationRequest, success: OAuthNativeSuccess, failure: OAuthNativeFailure): void {
  if (request.provider == 'wechat') {
    uni.login({
      provider: 'weixin',
      onlyAuthorize: true,
      success: result => {
        if (result.code.length == 0) { failure('native_failure'); return }
        success(new OAuthNativeAuthorizationResult('authorization_code', result.code, '', ''))
      },
      fail: result => {
        const message = (result.errMsg == null ? '' : result.errMsg!).toLowerCase()
        if (message.indexOf('cancel') >= 0 || message.indexOf('deny') >= 0 || message.indexOf('refuse') >= 0) failure('authorization_denied')
        else failure('native_failure')
      },
    })
    return
  }
  if (request.provider == 'github') {
    if (!request.authorizationURL.startsWith('https://')) { failure('configuration_missing'); return }
    let supported: boolean = false
    try { supported = bundleManager.canOpenLink(request.authorizationURL) } catch (_error) { supported = false }
    const context = getAbilityContext() as common.UIAbilityContext | null
    if (!supported || context == null) { failure('browser_unavailable'); return }
    context.openLink(request.authorizationURL, { appLinkingOnly: false } as OpenLinkOptions).then(() => success(new OAuthNativeAuthorizationResult('browser_started', '', '', ''))).catch(() => failure('browser_unavailable'))
    return
  }
  failure('unsupported_provider')
}

export const onOAuthReturn: OnOAuthReturn = function (listener: OAuthReturnListener | null): void {
  returnListener = listener
  if (listener != null && pendingReturnURL.length > 0) { const value = pendingReturnURL; pendingReturnURL = ''; listener(value) }
}

export const consumeOAuthReturn: ConsumeOAuthReturn = function (): void {}
