import { NSUserActivity, URL } from 'Foundation'
import { UIApplication } from 'UIKit'
import { AuthorizeOAuth, ConsumeOAuthReturn, GetOAuthCapability, OAuthNativeAuthorizationRequest, OAuthNativeAuthorizationResult, OAuthNativeFailure, OAuthNativeFailureCode, OAuthNativeSuccess, OAuthNativeCapability, OAuthNativeProvider, OnOAuthReturn, OAuthReturnListener } from '../interface.uts'

let returnListener: OAuthReturnListener | null = null
let pendingReturnURL: string = ''

function nativeFailure(value: string): OAuthNativeFailureCode {
  if (value == 'authorization_denied') return 'authorization_denied'
  if (value == 'configuration_missing') return 'configuration_missing'
  return 'native_failure'
}

function capture(value: string): boolean {
  if (value.length == 0) return false
  const listener = returnListener
  if (listener == null) pendingReturnURL = value
  else listener(value)
  return true
}

export class AkOAuthIOSLifecycleHook implements UTSiOSHookProxy {
  applicationHandleOpenURL(_application: UIApplication | null, url: URL | null): boolean { return url != null && capture(url!.absoluteString) }
  applicationOpenURLOptions(_application: UIApplication | null, url: URL | null, _options: Map<UIApplication.OpenURLOptionsKey, Any> | null): boolean { return url != null && capture(url!.absoluteString) }
  applicationContinueUserActivityRestorationHandler(_application: UIApplication | null, userActivity: NSUserActivity | null, _restorationHandler: ((result: Array<Any>) => void) | null): boolean {
    if (userActivity == null || userActivity!.webpageURL == null) return false
    return capture(userActivity!.webpageURL!.absoluteString)
  }
}

export const getOAuthCapability: GetOAuthCapability = function (): OAuthNativeCapability {
  const providers: Array<OAuthNativeProvider> = ['wechat', 'github', 'apple']
  return new OAuthNativeCapability('ios', 'ios', providers)
}

export const authorizeOAuth: AuthorizeOAuth = function (request: OAuthNativeAuthorizationRequest, success: OAuthNativeSuccess, failure: OAuthNativeFailure): void {
  if (request.provider == 'wechat') {
    uni.login({
      provider: 'weixin',
      onlyAuthorize: true,
      success: result => {
        if (result.code.length == 0) { failure('native_failure'); return }
        success(new OAuthNativeAuthorizationResult('authorization_code', result.code, '', ''))
      },
      fail: result => {
        const message = result.errMsg.toLowerCase()
        if (message.indexOf('cancel') >= 0 || message.indexOf('deny') >= 0 || message.indexOf('refuse') >= 0) failure('authorization_denied')
        else failure('native_failure')
      },
    })
    return
  }
  if (request.provider == 'apple') {
    AkOAuthIOSBridge.authorizeApple(request.nonce, request.state, (idToken: string, authorizationCode: string, displayName: string) => success(new OAuthNativeAuthorizationResult('id_token', authorizationCode, idToken, displayName)), (code: string) => failure(nativeFailure(code)))
    return
  }
  if (request.provider == 'github') {
    if (!request.authorizationURL.startsWith('https://')) { failure('configuration_missing'); return }
    const target = new URL(string = request.authorizationURL)
    if (target == null || !UIApplication.shared.canOpenURL(target!)) { failure('browser_unavailable'); return }
    UIApplication.shared.open(target!, options = new Map<UIApplication.OpenExternalURLOptionsKey, Any>(), completionHandler = (opened: boolean) => {
      if (opened) success(new OAuthNativeAuthorizationResult('browser_started', '', '', ''))
      else failure('browser_unavailable')
    })
    return
  }
  failure('unsupported_provider')
}

export const onOAuthReturn: OnOAuthReturn = function (listener: OAuthReturnListener | null): void {
  returnListener = listener
  if (listener != null && pendingReturnURL.length > 0) { const value = pendingReturnURL; pendingReturnURL = ''; listener(value) }
}

export const consumeOAuthReturn: ConsumeOAuthReturn = function (): void {}
