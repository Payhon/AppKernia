export type UpgradeSemver = { major: number; minor: number; patch: number }

export function parseUpgradeSemver(value: string): UpgradeSemver | null {
  const parts = value.trim().split('.')
  if (parts.length != 3) return null
  const values: Array<number> = []
  for (let index = 0; index < parts.length; index++) {
    const part = parts[index]
    if (part.length == 0 || part.length > 1 && part.startsWith('0') || !/^\d+$/.test(part)) return null
    const parsed = parseInt(part)
    if (parsed < 0) return null
    values.push(parsed)
  }
  return { major: values[0], minor: values[1], patch: values[2] }
}

export function compareUpgradeSemver(left: string, right: string): number | null {
  const a = parseUpgradeSemver(left)
  const b = parseUpgradeSemver(right)
  if (a == null || b == null) return null
  if (a.major != b.major) return a.major < b.major ? -1 : 1
  if (a.minor != b.minor) return a.minor < b.minor ? -1 : 1
  if (a.patch != b.patch) return a.patch < b.patch ? -1 : 1
  return 0
}
